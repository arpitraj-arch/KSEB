                    <td class="count-cell">23</td>
                    <td><span class="status status-active">Active</span></td>
                </tr>
                <tr>
                    <td><input type="checkbox" class="checkbox"></td>
                    <td><a class="link-id" href="#">SG-SERVICE-MGR</a></td>
                    <td class="name-cell">Karan Patel</td>
                    <td class="desc-cell">Integration of renewable energy sources and load balancing strategies</td>

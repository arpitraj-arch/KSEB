                    <svg width="14" height="14" viewBox="0 0 20 20" fill="none"><path d="M5 8l5 5 5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </button>
                <ul class="dropdown-menu" id="type-dd">
                    <li onclick="selectOption('type-dd','type-label','All Types')">All Types</li>
                    <li class="selected" onclick="selectOption('type-dd','type-label','Role-Based')">Role-Based</li>
                    <li onclick="selectOption('type-dd','type-label','Department')">Department</li>
                    <li onclick="selectOption('type-dd','type-label','Administrative')">Administrative</li>
                </ul>
            </div>
            <div class="dropdown-wrap">
                <button class="dropdown-btn" onclick="toggleDropdown('status-dd')">
                    <span id="status-label">All Status</span>
                    <svg width="14" height="14" viewBox="0 0 20 20" fill="none"><path d="M5 8l5 5 5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </button>
                <ul class="dropdown-menu" id="status-dd">
                    <li onclick="selectOption('status-dd','status-label','All Status')">All Status</li>
                    <li onclick="selectOption('status-dd','status-label','Active')">Active</li>
                    <li class="selected" onclick="selectOption('status-dd','status-label','InActive')">InActive</li>

            </tbody>
        </table>
    </div>

    <div class="table-footer">
        <span>Showing 6 of 6 sites</span>
        <div class="pagination">
            <button class="pag-btn">Previous</button>
            <button class="pag-btn">Next</button>
        </div>
    </div>

    <script>
            function toggleDropdown(id) {
              document.querySelectorAll('.dropdown-menu').forEach(m => {
                if (m.id !== id) m.classList.remove('open');
              });
              document.getElementById(id).classList.toggle('open');
            }
            function selectOption(ddId, labelId, value) {
              document.getElementById(labelId).textContent = value;
              document.getElementById(ddId).querySelectorAll('li').forEach(li => {
                li.classList.toggle('selected', li.textContent === value);
              });
              document.getElementById(ddId).classList.remove('open');
            }
            document.addEventListener('click', e => {
              if (!e.target.closest('.dropdown-wrap'))
                document.querySelectorAll('.dropdown-menu').forEach(m => m.classList.remove('open'));
            });
    </script>



    <style>
            @@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=DM+Mono:wght@400;500&display=swap');

            *, *::before, *::after {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            :root {
                --bg: #f5f6fa;
                --surface: #ffffff;
                --border: #e4e7ef;
                --text-primary: #1a1d2e;
                --text-secondary: #6b7280;
                --text-muted: #9ca3af;
                --accent: #2d3a8c;
                --accent-light: #eef0fb;
                --green: #16a34a;
                --green-bg: #dcfce7;
                --orange: #d97706;
                --orange-bg: #fef3c7;
                --purple-bg: #f3e8ff;
                --purple: #7c3aed;
                --gray-bg: #f3f4f6;
                --gray: #6b7280;
            }

            body {
                font-family: 'DM Sans', sans-serif;
                background: var(--bg);
                color: var(--text-primary);
                min-height: 100vh;
            }

            /* Topbar */
            .topbar {
                background: var(--surface);
                border-bottom: 1px solid var(--border);
                height: 48px;
                display: flex;
                align-items: center;
                padding: 0 28px;
                font-size: 12.5px;
                color: var(--text-secondary);
                gap: 6px;
            }

                .topbar span {
                    color: var(--text-muted);
                }

                .topbar strong {
                    color: var(--text-primary);
                    font-weight: 600;
                }

            /* Page header */
            .page-header {
                padding: 5px 10px 0;
                background: var(--surface);
                border-bottom: 1px solid var(--border);
            }

                .page-header h1 {
                    font-size: 21px;
                    font-weight: 600;
                    letter-spacing: -0.3px;
                }

                .page-header p {
                    font-size: 12px;
                    color: var(--text-secondary);
                    margin-top: 2px;
                    padding-bottom: 18px;
                }

            /* Toolbar */
            .toolbar {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 14px 28px;
                background: var(--surface);
                border-bottom: 1px solid var(--border);
            }

            .toolbar-actions {
                margin-left: auto;
                display: flex;
                gap: 8px;
                align-items: center;
            }

            .search-wrap {
                position: relative;
                flex: 1;
                max-width: 480px;
            }

                .search-wrap svg {
                    position: absolute;
                    left: 11px;
                    top: 50%;
                    transform: translateY(-50%);
                    color: var(--text-muted);
                }

                .search-wrap input {
                    width: 100%;
                    padding: 8px 12px 8px 34px;
                    border: 1px solid var(--border);
                    border-radius: 8px;
                    font-family: 'DM Sans', sans-serif;
                    font-size: 13px;
                    color: var(--text-primary);
                    background: #fafbfc;
                    outline: none;
                    transition: border-color .15s;
                }

                    .search-wrap input:focus {
                        border-color: var(--accent);
                        background: #fff;
                    }

                    .search-wrap input::placeholder {
                        color: var(--text-muted);
                    }

            /* Dropdown */
            .dropdown-wrap {
                position: relative;
            }

            .dropdown-btn {
                display: flex;
                align-items: center;
                gap: 6px;
                padding: 7px 12px;
                border: 1px solid var(--border);
                border-radius: 8px;
                background: #fff;
                font-family: 'DM Sans', sans-serif;
                font-size: 13px;
                color: var(--text-primary);
                cursor: pointer;
                white-space: nowrap;
                min-width: 110px;
                justify-content: space-between;
                transition: border-color .15s;
            }

                .dropdown-btn svg {
                    color: var(--text-muted);
                    flex-shrink: 0;
                }

            .dropdown-menu {
                position: absolute;
                top: calc(100% + 4px);
                left: 0;
                min-width: 145px;
                background: #fff;
                border: 1px solid var(--border);
                border-radius: 10px;
                box-shadow: 0 8px 24px rgba(0,0,0,.10);
                z-index: 100;
                overflow: hidden;
                display: none;
            }

                .dropdown-menu.open {
                    display: block;
                }

                .dropdown-menu li {
                    list-style: none;
                    padding: 9px 14px;
                    font-size: 13px;
                    cursor: pointer;
                    color: var(--text-primary);
                    transition: background .12s;
                }

                    .dropdown-menu li:hover {
                        background: var(--accent-light);
                    }

                    .dropdown-menu li.selected {
                        background: var(--accent);
                        color: #fff;
                    }

            /* Buttons */
            .icon-btn {
                width: 35px;
                height: 35px;
                border: 1px solid var(--border);
                border-radius: 8px;
                background: #fff;
                display: flex;
                align-items: center;
                justify-content: center;
                cursor: pointer;
                color: var(--text-secondary);
                transition: background .15s, border-color .15s;
            }

                .icon-btn:hover {
                    background: var(--accent-light);
                    border-color: var(--accent);
                }

            .new-btn {
                display: flex;
                align-items: center;
                gap: 6px;
                padding: 8px 16px;
                background: var(--accent);
                color: #fff;
                border: none;
                border-radius: 8px;
                font-family: 'DM Sans', sans-serif;
                font-size: 13px;
                font-weight: 500;
                cursor: pointer;
                transition: opacity .15s;
            }

                .new-btn:hover {
                    opacity: .88;
                }

            /* Table */
            .table-wrap {
                padding: 0 2px;
                overflow-x: auto;
            }

            table {
                width: 100%;
                border-collapse: collapse;
                background: var(--surface);
                border-radius: 10px;
                overflow: hidden;
                box-shadow: 0 1px 4px rgba(0,0,0,.05);
                margin-top: 16px;
            }

            thead tr {
                background: #f9fafb;
                border-bottom: 1px solid var(--border);
            }

            thead th {
                padding: 11px 14px;
                font-size: 11.5px;
                font-weight: 600;
                color: var(--text-secondary);
                text-transform: uppercase;
                letter-spacing: .6px;
                text-align: left;
                white-space: nowrap;
            }

                thead th:first-child {
                    width: 40px;
                    padding-left: 16px;
                }

            tbody tr {
                border-bottom: 1px solid var(--border);
                transition: background .12s;
            }

                tbody tr:last-child {
                    border-bottom: none;
                }

                tbody tr:hover {
                    background: #fafbff;
                }

            tbody td {
                padding: 13px 14px;
                font-size: 13.5px;
                vertical-align: middle;
            }

                tbody td:first-child {
                    padding-left: 16px;
                }

            .checkbox {
                width: 16px;
                height: 16px;
                border: 1.5px solid var(--border);
                border-radius: 4px;
                cursor: pointer;
                appearance: none;
                -webkit-appearance: none;
                background: #fff;
                transition: border-color .12s;
            }

                .checkbox:hover {
                    border-color: var(--accent);
                }

                .checkbox:checked {
                    background: var(--accent);
                    border-color: var(--accent);
                }

            .link-id {
                color: var(--accent);
                font-family: 'DM Mono', monospace;
                font-size: 12.5px;
                font-weight: 500;
                text-decoration: none;
                white-space: nowrap;
            }

                .link-id:hover {
                    text-decoration: underline;
                }

            .name-cell {
                font-weight: 500;
            }

            .designation-cell {
                font-size: 13px;
                font-weight: 500;
            }

            .dept-cell {
                font-size: 12.5px;
                color: var(--text-secondary);
            }

            .site-cell {
                font-size: 12.5px;
                color: var(--text-secondary);
            }

            .email-cell {
                font-size: 12px;
                color: var(--text-secondary);
                font-family: 'DM Mono', monospace;
            }

            /* Badges */
            .badge {
                display: inline-flex;
                align-items: center;
                padding: 3px 10px;
                border-radius: 20px;
                font-size: 12px;
                font-weight: 500;
                white-space: nowrap;
            }

            .badge-emp {
                background: var(--accent-light);
                color: var(--accent);
            }

            .badge-cont {
                background: var(--purple-bg);
                color: var(--purple);
            }

            .status {
                display: inline-flex;
                align-items: center;
                padding: 3px 10px;
                border-radius: 20px;
                font-size: 12px;
                font-weight: 500;
            }

            .status-active {
                background: var(--green-bg);
                color: var(--green);
            }

            .status-approved {
                background: var(--green-bg);
                color: var(--green);
            }

            .status-leave {
                background: var(--orange-bg);
                color: var(--orange);
            }

            .status-retired {
                background: var(--gray-bg);
                color: var(--gray);
            }

            /* Footer */
            .table-footer {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 14px 28px;
                margin-top: 8px;
                font-size: 12.5px;
                color: var(--text-secondary);
            }

            .pagination {
                display: flex;
                gap: 8px;
            }

            .pag-btn {
                padding: 7px 20px;
                border: 1px solid var(--border);
                border-radius: 8px;
                background: var(--surface);
                font-family: 'DM Sans', sans-serif;
                font-size: 13px;
                color: var(--text-primary);
                cursor: pointer;
                transition: background .12s;
            }

                .pag-btn:hover {
                    background: var(--accent-light);
                }
    </style>



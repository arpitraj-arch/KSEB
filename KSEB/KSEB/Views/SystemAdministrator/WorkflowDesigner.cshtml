            </div>

            <div style="margin-top:14px;">
                <div class="progress-row">
                    <span class="progress-label">Completion Rate (30d)</span>
                    <span class="progress-pct">85%</span>
                </div>
                <div class="progress-bar-wrap">
                    <div class="progress-bar-fill" style="width:85%"></div>
                </div>
            </div>

            <div class="card-actions">
                <button class="view-details-btn">
                    <svg width="14" height="14" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="7" stroke="currentColor" stroke-width="1.7" /><circle cx="10" cy="10" r="2.5" fill="currentColor" /></svg>
                    View Details
                </button>
                <div class="actions-right">
                    <button class="open-workflow-btn">
                        <svg width="14" height="14" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="7" stroke="currentColor" stroke-width="1.7" /><circle cx="10" cy="10" r="2.5" fill="currentColor" /></svg>
                        Open Workflow

        <!-- Card 3: Purchase Order Approval -->
        <div class="card">
            <div class="card-top">
                <div class="avatar">RK</div>
                <div class="card-title-block">
                    <div class="card-title-row">
                        <span class="card-title">Purchase Order Approval Workflow</span>

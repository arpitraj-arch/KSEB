@{
    ViewData["Title"] = "Main Dashboard";
}
@{
    ViewData["ActiveMenu"] = "Dashboard";
}


<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>O&M Dashboard</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --bg: #f0f2f5;
  --surface: #ffffff;
  --surface2: #f5f6f8;
  --border: #e4e7ec;
  --text: #111827;
  --text-muted: #6b7280;
  --text-dim: #9ca3af;
  --blue: #2563eb;
  --green: #16a34a;
  --orange: #d97706;
  --red: #dc2626;
  --teal: #0d9488;
  --purple: #7c3aed;
  --font: 'IBM Plex Sans', sans-serif;
  --mono: 'IBM Plex Mono', monospace;
  --radius: 16px;
  --radius-sm: 8px;
  --shadow: 0 2px 8px rgba(0,0,0,0.07);
  --shadow-sm: 0 1px 3px rgba(0,0,0,0.05);
}

body {
  background: var(--bg);
  color: var(--text);
  font-family: var(--font);
  font-size: 13px;
  min-height: 100vh;
}

/* ── TOP NAV ── */
.top-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 0 24px;
  border-bottom: 1px solid var(--border);
  background: var(--surface);
  box-shadow: var(--shadow-sm);
  min-height: 64px;
  flex-wrap: wrap;
  position: sticky;
  top: 0;
  z-index: 100;
}
.nav-left1 { display: flex; align-items: center; gap: 0; }
.nav-left1-text { display: flex; flex-direction: column; gap: 2px; padding-right: 20px; }
.nav-breadcrumb { display: flex; align-items: center; gap: 5px; font-size: 11px; color: var(--text-dim); font-weight: 500; }
.nav-breadcrumb a { color: var(--blue); text-decoration: none; cursor: pointer; }
.nav-breadcrumb a:hover { text-decoration: underline; }
.nav-title { font-size: 15px; font-weight: 700; color: var(--text); letter-spacing: -.01em; white-space: nowrap; }
.nav-title span { color: var(--blue); }
.nav-sub { font-size: 11px; color: var(--text-muted); }
.nav-divider { width: 1px; height: 40px; background: var(--border); margin-right: 20px; flex-shrink: 0; }
.nav-right { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.nav-btn {
  display: flex; align-items: center; gap: 6px;
  padding: 7px 13px; border-radius: 6px; border: 1px solid var(--border);
  background: var(--surface2); color: var(--text); font-family: var(--font);
  font-size: 12px; font-weight: 500; cursor: pointer; transition: all .15s; white-space: nowrap;
}
.nav-btn:hover { border-color: var(--blue); color: var(--blue); background: #eff6ff; }
.nav-btn svg { width: 13px; height: 13px; flex-shrink: 0; }

/* ── MAIN ── */
.main { padding: 14px 14px; display: flex; flex-direction: column; gap: 12px; }

/* ── STAT CARDS ── */
.stat-cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
.stat-card {
  background: var(--surface); border: 1px solid var(--border);
  border-radius: var(--radius); padding: 18px 20px 0; position: relative;
  overflow: hidden; box-shadow: var(--shadow); display: flex; flex-direction: column; min-height: 140px;
}
.stat-card-top { display: flex; align-items: center; gap: 12px; margin-bottom: 12px; }
.stat-icon-box {
  width: 44px; height: 44px; border-radius: 12px;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.stat-icon-box svg { width: 22px; height: 22px; }
.stat-icon-box.blue   { background: #eff6ff; }
.stat-icon-box.green  { background: #f0fdf4; }
.stat-icon-box.red    { background: #fef2f2; }
.stat-icon-box.orange { background: #fffbeb; }
.stat-top-right { display: flex; flex-direction: column; gap: 2px; flex: 1; }
.stat-label { display: flex; align-items: center; gap: 8px; font-size: 11px; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; color: var(--text-muted); flex-wrap: wrap; }
.stat-badge { display: flex; align-items: center; gap: 3px; font-size: 11px; font-weight: 600; padding: 2px 7px; border-radius: 20px; margin-left: auto; }
.badge-green { color: var(--green); background: rgba(22,163,74,.1); }
.badge-red   { color: var(--red);   background: rgba(220,38,38,.1); }
.stat-card-bottom { display: flex; align-items: flex-end; justify-content: space-between; flex: 1; }
.stat-card-bottom-left { padding-bottom: 18px; }
.stat-value { font-size: 34px; font-weight: 800; line-height: 1; margin-bottom: 4px; font-family: var(--mono); }
.stat-sub { font-size: 12px; color: var(--text-muted); }
.sparkline { width: 130px; height: 58px; flex-shrink: 0; display: block; align-self: flex-end; }

/* ── PANELS ── */
.panel {
  background: var(--surface); border: 1px solid var(--border);
  border-radius: var(--radius); padding: 16px 18px; box-shadow: var(--shadow-sm);
}
.panel-title {
  display: flex; align-items: center; gap: 8px;
  font-size: 13px; font-weight: 800; margin-bottom: 10px;
  padding: 4px 8px; color: #1e293b;
  border-left: 4px solid var(--blue);
  background: #f8fafc;
}
.panel-title svg { width: 14px; height: 14px; color: var(--blue); flex-shrink: 0; }
.panel-sub { font-size: 11px; color: var(--text-muted); margin-bottom: 12px; }
.title-divider { height: 1px; background: #d6ddea; width: 100%; margin-bottom: 10px; }

/* ── GRID LAYOUTS ── */
.grid-3-2 { display: grid; grid-template-columns: 3fr 2fr; gap: 12px; }
.grid-2   { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }

/* ── LOAD METRICS ── */
.load-metrics { display: flex; gap: 6px; margin-bottom: 12px; flex-wrap: wrap; }
.metric-item {
  flex: 1; min-width: 90px;
  background: #f8fafc; border: 1px solid #e2e8f0;
  border-radius: 12px; padding: 10px;
}
.metric-key { font-size: 10px; color: var(--text-muted); text-transform: uppercase; letter-spacing: .06em; font-weight: 600; }
.metric-val { font-size: 16px; font-weight: 700; color: var(--blue); font-family: var(--mono); }
.metric-val.green { color: var(--green); }
.metric-time { font-size: 10px; color: var(--text-dim); }

/* ── CHART ── */
.chart-wrap { width: 100%; height: 155px; position: relative; }

/* ── DONUT ── */
.donut-svg { width: 160px; height: 160px; }
.legend { display: flex; flex-wrap: wrap; gap: 8px 14px; margin-top: 10px; justify-content: center; }
.legend-item { display: flex; align-items: center; gap: 5px; font-size: 11px; color: var(--text-muted); }
.legend-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }

/* ── INBOX ── */
.inbox-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; }
.inbox-count { font-size: 11px; color: var(--text-muted); }
.inbox-list { display: flex; flex-direction: column; max-height: 280px; overflow-y: auto; }
.inbox-item { display: flex; align-items: flex-start; gap: 10px; padding: 10px 0; border-bottom: 1px solid var(--border); }
.inbox-item:last-child { border-bottom: none; }
.inbox-check { margin-top: 2px; accent-color: var(--blue); cursor: pointer; flex-shrink: 0; }
.inbox-body { flex: 1; min-width: 0; }
.inbox-id { font-size: 11px; color: var(--blue); font-weight: 600; font-family: var(--mono); }
.badge-medium {
  display: inline-block; font-size: 9px; font-weight: 700; letter-spacing: .06em;
  padding: 1px 6px; border-radius: 3px;
  background: rgba(245,158,11,.15); color: var(--orange); margin-left: 6px; vertical-align: middle;
}
.inbox-desc { font-size: 12px; color: var(--text); margin: 2px 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.inbox-meta { font-size: 10px; color: var(--text-dim); }
.inbox-actions { display: flex; align-items: center; gap: 5px; flex-shrink: 0; }
.btn-icon {
  width: 28px; height: 28px; border-radius: 6px; border: 1px solid var(--border);
  display: flex; align-items: center; justify-content: center; cursor: pointer;
  transition: all .15s; background: var(--surface2);
}
.btn-icon:hover { border-color: var(--green); }
.btn-icon.red:hover { border-color: var(--red); }
.btn-icon svg { width: 12px; height: 12px; }
.btn-review {
  padding: 5px 10px; border-radius: 6px; border: 1px solid var(--border);
  background: var(--surface2); color: var(--text-muted);
  font-size: 11px; font-weight: 500; cursor: pointer; transition: all .15s; white-space: nowrap;
}
.btn-review:hover { border-color: var(--blue); color: var(--blue); }

/* ── BAR CHART ── */
.bar-chart-wrap { width: 100%; height: 160px; }

/* ── ASSET HEALTH ── */
.asset-health-grid { display: grid; grid-template-columns: auto 1fr; gap: 18px; align-items: center; }
.health-legend-list { display: flex; flex-direction: column; gap: 8px; }
.health-legend-row { display: flex; align-items: center; justify-content: space-between; gap: 10px; font-size: 12px; }
.health-legend-left { display: flex; align-items: center; gap: 7px; }
.health-num { font-weight: 700; font-family: var(--mono); font-size: 13px; }
.health-pct { font-size: 11px; color: var(--text-muted); }

/* ── TABLE ── */
.table-header-row { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 10px; gap: 8px; flex-wrap: wrap; }
.table-actions { display: flex; gap: 6px; flex-shrink: 0; }
.tbl-icon-btn {
  width: 28px; height: 28px; border: 1px solid var(--border); border-radius: 6px;
  background: var(--surface2); display: flex; align-items: center; justify-content: center;
  cursor: pointer; color: var(--text-muted); transition: all .15s;
}
.tbl-icon-btn:hover { color: var(--blue); border-color: var(--blue); }
.tbl-icon-btn svg { width: 12px; height: 12px; }
table { width: 100%; border-collapse: collapse; }
thead tr { border-bottom: 1px solid var(--border); }
thead th {
  padding: 8px 10px; text-align: left;
  font-size: 10px; font-weight: 700; letter-spacing: .07em; text-transform: uppercase; color: var(--text-dim);
  white-space: nowrap;
}
thead th:first-child { width: 32px; }
tbody tr { border-bottom: 1px solid var(--border); transition: background .1s; }
tbody tr:hover { background: #f5f7ff; }
tbody td { padding: 10px 10px; font-size: 12px; }
.td-link { color: var(--blue); font-family: var(--mono); font-size: 11px; cursor: pointer; white-space: nowrap; }
.td-link:hover { text-decoration: underline; }
.status-badge { display: inline-block; padding: 3px 10px; border-radius: 20px; font-size: 10px; font-weight: 600; white-space: nowrap; }
.status-approved { background: rgba(62,207,142,.15); color: var(--green); }
.status-progress  { background: rgba(74,158,255,.15); color: var(--blue); }
.status-waiting   { background: rgba(245,158,11,.15);  color: var(--orange); }
.days-badge { display: inline-block; padding: 3px 10px; border-radius: 20px; font-size: 10px; font-weight: 700; font-family: var(--mono); white-space: nowrap; }
.days-urgent { background: rgba(239,68,68,.15);  color: var(--red); }
.days-ok     { background: rgba(62,207,142,.15);  color: var(--green); }
.days-mid    { background: rgba(245,158,11,.15);  color: var(--orange); }
.table-footer { display: flex; justify-content: space-between; align-items: center; margin-top: 12px; padding-top: 10px; border-top: 1px solid var(--border); flex-wrap: wrap; gap: 6px; }
.view-all-link { font-size: 12px; color: var(--blue); cursor: pointer; }
.view-all-link:hover { text-decoration: underline; }
.total-label { font-size: 11px; color: var(--text-muted); }

/* ── TABLE SCROLL WRAPPER ── */
.table-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }

/* ── SCROLLBAR ── */
::-webkit-scrollbar { width: 5px; height: 5px; }
::-webkit-scrollbar-track { background: #f0f2f5; }
::-webkit-scrollbar-thumb { background: #d1d5db; border-radius: 3px; }

/* ═══════════════════════════════════════
   RESPONSIVE BREAKPOINTS
═══════════════════════════════════════ */

/* 1280px: tighten grid-3-2 */
@@media (max-width: 1280px) {
  .stat-cards { grid-template-columns: repeat(2, 1fr); }
  .sparkline { width: 100px; }
}

/* 1024px: stack grid-3-2 */
@@media (max-width: 1024px) {
  .grid-3-2 { grid-template-columns: 1fr; }
  .grid-2   { grid-template-columns: 1fr; }
  .main { padding: 12px; gap: 10px; }
}

/* 768px: tablets */
@@media (max-width: 768px) {
  .top-nav { padding: 10px 16px; min-height: auto; gap: 10px; }
  .nav-divider { display: none; }
  .nav-right { gap: 6px; }
  .nav-btn { padding: 6px 10px; font-size: 11px; }
  .nav-btn span.btn-label { display: none; } /* hide text, keep icon on xs */
  .stat-cards { grid-template-columns: repeat(2, 1fr); gap: 10px; }
  .stat-value { font-size: 28px; }
  .sparkline { width: 80px; height: 46px; }
  .main { padding: 10px; }
  .panel { padding: 14px 14px; }
  /* hide less critical table columns */
  .tbl-hide-md { display: none; }
  .asset-health-grid { grid-template-columns: 1fr; justify-items: center; }
  .donut-svg { width: 140px; height: 140px; }
}

/* 640px: large phones landscape */
@@media (max-width: 640px) {
  .top-nav { padding: 10px 12px; }
  .nav-right .nav-btn:nth-child(n+3) { display: none; } /* keep first 2 btns */
  .stat-cards { grid-template-columns: 1fr 1fr; gap: 8px; }
  .stat-card { min-height: 120px; padding: 14px 14px 0; }
  .stat-icon-box { width: 36px; height: 36px; border-radius: 10px; }
  .stat-icon-box svg { width: 18px; height: 18px; }
  .stat-value { font-size: 24px; }
  .stat-badge { display: none; }
  .sparkline { display: none; }
  .load-metrics { flex-direction: column; gap: 6px; }
  .metric-item { min-width: unset; }
  .panel-title { font-size: 12px; }
  .inbox-actions .btn-review { display: none; }
}

/* 480px: phones portrait */
@@media (max-width: 480px) {
  .top-nav { padding: 8px 10px; }
  .nav-right { width: 100%; justify-content: flex-end; }
  .nav-right .nav-btn:nth-child(n+2) { display: none; } /* only 1 btn */
  .nav-title { font-size: 13px; }
  .nav-sub { display: none; }
  .stat-cards { grid-template-columns: 1fr 1fr; gap: 6px; }
  .stat-card { min-height: 110px; padding: 12px 12px 0; }
  .stat-value { font-size: 22px; }
  .main { padding: 8px; gap: 8px; }
  .panel { padding: 12px 12px; border-radius: 12px; }
  .tbl-hide-sm { display: none; }
  .chart-wrap { height: 120px; }
  .bar-chart-wrap { height: 130px; }
  .donut-svg { width: 120px; height: 120px; }
}

/* 360px: very small phones */
@@media (max-width: 360px) {
  .stat-cards { grid-template-columns: 1fr; }
  .stat-card { flex-direction: row; align-items: center; min-height: auto; padding: 12px; }
  .stat-card-bottom { flex-direction: row; align-items: center; gap: 8px; }
}
</style>



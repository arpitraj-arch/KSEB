    { desc: 'Transformer repair – 11kV Unit', status: 'Approved', target: '2 June', location: 'Trichur' },
    { desc: 'Substation upgrade – Bay Extension', status: 'Approved', target: '9 June', location: 'Quilon' },
  ];
  const statusClass = { 'Approved': 'status-approved', 'In Progress': 'status-progress', 'Waiting Materials': 'status-waiting' };
  const tbody = document.getElementById('workOrdersTable');
  workOrders.forEach(wo => {
    tbody.innerHTML += `<tr>
      <td><input type="checkbox" style="accent-color:var(--blue)"></td>
      <td><span class="td-link">WO-2026-0852</span></td>
      <td>${wo.desc}</td>
      <td><span class="status-badge ${statusClass[wo.status]||'status-approved'}">${wo.status}</span></td>
      <td class="tbl-hide-md">${wo.target}</td>
      <td class="tbl-hide-md">${wo.location}</td>
    </tr>`;
  });

  // WARRANTY
  const warranties = [
    { desc: 'Distribution Transformer 100kVA', loc: 'Ernakulam', expiry: '12 May', days: 12, cls: 'days-urgent' },
    { desc: 'HT Switchgear Assembly', loc: 'Thiruvananthapuram', expiry: '19 May', days: 84, cls: 'days-ok' },
    { desc: 'Cable Joint Kit', loc: 'Calicut', expiry: '26 May', days: 47, cls: 'days-mid' },
    { desc: 'Transformer 200kVA', loc: 'Trichur', expiry: '2 June', days: 29, cls: 'days-urgent' },
    { desc: 'Substation Control Panel', loc: 'Quilon', expiry: '9 June', days: 84, cls: 'days-ok' },
    { desc: 'Metering Equipment', loc: 'Alleppey', expiry: '16 June', days: 12, cls: 'days-urgent' },
  ];
  const wTbody = document.getElementById('warrantyTable');
  warranties.forEach(w => {
    wTbody.innerHTML += `<tr>
      <td><span class="td-link">WO-2026-0852</span></td>
      <td>${w.desc}</td>
      <td class="tbl-hide-sm">${w.loc}</td>
      <td class="tbl-hide-sm">${w.expiry}</td>
      <td><span class="days-badge ${w.cls}">${w.days} days</span></td>
    </tr>`;
  });

  // SELECT ALL
  document.querySelectorAll('thead input[type=checkbox]').forEach(cb => {
    cb.addEventListener('change', function() {
      const t = this.closest('table');
      t.querySelectorAll('tbody input[type=checkbox]').forEach(c => c.checked = this.checked);
    });
  });
</script>


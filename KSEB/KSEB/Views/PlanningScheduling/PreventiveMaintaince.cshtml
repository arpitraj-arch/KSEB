</div><!-- /bottom-grid -->

<script>
  /* ─ Data ───────────────────────── */
  const pmData = [
    { id:'SP-2045', name:'Quaterly VCB Maintenance', sub:'', asset:'All 11kV VCB', jp:'JP-1054', freq:'90 d', due:'23 Jun', basis:'ROUTE', status:'Overdue' },
    { id:'SP-3098', name:'DTR Oil DGA Sampling', sub:'', asset:'All DTRs (98)', jp:'JP-1054', freq:'180 d', due:'05 Jul', basis:'TIME', status:'Overdue' },
    { id:'SP-4176', name:'Line Patrol – 15kV Feeders', sub:'', asset:'Feeder Route R-04', jp:'JP-1054', freq:'30 d', due:'16 Aug', basis:'TIME', status:'Active' },
    { id:'SP-5231', name:'SF6 Pressure Check', sub:'', asset:'SF6 CBs (96)', jp:'JP-1054', freq:'90 d', due:'30 Sep', basis:'METER', status:'Active' },
    { id:'SP-6347', name:'Earthing Pit Resistance', sub:'', asset:'All SS PPs (96)', jp:'JP-1054', freq:'90 d', due:'14 Oct', basis:'TIME', status:'Active' },
    { id:'SP-7489', name:'11kV Meter Cycle Calibration', sub:'', asset:'All Meters 11 kV (1,750)', jp:'JP-1054', freq:'90 d', due:'02 Nov', basis:'METER', status:'Active' },
    { id:'SP-8560', name:'Capacitor Bank Inspection', sub:'', asset:'11kV Cap-Bank (12)', jp:'JP-1054', freq:'90 d', due:'03 Dec', basis:'METER', status:'Active' },
    { id:'SP-9623', name:'DTR Oil DGA Sampling', sub:'', asset:'SF6 CBs (50)', jp:'JP-1054', freq:'90 d', due:'11 Jan', basis:'ROUTE', status:'Active' },
  ];

  const triggers = [
    { name:'SF6 – CB – Karamana – 01', sub:'Operations', val:942, max:1000, pct:94.2 },
    { name:'SF6 – CB – Karamana – 01', sub:'Operations', val:942, max:1000, pct:94.2 },
    { name:'SF6 – CB – Karamana – 01', sub:'Operations', val:942, max:1000, pct:94.2 },
    { name:'SF6 – CB – Karamana – 01', sub:'Operations', val:942, max:1020, pct:92.4 },
  ];

  const routes = [
    { id:'R-05', name:'Museum Road Security Sweep',     stops:22, crew:'Crew – E', due:'10-May', badge:'due-sched' },
    { id:'R-07', name:'Central Mall Entrance Guard',    stops:12, crew:'Crew – D', due:'12-May', badge:'due-sched' },
    { id:'R-06', name:'Station Square Night Watch',     stops:15, crew:'Crew – C', due:'11-May', badge:'due-ok'    },
    { id:'R-08', name:'City Park Surveillance',         stops:20, crew:'Crew – I', due:'13-May', badge:'due-sched' },
  ];

  const months = ['May','Jun','Jul','Aug','Sep','Oct','Nov','Dec','Jan','Feb','Mar','Apr'];
  const forecastVals = [165, 180, 155, 170, 190, 175, 160, 145, 185, 170, 155, 165];

  /* ─ Render PM Table ─────────── */
  document.getElementById('pmBody').innerHTML = pmData.map((r,i) => `
    <tr class="${i===0?'sel':''}" onclick="selRow(this)">
      <td class="pm-id">${r.id}</td>
      <td class="pm-name">${r.name}${r.sub?`<small>${r.sub}</small>`:''}</td>
      <td style="font-size:11.5px;color:var(--text-secondary);max-width:110px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${r.asset}</td>
      <td class="jp-ref">${r.jp}</td>
      <td class="freq-cell">${r.freq}</td>
      <td class="due-cell">${r.due}</td>
      <td><span class="basis-tag basis-${r.basis.toLowerCase()}">${r.basis}</span></td>
      <td><span class="status-badge ${r.status==='Overdue'?'s-overdue':'s-active'}">${r.status}</span></td>
    </tr>
  `).join('');
  function selRow(r) {
    document.querySelectorAll('#pmBody tr').forEach(x=>x.classList.remove('sel'));
    r.classList.add('sel');
  }

  /* ─ Render Triggers ─────────── */
  document.getElementById('triggerList').innerHTML = triggers.map(t => {
    const cls = t.pct >= 95 ? 'prog-red' : t.pct >= 85 ? 'prog-amber' : 'prog-green';
    return `
      <div class="trigger-item">
        <div class="trigger-top">
          <div class="trigger-name">${t.name}</div>
          <div class="trigger-reading">${t.val} / ${t.max}</div>
        </div>
        <div class="trigger-sub">${t.sub}</div>
        <div class="progress-bar"><div class="progress-fill ${cls}" style="width:${t.pct}%"></div></div>
        <div class="trigger-pct">${t.pct}% of threshold</div>
      </div>
    `;
  }).join('');

  /* ─ Render Routes ───────────── */
  document.getElementById('routeBody').innerHTML = routes.map(r => `
    <tr>
      <td><div class="route-id">${r.id}</div><div class="route-name">${r.name}</div></td>
      <td style="text-align:center;font-size:12px;color:var(--text-secondary)">${r.stops}</td>
      <td class="route-crew">${r.crew}</td>
      <td><span class="due-badge ${r.badge}">${r.due}</span></td>
    </tr>
  `).join('');

  /* ─ Forecast Chart ──────────── */
  (function() {
    const svg = document.getElementById('forecastChart');
    const W = 480, H = 180;
    const pad = { top: 16, right: 10, bottom: 30, left: 32 };
    const chartW = W - pad.left - pad.right;
    const chartH = H - pad.top - pad.bottom;
    const maxVal = Math.max(...forecastVals);
    const barW = (chartW / months.length) * 0.54;
    const barGap = chartW / months.length;

    let html = '';
    // Grid lines
    [0, .25, .5, .75, 1].forEach(f => {
      const y = pad.top + chartH * (1 - f);
      const lbl = Math.round(maxVal * f);
      html += `<line x1="${pad.left}" y1="${y}" x2="${W - pad.right}" y2="${y}" stroke="var(--border)" stroke-width="1" stroke-dasharray="4 3"/>`;
      if (f > 0) html += `<text x="${pad.left - 4}" y="${y + 4}" class="chart-val" text-anchor="end">${lbl}</text>`;
    });

    // Bars
    months.forEach((m, i) => {
      const x = pad.left + i * barGap + (barGap - barW) / 2;
      const barH = (forecastVals[i] / maxVal) * chartH;
      const y = pad.top + chartH - barH;
      const isOver = i < 2;
      html += `
        <rect x="${x}" y="${y}" width="${barW}" height="${barH}"
          rx="3"
          fill="${isOver ? 'var(--red)' : 'var(--bar-blue)'}"
          opacity="${isOver ? '.85' : '.85'}"
          class="bar"/>
        <text x="${x + barW/2}" y="${H - 8}" class="chart-label" text-anchor="middle">${m}</text>
      `;
    });

    svg.innerHTML = html;
  })();

  /* ─ Page button interactions ─── */
  document.querySelectorAll('.pg-btn').forEach(b => {
    b.addEventListener('click', function() {
      document.querySelectorAll('.pg-btn').forEach(x=>x.classList.remove('active'));
      this.classList.add('active');
    });
  });
</script>

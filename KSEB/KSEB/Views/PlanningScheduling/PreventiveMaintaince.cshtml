<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Preventive Maintenance – Planning & Scheduling</title>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #eef1f6;
    --surface: #ffffff;
    --surface-2: #f6f8fb;
    --surface-3: #edf0f6;
    --border: #e0e5ef;
    --border-strong: #c5ccd9;
    --text-primary: #111827;
    --text-secondary: #4b5568;
    --text-muted: #8696b0;
    --blue: #1d56d8;
    --blue-light: #edf2ff;
    --blue-mid: #3b82f6;
    --green: #0e9f6e;
    --green-light: #ecfdf5;
    --red: #e02424;
    --red-light: #fef2f2;
    --orange: #d97706;
    --orange-light: #fffbeb;
    --teal: #0891b2;
    --teal-light: #ecfeff;
    --purple: #7c3aed;
    --purple-light: #f5f3ff;
    --bar-blue: #3b82f6;
    --bar-blue-dark: #1d4ed8;
    --shadow-xs: 0 1px 2px rgba(0,0,0,.04);
    --shadow-sm: 0 2px 6px rgba(0,0,0,.06), 0 1px 2px rgba(0,0,0,.04);
    --shadow: 0 4px 16px rgba(0,0,0,.08);
    --r: 10px;
    --r-sm: 6px;
    --r-xs: 4px;
    --font: 'Plus Jakarta Sans', sans-serif;
    --mono: 'JetBrains Mono', monospace;
  }
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: var(--font); background: var(--bg); color: var(--text-primary); font-size: 13px; min-height: 100vh; }

  /* ─ Breadcrumb ─────────────── */
  .breadcrumb {
    background: var(--surface); border-bottom: 1px solid var(--border);
    padding: 8px 22px; font-size: 11.5px; color: var(--text-muted);
    display: flex; align-items: center; gap: 6px; flex-wrap: wrap;
  }
  .breadcrumb a { color: var(--text-muted); text-decoration: none; }
  .breadcrumb a:hover { color: var(--blue); }
  .breadcrumb .cur { color: var(--text-secondary); font-weight: 600; }

  /* ─ Page Header ────────────── */
  .page-header {
    background: var(--surface); border-bottom: 1px solid var(--border);
    padding: 13px 22px 15px;
    display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; flex-wrap: wrap;
  }
  .ph-left { display: flex; align-items: center; gap: 11px; }
  .back-btn {
    width: 30px; height: 30px; border: 1.5px solid var(--border-strong);
    border-radius: var(--r-sm); background: transparent; cursor: pointer;
    display: flex; align-items: center; justify-content: center; color: var(--text-secondary);
    transition: all .15s; flex-shrink: 0;
  }
  .back-btn:hover { border-color: var(--blue); color: var(--blue); }
  .ph-title h1 { font-size: 17px; font-weight: 700; letter-spacing: -.4px; }
  .ph-title p { font-size: 11.5px; color: var(--text-muted); margin-top: 2px; }
  .ph-actions { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .btn {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 8px 14px; border-radius: var(--r-sm); font-size: 12.5px; font-weight: 600;
    cursor: pointer; font-family: var(--font); transition: all .15s; white-space: nowrap;
    border: 1.5px solid transparent;
  }
  .btn-outline { background: var(--surface); border-color: var(--border-strong); color: var(--text-secondary); }
  .btn-outline:hover { border-color: var(--blue); color: var(--blue); }
  .btn-dark { background: var(--text-primary); color: #fff; }
  .btn-dark:hover { background: #1f2b47; }
  .btn-blue { background: var(--blue); color: #fff; }
  .btn-blue:hover { background: #1745b8; }

  /* ─ Stats Bar ──────────────── */
  .stats-bar {
    background: var(--surface); border-bottom: 1px solid var(--border);
    padding: 0 22px; display: flex; overflow-x: auto; -webkit-overflow-scrolling: touch;
  }
  .stat {
    display: flex; align-items: center; gap: 11px;
    padding: 13px 22px 13px 0; border-right: 1px solid var(--border);
    min-width: 160px;
  }
  .stat:first-child { padding-left: 0; }
  .stat:last-child { border-right: none; }
  .stat-ico { width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 16px; flex-shrink: 0; }
  .stat-lbl { font-size: 9.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .7px; color: var(--text-muted); }
  .stat-val { font-size: 24px; font-weight: 800; letter-spacing: -1.2px; line-height: 1.1; margin-top: 2px; font-family: var(--mono); }
  .stat-sub { font-size: 10.5px; color: var(--text-muted); margin-top: 2px; }
  .stat-sub.pos { color: var(--green); font-weight: 600; }
  .stat-sub.neg { color: var(--red); font-weight: 600; }
  sup { font-size: .55em; vertical-align: super; }

  /* ─ Main Grid ──────────────── */
  .main-grid {
    display: grid; grid-template-columns: 1fr 330px;
    gap: 14px; padding: 16px 22px;
  }
  .bottom-grid {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 14px; padding: 0 22px 20px;
  }

  /* ─ Panel ──────────────────── */
  .panel {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--r); overflow: hidden; box-shadow: var(--shadow-xs);
  }
  .panel-hd { padding: 12px 16px 10px; border-bottom: 1px solid var(--border); }
  .panel-hd h2 { font-size: 13.5px; font-weight: 700; }
  .panel-hd p { font-size: 11px; color: var(--text-muted); margin-top: 2px; }

  /* ─ Search & Filter ─────────── */
  .filter-row {
    display: flex; align-items: center; gap: 7px;
    padding: 9px 16px; border-bottom: 1px solid var(--border); flex-wrap: wrap;
  }
  .srch-wrap { flex: 1; min-width: 130px; position: relative; }
  .srch-wrap svg { position: absolute; left: 8px; top: 50%; transform: translateY(-50%); color: var(--text-muted); pointer-events: none; }
  .srch-inp {
    width: 100%; border: 1px solid var(--border); border-radius: var(--r-xs);
    padding: 6px 8px 6px 28px; font-size: 12px; font-family: var(--font);
    background: var(--surface-2); color: var(--text-primary); outline: none; transition: border-color .15s;
  }
  .srch-inp:focus { border-color: var(--blue); background: #fff; }
  .srch-inp::placeholder { color: var(--text-muted); }
  .fsel {
    border: 1px solid var(--border); border-radius: var(--r-xs);
    padding: 6px 9px; font-size: 11.5px; font-family: var(--font);
    color: var(--text-secondary); background: var(--surface-2); outline: none; cursor: pointer;
  }
  .fbtn {
    display: flex; align-items: center; gap: 4px;
    border: 1px solid var(--border); border-radius: var(--r-xs);
    padding: 6px 10px; font-size: 11.5px; font-family: var(--font);
    color: var(--text-secondary); background: var(--surface-2); cursor: pointer; transition: all .15s;
  }
  .fbtn:hover { border-color: var(--blue); color: var(--blue); }

  /* ─ PM Table ───────────────── */
  .tbl-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  table { width: 100%; border-collapse: collapse; font-size: 12px; }
  thead th {
    padding: 7px 10px; text-align: left;
    font-size: 9.5px; font-weight: 700; color: var(--text-muted);
    text-transform: uppercase; letter-spacing: .5px;
    background: var(--surface-2); border-bottom: 1px solid var(--border); white-space: nowrap;
  }
  tbody tr { border-bottom: 1px solid var(--border); cursor: pointer; transition: background .1s; }
  tbody tr:last-child { border-bottom: none; }
  tbody tr:hover { background: #f5f7fd; }
  tbody tr.sel { background: var(--blue-light); }
  tbody td { padding: 8px 10px; vertical-align: middle; }
  .pm-id { color: var(--blue); font-weight: 700; font-size: 11.5px; font-family: var(--mono); white-space: nowrap; }
  .pm-name { font-weight: 600; font-size: 12px; }
  .pm-name small { display: block; font-weight: 400; color: var(--text-muted); font-size: 11px; }
  .jp-ref { color: var(--blue); font-size: 11.5px; font-weight: 600; }
  .freq-cell { font-size: 11.5px; color: var(--text-secondary); white-space: nowrap; }
  .due-cell { font-size: 11.5px; color: var(--text-secondary); white-space: nowrap; }
  .basis-tag {
    display: inline-block; padding: 2px 7px; border-radius: 20px;
    font-size: 10px; font-weight: 700; letter-spacing: .3px; white-space: nowrap;
  }
  .basis-route  { background: var(--purple-light); color: var(--purple); }
  .basis-time   { background: var(--teal-light); color: var(--teal); }
  .basis-meter  { background: var(--blue-light); color: var(--blue); }
  .status-badge {
    display: inline-flex; align-items: center; gap: 4px;
    padding: 2px 9px; border-radius: 20px; font-size: 10.5px; font-weight: 700; white-space: nowrap;
  }
  .status-badge::before { content: ''; display: block; width: 5px; height: 5px; border-radius: 50%; background: currentColor; }
  .s-active   { background: var(--green-light); color: var(--green); }
  .s-overdue  { background: var(--red-light); color: var(--red); }

  /* ─ Meter Based Triggers ────── */
  .trigger-list { padding: 10px 14px; display: flex; flex-direction: column; gap: 10px; }
  .trigger-item { padding: 11px 12px; border: 1px solid var(--border); border-radius: var(--r-sm); background: var(--surface-2); }
  .trigger-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 6px; }
  .trigger-name { font-size: 12px; font-weight: 700; }
  .trigger-reading { font-family: var(--mono); font-size: 11.5px; color: var(--text-secondary); white-space: nowrap; }
  .trigger-sub { font-size: 11px; color: var(--text-muted); margin-bottom: 7px; }
  .progress-bar { height: 6px; background: var(--surface-3); border-radius: 10px; overflow: hidden; margin-bottom: 4px; }
  .progress-fill { height: 100%; border-radius: 10px; transition: width .4s ease; }
  .prog-green { background: linear-gradient(90deg, #10b981, #34d399); }
  .prog-amber { background: linear-gradient(90deg, #f59e0b, #fbbf24); }
  .prog-red   { background: linear-gradient(90deg, #ef4444, #f87171); }
  .trigger-pct { font-size: 10.5px; color: var(--text-muted); text-align: right; }
  .trigger-cta {
    display: flex; align-items: center; justify-content: center; gap: 6px;
    margin: 8px 14px 12px;
    border: 1.5px dashed var(--blue); border-radius: var(--r-sm);
    padding: 9px; color: var(--blue); font-size: 12px; font-weight: 600;
    cursor: pointer; transition: all .15s; background: var(--blue-light);
  }
  .trigger-cta:hover { background: #dbeafe; }

  /* ─ 12-Month Forecast ────────── */
  .chart-wrap { padding: 14px 16px 16px; }
  .chart-svg { width: 100%; overflow: visible; }
  .bar-group:hover rect { opacity: .8; }
  .chart-label { font-size: 10px; fill: var(--text-muted); font-family: var(--font); }
  .chart-val { font-size: 9px; fill: var(--text-muted); font-family: var(--mono); }

  /* ─ Route Triggers Table ─────── */
  .routes-table { width: 100%; border-collapse: collapse; font-size: 12px; }
  .routes-table thead th {
    padding: 7px 12px; text-align: left;
    font-size: 9.5px; font-weight: 700; color: var(--text-muted);
    text-transform: uppercase; letter-spacing: .5px;
    background: var(--surface-2); border-bottom: 1px solid var(--border);
  }
  .routes-table tbody tr { border-bottom: 1px solid var(--border); transition: background .1s; }
  .routes-table tbody tr:last-child { border-bottom: none; }
  .routes-table tbody tr:hover { background: var(--surface-2); }
  .routes-table tbody td { padding: 9px 12px; vertical-align: middle; }
  .route-id { font-family: var(--mono); font-size: 11.5px; color: var(--blue); font-weight: 600; }
  .route-name { font-size: 12px; font-weight: 500; }
  .route-crew { font-size: 11.5px; color: var(--text-muted); }
  .due-badge {
    display: inline-block; padding: 2px 8px; border-radius: 20px;
    font-size: 10.5px; font-weight: 700; white-space: nowrap;
  }
  .due-sched { background: var(--blue-light); color: var(--blue); }
  .due-ok    { background: var(--green-light); color: var(--green); }
  .routes-footer {
    padding: 9px 14px; border-top: 1px solid var(--border);
    background: var(--surface-2); font-size: 11px; color: var(--text-muted);
    display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 6px;
  }
  .routes-footer a { color: var(--blue); font-weight: 600; text-decoration: none; cursor: pointer; }

  /* ─ Responsive ──────────────── */
  @@media (max-width: 1080px) {
    .main-grid { grid-template-columns: 1fr; }
  }
  @@media (max-width: 820px) {
    .bottom-grid { grid-template-columns: 1fr; }
    .main-grid, .bottom-grid { padding: 12px 14px; }
    .bottom-grid { padding-bottom: 16px; }
    .stats-bar { padding: 0 14px; }
    .page-header, .breadcrumb { padding-left: 14px; padding-right: 14px; }
    .stat { min-width: 130px; padding-right: 16px; }
  }
  @@media (max-width: 520px) {
    .stat { min-width: 110px; }
    .stat-val { font-size: 19px; }
    .ph-actions .btn-outline:not(.btn-blue) { display: none; }
    .fsel { display: none; }
    .main-grid, .bottom-grid { padding: 10px; }
    .bottom-grid { padding-bottom: 12px; }
  }
</style>


<!-- Breadcrumb -->
<nav class="breadcrumb">
  
  <a href="#">Planning &amp; Scheduling</a> <span>›</span>
  <span class="cur">Preventive Maintenance</span>
</nav>

<!-- Page Header -->

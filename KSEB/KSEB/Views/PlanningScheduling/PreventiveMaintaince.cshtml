    <div class="panel-hd">
      <h2>12 – Month PM Forecast</h2>
      <p>Projected workload by month – scheduled vs. overday</p>
    </div>
    <div class="chart-wrap">
      <svg class="chart-svg" id="forecastChart" viewBox="0 0 480 180"></svg>
    </div>
  </div>

  <!-- Meter Based Triggers / Routes -->
  <div class="panel">
    <div class="panel-hd">
      <h2>Meter – Based Triggers</h2>
      <p>Approaching threshold · auto-generate WO</p>
    </div>
    <div style="overflow-x:auto;">
      <table class="routes-table">
        <thead>
          <tr>
            <th>Route</th>

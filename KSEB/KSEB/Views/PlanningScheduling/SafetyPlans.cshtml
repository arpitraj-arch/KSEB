<script>
  /* ── Data ─────────────────────────────────── */
  const spData = [
    { id:'SP-2045', name:'33kV TG Panel Inspection', sub:'Safety Checks', jp:'JP-1042', hz:12, pr:12, permit:'PTW + LOTO', status:'Draft' },
    { id:'SP-3098', name:'Battery Bank Maintenance', sub:'Capacity Testing', jp:'JP-1042', hz:12, pr:12, permit:'Hot Water + PTW', status:'Draft' },
    { id:'SP-4176', name:'Substation Earthing System', sub:'Integrity Inspection', jp:'JP-1042', hz:9, pr:9, permit:'Line Clear', status:'Active' },
    { id:'SP-5231', name:'Electrical Meter Verification', sub:'Accuracy Checks', jp:'JP-1042', hz:9, pr:9, permit:'Height Permit', status:'Active' },
    { id:'SP-6347', name:'DG Set Load Testing', sub:'Performance Review', jp:'JP-1042', hz:9, pr:9, permit:'PTW', status:'Active' },
    { id:'SP-7489', name:'Relay Panel Calibration', sub:'Protection Settings', jp:'JP-1042', hz:3, pr:3, permit:'Confined + PTW', status:'Active' },
    { id:'SP-8560', name:'11kV Cable Jointing', sub:'Quality Assurance', jp:'JP-1042', hz:7, pr:7, permit:'Height Permit', status:'Active' },
    { id:'SP-9623', name:'Power Transformer Oil Analysis', sub:'Routine Testing', jp:'JP-1042', hz:7, pr:7, permit:'Hot Water + PTW', status:'Active' },
  ];

  const hazards = [
    { icon:'⚡', iconBg:'#fff0f0', iconColor:'#d42b2b', name:'Electric Shock – Induced Voltage', desc:'Verify dead with HV tester, apply earthing both sides', risk:'High' },
    { icon:'🔥', iconBg:'#fff4ec', iconColor:'#e8650a', name:'Arc Flash on VCB Operation', desc:'Wear Cat-3 PPE; maintain 1.2m boundary; remote racking', risk:'High' },
    { icon:'⚙️', iconBg:'#f3eeff', iconColor:'#6a35cc', name:'Falling Object from Switchgear', desc:'Barricade work zone; helmet & safety shoes mandatory', risk:'Medium' },
    { icon:'💧', iconBg:'#edfafc', iconColor:'#0e8fa0', name:'Slips on Insulating Oil Spill', desc:'Drip tray; absorbent mat; cleanup procedure', risk:'Medium' },
    { icon:'🧪', iconBg:'#edfaf3', iconColor:'#0f9b5c', name:'Solvent Vapour Exposure', desc:'Ventilation, Respirator if Confined', risk:'Low' },
  ];

  const lotoSteps = [
    { num:2, desc:'Verify isolation status on SCADA', role:'Control Engineer' },
    { num:4, desc:'Test for absence of voltage', role:'Technician' },
    { num:5, desc:'Authorize work commencement', role:'Shift Manager' },
    { num:3, desc:'Lockout and tagout the feeder panel', role:'Safety Officer' },
    { num:6, desc:'Document isolation in maintenance log', role:'Admin Clerk' },
  ];

  const permits = [
    { no:'PTW-2026-0416', type:'Hot Work', area:'Sunset Boulevard, West End',      exp:'Yest 20:00' },
    { no:'PTW-2026-0416', type:'Hot Work', area:'Lakeside Plaza, Midtown',         exp:'Yest 20:00' },
    { no:'PTW-2026-0416', type:'Hot Work', area:'Cedar Grove, Riverside',          exp:'Yest 20:00' },
    { no:'PTW-2026-0416', type:'Hot Work', area:'Greenwood Park, Downtown',        exp:'Yest 20:00' },
    { no:'PTW-2026-0416', type:'Hot Work', area:'Greenwood Park, Downtown',        exp:'Yest 20:00' },
    { no:'PTW-2026-0416', type:'Hot Work', area:'Sunset Boulevard, West End',      exp:'Yest 20:00' },
    { no:'PTW-2026-0416', type:'Hot Work', area:'Sunset Boulevard, West End',      exp:'Yest 20:00' },
  ];

  /* ── Render SP Table ──────────────────────── */
  function renderSP() {
    const tbody = document.getElementById('spTableBody');
    tbody.innerHTML = spData.map((r,i) => `
      <tr class="${i===0?'sel':''}" onclick="selectSP(this)">
        <td class="sp-id">${r.id}</td>
        <td class="plan-name-cell">${r.name}<small>${r.sub}</small></td>
        <td class="jp-link">${r.jp}</td>
        <td class="num-col">${r.hz}</td>
        <td class="num-col">${r.pr}</td>
        <td><span class="permit-tag">${r.permit}</span></td>
        <td><span class="badge ${r.status.toLowerCase()}"><span class="badge-dot"></span>${r.status}</span></td>
      </tr>
    `).join('');
  }
  function selectSP(row) {
    document.querySelectorAll('#spTableBody tr').forEach(r=>r.classList.remove('sel'));
    row.classList.add('sel');
  }

  /* ── Render Hazards ───────────────────────── */
  function renderHazards() {
    const list = document.getElementById('hazardList');
    list.innerHTML = hazards.map(h => `
      <div class="hazard-item">
        <div class="hazard-icon-wrap" style="background:${h.iconBg};color:${h.iconColor};">${h.icon}</div>
        <div class="hazard-body">
          <div class="hazard-name">${h.name}</div>
          <div class="hazard-desc">${h.desc}</div>
        </div>
        <span class="risk-badge risk-${h.risk.toLowerCase()}">${h.risk}</span>
      </div>
    `).join('');
  }

  /* ── Render LOTO Steps ────────────────────── */
  function renderLOTO() {
    const container = document.getElementById('lotoSteps');
    container.innerHTML = lotoSteps.map(s => `
      <div class="loto-step">
        <div class="step-num">${s.num}</div>
        <div class="step-desc">${s.desc}</div>
        <div class="step-role">${s.role}</div>
      </div>
    `).join('');
  }

  /* ── Render Permits ───────────────────────── */
  function renderPermits() {
    const tbody = document.getElementById('permitsBody');
    tbody.innerHTML = permits.map(p => `
      <tr>
        <td class="permit-no">${p.no}</td>
        <td><span class="permit-type">${p.type}</span></td>
        <td class="permit-area">${p.area}</td>
        <td class="permit-expires">${p.exp}</td>
        <td><span class="badge active"><span class="badge-dot"></span>Active</span></td>
      </tr>
    `).join('');
  }

  /* ── Page btn interactions ────────────────── */
  document.querySelectorAll('.pg-btn').forEach(btn => {
    btn.addEventListener('click', function() {
      document.querySelectorAll('.pg-btn').forEach(b=>b.classList.remove('active'));
      this.classList.add('active');
    });
  });

  renderSP();
  renderHazards();
  renderLOTO();
  renderPermits();
</script>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Safety Plans – Planning & Scheduling</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #f1f3f7;
    --surface: #ffffff;
    --surface-2: #f7f8fb;
    --surface-3: #eef0f5;
    --border: #e3e7ef;
    --border-strong: #c9d0dd;
    --text-primary: #141926;
    --text-secondary: #4a5468;
    --text-muted: #8691a8;
    --green: #0f9b5c;
    --green-bg: #edfaf3;
    --orange: #e8650a;
    --orange-bg: #fff4ec;
    --red: #d42b2b;
    --red-bg: #fff0f0;
    --amber: #c47c00;
    --amber-bg: #fff8e6;
    --blue: #1a60d7;
    --blue-bg: #edf3ff;
    --teal: #0e8fa0;
    --teal-bg: #edfafc;
    --purple: #6a35cc;
    --purple-bg: #f3eeff;
    --cyan: #0e7fa8;
    --shadow-sm: 0 1px 3px rgba(0,0,0,.05), 0 1px 2px rgba(0,0,0,.04);
    --shadow: 0 4px 14px rgba(0,0,0,.07), 0 2px 4px rgba(0,0,0,.04);
    --shadow-lg: 0 10px 30px rgba(0,0,0,.1);
    --radius: 10px;
    --radius-sm: 6px;
    --radius-xs: 4px;
    --font: 'Epilogue', sans-serif;
    --font-head: 'Syne', sans-serif;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: var(--font);
    background: var(--bg);
    color: var(--text-primary);
    font-size: 14px;
    line-height: 1.5;
    min-height: 100vh;
  }

  /* ── Breadcrumb ─────────────────────────────── */
  .breadcrumb {
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    padding: 9px 24px;
    font-size: 14px;
    color: var(--text-muted);
    display: flex; align-items: center; gap: 6px; flex-wrap: wrap;
  }
  .breadcrumb a { color: var(--text-muted); text-decoration: none; transition: color .15s; }
  .breadcrumb a:hover { color: var(--blue); }
  .breadcrumb .current { color: var(--text-secondary); font-weight: 600; }

  /* ── Page Header ────────────────────────────── */
  .page-header {
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    padding: 14px 24px 16px;
    display: flex; align-items: flex-start;
    justify-content: space-between; gap: 16px;
    flex-wrap: wrap;
  }
  .header-left { display: flex; align-items: center; gap: 12px; }
  .back-btn {
    width: 30px; height: 30px;
    border: 1.5px solid var(--border-strong);
    border-radius: var(--radius-sm);
    background: var(--surface);
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    color: var(--text-secondary);
    transition: all .15s; flex-shrink: 0;
  }
  .back-btn:hover { border-color: var(--blue); color: var(--blue); }
  .header-title h1 { font-family: var(--font-head); font-size: 18px; font-weight: 700; letter-spacing: -.4px; }
  .header-title p { font-size: 12px; color: var(--text-muted); margin-top: 2px; }
  .header-actions { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }

  .btn {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 8px 15px; border-radius: var(--radius-sm);
    font-size: 12.5px; font-weight: 500; cursor: pointer;
    font-family: var(--font); transition: all .15s; white-space: nowrap;
    border: 1.5px solid transparent;
  }
  .btn-outline { background: var(--surface); border-color: var(--border-strong); color: var(--text-secondary); }
  .btn-outline:hover { border-color: var(--blue); color: var(--blue); }
  .btn-dark { background: var(--text-primary); color: #fff; border-color: var(--text-primary); }
  .btn-dark:hover { background: #1e2740; }

  /* ── Stats Bar ──────────────────────────────── */
  .stats-bar {
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    padding: 0 24px;
    display: flex; align-items: stretch;
    overflow-x: auto; -webkit-overflow-scrolling: touch;
  }
  .stat-card {
    display: flex; align-items: center; gap: 11px;
    padding: 14px 24px 14px 0;
    border-right: 1px solid var(--border);
    min-width: 150px;
  }
  .stat-card:last-child { border-right: none; }
  .stat-card:first-child { padding-left: 0; }
  .stat-icon {
    width: 38px; height: 38px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 16px; flex-shrink: 0;
  }
  .stat-info { min-width: 0; }
  .stat-label { font-size: 9.5px; font-weight: 600; text-transform: uppercase; letter-spacing: .7px; color: var(--text-muted); }
  .stat-value { font-family: var(--font-head); font-size: 26px; font-weight: 700; letter-spacing: -1.5px; line-height: 1; margin-top: 3px; }
  .stat-sub { font-size: 10.5px; color: var(--text-muted); margin-top: 2px; }
  .stat-value sup { font-size: 14px; font-weight: 600; vertical-align: super; margin-right: 1px; }

  /* ── Main Grid ──────────────────────────────── */
  .main-grid {
    display: grid;
    grid-template-columns: 1fr 400px;
    grid-template-rows: auto auto;
    gap: 14px;
    padding: 16px 24px;
    align-items: start;
  }
  .bottom-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    padding: 0 24px 20px;
  }

  /* ── Panel ──────────────────────────────────── */
  .panel {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }
  .panel-hd {
    padding: 13px 16px 11px;
    border-bottom: 1px solid var(--border);
  }
  .panel-hd h2 { font-family: var(--font-head); font-size: 14px; font-weight: 700; }
  .panel-hd p { font-size: 11px; color: var(--text-muted); margin-top: 2px; }

  /* ── Search / Filter Bar ────────────────────── */
  .filter-bar {
    display: flex; align-items: center; gap: 8px;
    padding: 10px 16px;
    border-bottom: 1px solid var(--border);
    flex-wrap: wrap;
  }
  .search-wrap { flex: 1; min-width: 150px; position: relative; }
  .search-wrap svg { position: absolute; left: 9px; top: 50%; transform: translateY(-50%); color: var(--text-muted); pointer-events: none; }
  .search-input {
    width: 100%; border: 1px solid var(--border);
    border-radius: var(--radius-xs); padding: 7px 9px 7px 30px;
    font-size: 12px; font-family: var(--font);
    background: var(--surface-2); color: var(--text-primary);
    outline: none; transition: border-color .15s;
  }
  .search-input:focus { border-color: var(--blue); background: #fff; }
  .search-input::placeholder { color: var(--text-muted); }
  .filter-select {
    border: 1px solid var(--border); border-radius: var(--radius-xs);
    padding: 7px 10px; font-size: 14px; font-family: var(--font);
    color: var(--text-secondary); background: var(--surface-2);
    outline: none; cursor: pointer;
  }
  .filter-btn-sm {
    display: flex; align-items: center; gap: 5px;
    border: 1px solid var(--border); border-radius: var(--radius-xs);
    padding: 7px 11px; font-size: 14px; font-family: var(--font);
    color: var(--text-secondary); background: var(--surface-2);
    cursor: pointer; transition: all .15s;
  }
  .filter-btn-sm:hover { border-color: var(--blue); color: var(--blue); }

  /* ── Table ──────────────────────────────────── */
  .tbl-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  table { width: 100%; border-collapse: collapse; font-size: 12px; }
  thead th {
    padding: 7px 12px; text-align: left;
    font-size: 10px; font-weight: 700; color: var(--text-muted);
    text-transform: uppercase; letter-spacing: .5px;
    background: var(--surface-2); border-bottom: 1px solid var(--border);
    white-space: nowrap;
  }
  tbody tr { border-bottom: 1px solid var(--border); cursor: pointer; transition: background .1s; }
  tbody tr:last-child { border-bottom: none; }
  tbody tr:hover { background: #f5f7fc; }
  tbody tr.sel { background: var(--blue-bg); }
  tbody td { padding: 9px 12px; vertical-align: middle; }
  .sp-id { color: var(--blue); font-weight: 700; font-size: 14px; white-space: nowrap; }
  .plan-name-cell { font-size: 12px; color: var(--text-primary); font-weight: 500; max-width: 180px; }
  .plan-name-cell small { display: block; font-weight: 400; color: var(--text-muted); font-size: 11px; }
  .jp-link { color: var(--blue); font-size: 14px; font-weight: 600; }
  .num-col { text-align: center; color: var(--text-secondary); font-size: 12px; }
  .permit-tag {
    display: inline-block; padding: 2px 7px;
    background: var(--surface-3); border: 1px solid var(--border);
    border-radius: 20px; font-size: 10.5px; color: var(--text-secondary);
    white-space: nowrap;
  }
  .badge {
    display: inline-flex; align-items: center; gap: 4px;
    padding: 2px 9px; border-radius: 20px;
    font-size: 10.5px; font-weight: 600; white-space: nowrap;
  }
  .badge-dot { width: 5px; height: 5px; border-radius: 50%; background: currentColor; }
  .badge.active { background: var(--green-bg); color: var(--green); }
  .badge.draft  { background: var(--amber-bg); color: var(--amber); }

  /* ── Pagination ─────────────────────────────── */
  .pagination {
    display: flex; align-items: center; justify-content: space-between;
    padding: 10px 16px; border-top: 1px solid var(--border);
    background: var(--surface-2); flex-wrap: wrap; gap: 8px;
  }
  .pg-left { display: flex; align-items: center; gap: 8px; }
  .pg-select {
    border: 1px solid var(--border); border-radius: var(--radius-xs);
    padding: 4px 8px; font-size: 14px; font-family: var(--font);
    background: var(--surface); outline: none;
  }
  .pg-info { font-size: 11px; color: var(--text-muted); }
  .pg-pages { display: flex; align-items: center; gap: 4px; }
  .pg-btn {
    min-width: 26px; height: 26px; padding: 0 5px;
    display: flex; align-items: center; justify-content: center;
    border: 1px solid var(--border); border-radius: var(--radius-xs);
    background: var(--surface); font-size: 14px; cursor: pointer;
    color: var(--text-secondary); transition: all .15s; font-family: var(--font);
  }
  .pg-btn:hover, .pg-btn.active { background: var(--blue); color: #fff; border-color: var(--blue); }
  .pg-dots { font-size: 11px; color: var(--text-muted); }

  /* ── Hazard Assessment Panel ────────────────── */
  .hazard-panel .panel-hd { background: linear-gradient(135deg, #fff9f9 0%, #fff 100%); }
  .hazard-subtitle { font-size: 11px; color: var(--text-muted); margin-top: 1px; }
  .hazard-list { padding: 10px 14px; display: flex; flex-direction: column; gap: 8px; }
  .hazard-item {
    display: flex; align-items: flex-start; gap: 12px;
    padding: 11px 12px; border-radius: var(--radius-sm);
    border: 1px solid var(--border); background: var(--surface-2);
    transition: box-shadow .15s, transform .1s;
  }
  .hazard-item:hover { box-shadow: var(--shadow); transform: translateY(-1px); }
  .hazard-icon-wrap {
    width: 36px; height: 36px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 16px; flex-shrink: 0;
  }
  .hazard-body { flex: 1; min-width: 0; }
  .hazard-name { font-size: 13px; font-weight: 600; }
  .hazard-desc { font-size: 11px; color: var(--text-muted); margin-top: 2px; }
  .risk-badge {
    display: inline-flex; align-items: center; justify-content: center;
    padding: 3px 10px; border-radius: var(--radius-xs);
    font-size: 11px; font-weight: 700; flex-shrink: 0; min-width: 56px;
  }
  .risk-high   { background: var(--red-bg);   color: var(--red);   border: 1.5px solid #ffc5c5; }
  .risk-medium { background: var(--amber-bg); color: var(--amber); border: 1.5px solid #ffe0a0; }
  .risk-low    { background: var(--teal-bg);  color: var(--teal);  border: 1.5px solid #b0e9f0; }

  /* ── LOTO Procedure ─────────────────────────── */
  .loto-header {
    display: flex; align-items: center; gap: 10px;
    padding: 13px 16px 11px;
    border-bottom: 1px solid var(--border);
  }
  .loto-icon {
    width: 34px; height: 34px; border-radius: 50%;
    background: var(--amber-bg); display: flex; align-items: center;
    justify-content: center; flex-shrink: 0;
  }
  .loto-title { font-family: var(--font-head); font-size: 14px; font-weight: 700; }
  .loto-sub { font-size: 11px; color: var(--text-muted); margin-top: 1px; }
  .loto-steps { padding: 8px 0; }
  .loto-step {
    display: flex; align-items: center; gap: 12px;
    padding: 9px 16px;
    border-bottom: 1px solid var(--border);
    transition: background .1s;
  }
  .loto-step:last-child { border-bottom: none; }
  .loto-step:hover { background: var(--surface-2); }
  .step-num {
    width: 24px; height: 24px; border-radius: 50%;
    background: var(--surface-3); border: 1.5px solid var(--border-strong);
    display: flex; align-items: center; justify-content: center;
    font-size: 11px; font-weight: 700; color: var(--text-secondary);
    flex-shrink: 0;
  }
  .step-desc { flex: 1; font-size: 12.5px; font-weight: 500; }
  .step-role { font-size: 14px; color: var(--text-muted); text-align: right; white-space: nowrap; }
  .loto-footer {
    padding: 10px 16px;
    border-top: 1px solid var(--border);
    background: var(--surface-2);
    display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: 8px;
  }
  .loto-note { font-size: 11px; color: var(--text-muted); font-style: italic; }
  .loto-link {
    display: flex; align-items: center; gap: 5px;
    color: var(--blue); font-size: 12px; font-weight: 600;
    text-decoration: none; cursor: pointer;
    transition: gap .15s;
  }
  .loto-link:hover { gap: 8px; }

  /* ── Active Permits ──────────────────────────── */
  .permits-panel .panel-hd {
    display: flex; align-items: center; gap: 10px;
  }
  .permits-icon {
    width: 34px; height: 34px; border-radius: 50%;
    background: var(--blue-bg);
    display: flex; align-items: center; justify-content: center; flex-shrink: 0;
  }
  .permits-tbl-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .permits-tbl { width: 100%; border-collapse: collapse; font-size: 14px; }
  .permits-tbl thead th {
    padding: 7px 12px; text-align: left;
    font-size: 9.5px; font-weight: 700; color: var(--text-muted);
    text-transform: uppercase; letter-spacing: .5px;
    background: var(--surface-2); border-bottom: 1px solid var(--border);
    white-space: nowrap;
  }
  .permits-tbl tbody tr { border-bottom: 1px solid var(--border); transition: background .1s; }
  .permits-tbl tbody tr:last-child { border-bottom: none; }
  .permits-tbl tbody tr:hover { background: var(--surface-2); }
  .permits-tbl tbody td { padding: 8px 12px; vertical-align: middle; }
  .permit-no { font-size: 11px; color: var(--blue); font-weight: 600; white-space: nowrap; }
  .permit-type {
    display: inline-block; padding: 2px 7px;
    border-radius: 20px; font-size: 10px; font-weight: 600;
    background: #fff4e6; color: #c55e00; border: 1px solid #f5d2a8;
  }
  .permit-area { color: var(--text-secondary); font-size: 14px; max-width: 160px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .permit-expires { font-size: 11px; color: var(--text-muted); white-space: nowrap; }

  /* ── Responsive ──────────────────────────────── */
  @@media (max-width: 1100px) {
    .main-grid { grid-template-columns: 1fr; }
  }
  @@media (max-width: 820px) {
    .bottom-grid { grid-template-columns: 1fr; }
    .main-grid { padding: 12px 14px; }
    .bottom-grid { padding: 0 14px 16px; }
    .stats-bar { padding: 0 14px; }
    .page-header { padding: 12px 14px 14px; }
    .breadcrumb { padding: 8px 14px; }
    .header-actions { gap: 6px; }
    .btn { padding: 7px 11px; font-size: 14px; }
    .stat-card { min-width: 120px; padding: 12px 16px 12px 0; }
    .stat-value { font-size: 22px; }
  }
  @@media (max-width: 560px) {
    .stat-card { min-width: 100px; padding: 10px 12px 10px 0; }
    .stat-icon { width: 32px; height: 32px; font-size: 14px; }
    .stat-value { font-size: 18px; }
    .header-actions .btn-outline { display: none; }
    .bottom-grid, .main-grid { padding: 10px 10px; }
    .bottom-grid { padding-bottom: 14px; }
    .filter-bar { gap: 6px; }
    .filter-select { display: none; }
    .hazard-item { padding: 9px; }
  }
</style>


<!-- Breadcrumb -->
<nav class="breadcrumb">

  <a href="#">Planning &amp; Scheduling</a> <span>›</span>
  <span class="current">Safety Plans</span>
</nav>

<!-- Page Header -->
<header class="page-header">
  <div class="header-left">
    <button class="back-btn">
      <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path d="M15 18l-6-6 6-6"/></svg>
    </button>
    <div class="header-title">
      <h1>Safety Plans</h1>
      <p>Hazards, controls, LOTO procedures and permit linkage – attached to Job Plans</p>
    </div>
  </div>
  <div class="header-actions">
    <button class="btn btn-outline">
      <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
      Export
    </button>
    <button class="btn btn-outline">
      <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
      Edit Plan
    </button>
    <button class="btn btn-dark">
      <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
      New Safety Plan
    </button>
  </div>
</header>

<!-- Stats Bar -->
<div class="stats-bar">

    <div class="stat-icon" style="background:var(--green-bg);color:var(--green);">
      <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
    </div>
    <div class="stat-info">
      <div class="stat-label">Active Safety Plans</div>
      <div class="stat-value">56</div>
      <div class="stat-sub">all sites</div>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-icon" style="background:var(--orange-bg);color:var(--orange);">
      <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
    </div>
    <div class="stat-info">
      <div class="stat-label">Open Permits (PTW)</div>
      <div class="stat-value">11</div>
      <div class="stat-sub">today</div>

<script>
  const plans = [
    { id:'JP-1042', rev:'V4', name:'Quaterly VCB Maintenance – 11kV', cls:'Substation · Switchgear', task:12, lbr:12, mat:12, dur:'8h', status:'Draft' },
    { id:'JP-1062', rev:'V4', name:'Quaterly VCB Maintenance – 11kV', cls:'Substation · Switchgear', task:12, lbr:12, mat:12, dur:'8h', status:'Active' },
    { id:'JP-1073', rev:'V1', name:'DTR Oil Filtration & DGA Sampling', cls:'Distribution · Transformer', task:9,  lbr:9,  mat:9,  dur:'4h', status:'Active' },
    { id:'JP-1073', rev:'V4', name:'DTR Oil Filtration & DGA Sampling', cls:'Distribution · Transformer', task:9,  lbr:9,  mat:9,  dur:'4h', status:'Active' },
    { id:'JP-1071', rev:'V1', name:'DTR Oil Filtration & DGA Sampling', cls:'Distribution · Transformer', task:9,  lbr:9,  mat:9,  dur:'4h', status:'Active' },
    { id:'JP-1152', rev:'V3', name:'11kV Line Patrol & Tree Trimming', cls:'Distribution · LT',          task:3,  lbr:3,  mat:3,  dur:'8h', status:'Active' },
    { id:'JP-1120', rev:'V2', name:'SF6 CB Annual Service',             cls:'Substation · Switchgear',  task:7,  lbr:7,  mat:7,  dur:'10h', status:'Active' },
    { id:'JP-1420', rev:'V2', name:'SF6 CB Annual Service',             cls:'Substation · Switchgear',  task:7,  lbr:7,  mat:7,  dur:'10h', status:'Active' },
  ];

  function renderTable() {
    const tbody = document.getElementById('planTableBody');
    tbody.innerHTML = plans.map((p, i) => `
      <tr class="${i===0?'selected':''}" onclick="selectRow(this)">
        <td class="plan-id">${p.id}</td>
        <td><span class="rev-badge">${p.rev}</span></td>
        <td style="max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:12px">${p.name}</td>
        <td class="classification" style="max-width:130px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${p.cls}</td>
        <td class="num-cell">${p.task}</td>
        <td class="num-cell">${p.lbr}</td>
        <td class="num-cell">${p.mat}</td>
        <td class="num-cell">${p.dur}</td>
        <td><span class="status-badge ${p.status.toLowerCase()}"><span class="status-dot"></span>${p.status}</span></td>
      </tr>
    `).join('');
  }

  function selectRow(row) {
    document.querySelectorAll('#planTableBody tr').forEach(r => r.classList.remove('selected'));
    row.classList.add('selected');
  }

  // Page button interaction
  document.querySelectorAll('.page-btn').forEach(btn => {
    btn.addEventListener('click', function() {
      document.querySelectorAll('.page-btn').forEach(b => b.classList.remove('active'));
      this.classList.add('active');
    });
  });

  renderTable();
</script>

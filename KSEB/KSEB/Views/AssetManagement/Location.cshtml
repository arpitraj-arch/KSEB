            }

            .asset-id {
                color: #2563eb;
                font-weight: 500;
                text-decoration: none;
                font-size: 13px;
            }

                .asset-id:hover {
                    text-decoration: underline;
                }

            .description {
                font-weight: 600;
                color: #1a2332;
            }

            /* Status badges */
            .status-badge {
                display: inline-flex;
                align-items: center;
                padding: 3px 11px;
                border-radius: 5px;
                font-size: 12px;
                font-weight: 500;
                white-space: nowrap;
            }

            .s-operating {
                background: #f0fdf4;
                color: #16a34a;
                border: 1px solid #bbf7d0;
            }

            .s-planned {
                background: #f5f3ff;
                color: #7c3aed;
                border: 1px solid #ddd6fe;
            }

            /* Footer */
            .footer {
                padding: 13px 22px;
                border-top: 1px solid #e4e7ec;
                display: flex;
                align-items: center;
                justify-content: space-between;
                background: #fff;
                flex-shrink: 0;
            }

            .showing {

        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input class="att-search" type="text" placeholder="Search name, ID, job plan…" id="attSearch" oninput="filterAtt()">
      </div>
      <select class="mini-sel" id="basisSel" onchange="filterAtt()">
        <option value="">All Basis</option><option value="Full-time">Full-time</option><option value="Contract">Contract</option>
      </select>
      <select class="mini-sel" id="statusSel" onchange="filterAtt()">
        <option value="">All Status</option><option value="Present">Present</option><option value="Absent">Absent</option><option value="Late">Late</option>
      </select>
      <button class="filter-btn">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
        Filter
      </button>
    </div>
    <!-- x+y scrollable table wrapper -->
    <div class="att-tbl-wrap">
      <table class="att-table">
        <thead>
          <tr>
            <th>EMP ID</th>
            <th>Name</th>
            <th>Role</th>
            <th>Job Plan</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody id="attBody"></tbody>
      </table>
    </div>
  </div>

  <!-- ③ TODAY'S WORK ALLOCATION -->
  <div class="card">
    <div class="card-hdr">
      <div class="card-hdr-icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
      </div>
      <div>
        <div class="card-hdr-title">Today's Work Allocation</div>
        <div class="card-hdr-sub">WOs dispatched to crew &nbsp;·&nbsp; permit linkage</div>
      </div>
    </div>
    <div class="card-scroll" id="allocList"></div>
  </div>

  <!-- ④ SAFETY TOOLBOX TALK -->
  <div class="card">
    <div class="card-hdr">
      <div class="card-hdr-icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      </div>
      <div>
        <div class="card-hdr-title">Safety Toolbox Talk</div>
        <div class="card-hdr-sub">Tick topics covered today</div>
      </div>
    </div>
    <div class="card-scroll" id="safetyList"></div>
  </div>

</div><!-- /page-body -->

<script>
/* ══════════════════════════════════
   ① AGENDA
══════════════════════════════════ */
const agenda = [
  { time:'07:00', title:'Roll Call & Attendance',                  role:'AE / SO',         badge:'check' },
  { time:'07:05', title:'Previous Day Outage Review',              role:'Shift In-Charge',  badge:'live'  },
  { time:'07:18', title:"Today's Planned Work Orders (12)",        role:'Planner',          badge:'check' },
  { time:'07:30', title:'Safety Toolbox Talk – Working at Height', role:'Safety Officer',   badge:null    },
  { time:'07:45', title:'PTW Issued / LOTO Status',                role:'Permit Issuer',    badge:null    },
  { time:'07:52', title:'Previous Day Outage Review',              role:'Shift In-Charge',  badge:'live'  },
  { time:'08:00', title:'Safety Toolbox Talk – Working at Height', role:'Safety Officer',   badge:null    },
];
const chkSVG = `<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>`;
document.getElementById('agendaList').innerHTML = agenda.map(a => {
  const right = a.badge === 'live'
    ? `<span class="live-pill"><span class="live-dot"></span>Live</span>`
    : a.badge === 'check'
    ? `<div class="check-ic">${chkSVG}</div>`
    : '';
  return `<div class="agenda-item">
    <div class="ag-time">${a.time}</div>
    <div class="ag-body">
      <div class="ag-title">${a.title}</div>
      <div class="ag-role">${a.role}</div>
    </div>
    <div class="ag-right">${right}</div>
  </div>`;
}).join('');

/* ══════════════════════════════════
   ② ATTENDANCE
══════════════════════════════════ */
const emps = [
  { id:'EMP-4721', name:'Ravi Kumar',    role:'Crew-A Lead',     jp:'JP-1054', st:'Absent'  },
  { id:'EMP-5934', name:'Arjun Singh',   role:'Lineman Gr-I',    jp:'JP-1054', st:'Present' },
  { id:'EMP-6842', name:'Vikram Joshi',  role:'Crew-C Lead',     jp:'JP-1054', st:'Late'    },
  { id:'EMP-7529', name:'Nitin Sharma',  role:'Lineman Gr-II',   jp:'JP-1054', st:'Present' },
  { id:'EMP-8163', name:'Rajesh Gupta',  role:'Sr. Technician',  jp:'JP-1054', st:'Present' },
  { id:'EMP-9207', name:'Suresh Iyer',   role:'Helper',          jp:'JP-1054', st:'Present' },
  { id:'EMP-1045', name:'Manoj Desai',   role:'Driver',          jp:'JP-1054', st:'Absent'  },
  { id:'EMP-3312', name:'Priya Nair',    role:'Technician',      jp:'JP-1055', st:'Present' },
  { id:'EMP-4410', name:'Arun Menon',    role:'Lineman Gr-II',   jp:'JP-1055', st:'Late'    },
  { id:'EMP-5521', name:'Deepa S.',      role:'Sr. Technician',  jp:'JP-1055', st:'Present' },
];
const stMap = { Present:'st-present', Absent:'st-absent', Late:'st-late' };

function renderAtt(data) {
  document.getElementById('attBody').innerHTML = data.map(e => `
    <tr>
      <td><a class="emp-id-link" href="#">${e.id}</a></td>
      <td style="font-weight:500">${e.name}</td>
      <td style="color:var(--text3)">${e.role}</td>
      <td><a class="jp-link" href="#">${e.jp}</a></td>
      <td><span class="st-badge ${stMap[e.st]}">${e.st}</span></td>
    </tr>`).join('');
}
renderAtt(emps);

function filterAtt() {
  const q   = document.getElementById('attSearch').value.toLowerCase();
  const sts = document.getElementById('statusSel').value;
  renderAtt(emps.filter(e =>
    (!q  || e.id.toLowerCase().includes(q) || e.name.toLowerCase().includes(q) || e.jp.toLowerCase().includes(q)) &&
    (!sts || e.st === sts)
  ));
}

/* ══════════════════════════════════
   ③ WORK ALLOCATION
══════════════════════════════════ */
const allocs = [
  { wo:'WO-7623', crew:'Crew-D', ptw:'PTW-2212', desc:'Quarterly VCB Maint – Karamana SS',   pri:'High'   },
  { wo:'WO-4528', crew:'Crew-A', ptw:'PTW-2213', desc:'DTR Oil Filtration – Med College',     pri:'Medium' },
  { wo:'WO-6310', crew:'Crew-C', ptw:'PTW-2214', desc:'Cable Fault Repair – Palayam',         pri:'High'   },
  { wo:'WO-8745', crew:'Crew-D', ptw:'PTW-2215', desc:'Meter Calibration – Nemom',            pri:'Low'    },
  { wo:'WO-2197', crew:'Crew-E', ptw:'–',        desc:'Cable Fault Repair – Palayam',         pri:'Medium' },
  { wo:'WO-3381', crew:'Crew-B', ptw:'PTW-2216', desc:'11kV Patrol – Vanchiyoor',             pri:'Low'    },
];
const priMap = { High:'pri-high', Medium:'pri-medium', Low:'pri-low' };
const docSVG = `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>`;
const chevSVG = `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>`;
document.getElementById('allocList').innerHTML = allocs.map(a => `
  <div class="alloc-item">
    <div class="alloc-ic">${docSVG}</div>
    <div class="alloc-body">
      <div class="alloc-top">
        <span class="alloc-wo">${a.wo}</span>
        <span class="alloc-crew">${a.crew}</span>
      </div>
      <div class="alloc-desc">${a.desc}</div>
    </div>
    <div class="alloc-right">
      <span class="ptw-ref">${a.ptw}</span>
      <span class="pri-pill ${priMap[a.pri]}">${a.pri}</span>
      <button class="chev-btn">${chevSVG}</button>
    </div>
  </div>`).join('');

/* ══════════════════════════════════
   ④ SAFETY TOOLBOX
══════════════════════════════════ */
const topics = [
  { text:'Working at Height – Harness inspection',          done:true  },
  { text:'11kV Live-Line Clearance Distances',              done:true  },
  { text:'Quarterly VCB Maint – Karamana SS',               done:false },
  { text:'Lock Out Tag Out (LOTO) Procedure',               done:false },
  { text:'Personal Protective Equipment Usage',             done:false },
  { text:'Emergency Response & First Aid Basics',           done:false },
];
const cbSVG = `<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>`;
document.getElementById('safetyList').innerHTML = topics.map(t => `
  <div class="safety-item">
    <div class="s-cb ${t.done ? 'checked' : ''}" role="checkbox" aria-checked="${t.done}">${cbSVG}</div>
    <div class="s-text">${t.text}</div>
    <div class="s-act ${t.done ? 's-done' : 's-log'}">${t.done ? 'DONE' : 'Log'}</div>
  </div>`).join('');

document.getElementById('safetyList').addEventListener('click', e => {
  const item = e.target.closest('.safety-item');
  if (!item) return;
  const cb  = item.querySelector('.s-cb');
  const act = item.querySelector('.s-act');
  const done = cb.classList.toggle('checked');
  cb.setAttribute('aria-checked', String(done));
  act.textContent = done ? 'DONE' : 'Log';
  act.className   = 's-act ' + (done ? 's-done' : 's-log');
});
</script>

</div>

<!-- 2×2 CARD GRID -->
<div class="page-body">

  <!-- ① MEETING AGENDA -->
  <div class="card">
    <div class="card-hdr">
      <div class="card-hdr-icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
      </div>
      <div>
        <div class="card-hdr-title">Meeting Agenda</div>
        <div class="card-hdr-sub">07:00 – 08:00 &nbsp;·&nbsp; Section Office, Trivandrum East</div>
      </div>
    </div>
    <!-- scrollable agenda list -->
    <div class="card-scroll" id="agendaList"></div>
  </div>

  <!-- ② ATTENDANCE REGISTER -->
  <div class="card">
    <div class="card-hdr">
      <div class="card-hdr-icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>

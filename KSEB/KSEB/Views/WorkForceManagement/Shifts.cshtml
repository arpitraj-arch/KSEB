  <!-- Bottom 3-col -->
  <div class="btm-grid">

    <!-- Coverage Analysis -->
    <div class="panel">
      <div class="panel-hd">
        <span class="panel-hd-ico">📊</span>
        <div>
          <div class="panel-title">Coverage Analysis</div>
          <div class="panel-sub">Staffed vs required per shift · today</div>
        </div>
      </div>
      <div class="cov-list" id="covList"></div>
    </div>

    <!-- On-Call Schedule -->
    <div class="panel">
      <div class="panel-hd">
        <span class="panel-hd-ico">📞</span>
        <div>
          <div class="panel-title">On-Call Schedule</div>
          <div class="panel-sub">Emergency response rotation</div>
        </div>
      </div>
      <div class="oncall-list" id="oncallList"></div>
    </div>

    <!-- Shift Swap Request -->
    <div class="panel">
      <div class="panel-hd">
        <span class="panel-hd-ico">🔄</span>
        <div>
          <div class="panel-title">Shift Swap Request</div>
          <div class="panel-sub">Pending supervisor approval</div>
        </div>
      </div>
      <div class="swap-list" id="swapList"></div>
    </div>

  </div><!-- /btm-grid -->

</div><!-- /page -->

<script>
  /* ─ Data ─────────────────────── */
  const rosterData = [
    { name:'R.Nair',      id:'EMP – 2037', days:['MON','MON','MON','MON','MON','OFF','OFF'] },
    { name:'L.Kumar',     id:'EMP – 3158', days:['AFT','AFT','AFT','AFT','OFF','OFF','AFT'] },
    { name:'A.Singh',     id:'EMP – 4271', days:['NGT','NGT','NGT','OFF','OFF','NGT','NGT'] },
    { name:'M.Choudhury', id:'EMP – 5890', days:['GEN','GEN','GEN','GEN','GEN','OFF','OFF'] },
    { name:'V.Reddy',     id:'EMP – 6703', days:['MON','MON','OFF','OFF','MON','MON','MON'] },
  ];

  const covData = [
    { shift:'MOR', staffed:12, req:12, pct:100, cls:'cf-blue' },
    { shift:'MOR', staffed:12, req:12, pct:100, cls:'cf-red'  },
    { shift:'MOR', staffed:12, req:12, pct:100, cls:'cf-green'},
    { shift:'MOR', staffed:12, req:12, pct:100, cls:'cf-blue' },
    { shift:'MOR', staffed:12, req:12, pct:100, cls:'cf-red'  },
  ];

  const oncallData = Array(5).fill({
    name:'M. Joseph', role:'Sr. Technician',
    time:'21 May 18:00 – 22 May 08:00',
    phone:'+91 9546 ****'
  });

  const swapData = [
    { from:'K. Joseph', to:'P.Kumar', role:'Sr. Technician', time:'21 May 18:00 – 22 May 06:00', note:'*Personal*', status:'Pending' },
    { from:'K. Joseph', to:'P.Kumar', role:'Sr. Technician', time:'21 May 18:00 – 22 May 06:00', note:'*Personal*', status:'Approved' },
  ];

  const pillClass = { MON:'sp-mon', AFT:'sp-aft', NGT:'sp-ngt', GEN:'sp-gen', OFF:'sp-off' };

  /* ─ Render Roster ─ */
  document.getElementById('rosterBody').innerHTML = rosterData.map(e => `
    <tr>
      <td style="padding-left:14px;">
        <div class="emp-name">${e.name}</div>
        <div class="emp-id">${e.id}</div>
      </td>
      ${e.days.map(d => `<td><span class="shift-pill ${pillClass[d]}">${d}</span></td>`).join('')}
    </tr>
  `).join('');

  /* ─ Render Coverage ─ */
  document.getElementById('covList').innerHTML = covData.map(c => `
    <div class="cov-item">
      <div class="cov-top">
        <span class="cov-shift">${c.shift}</span>
        <span class="cov-count">${c.staffed} / ${c.req}, <span class="cov-pct">${c.pct}%</span></span>
      </div>
      <div class="cov-bar"><div class="cov-fill ${c.cls}" style="width:${c.pct}%"></div></div>
    </div>
  `).join('');

  /* ─ Render On-Call ─ */
  document.getElementById('oncallList').innerHTML = oncallData.map(o => `
    <div class="oncall-item">
      <div class="oc-avatar">PM</div>
      <div class="oc-body">
        <div class="oc-name">${o.name}</div>
        <div class="oc-role">${o.role}</div>
        <div class="oc-time">${o.time}</div>
        <div class="oc-phone">${o.phone}</div>
      </div>
      <span class="oc-badge">ON_CALL</span>
    </div>
  `).join('');

  /* ─ Render Swaps ─ */
  document.getElementById('swapList').innerHTML = swapData.map(s => `
    <div class="swap-item">
      <div class="swap-top">
        <div>
          <div class="swap-names">${s.from} → ${s.to}</div>
          <div class="swap-role">${s.role}</div>
        </div>
        <span class="swap-badge ${s.status==='Pending'?'sb-pending':'sb-approved'}">${s.status}</span>
      </div>
      <div class="swap-detail">${s.time}</div>
      <div class="swap-personal">${s.note}</div>
      <div class="swap-acts">
        <button class="act-btn ab-approve">Approve</button>
        <button class="act-btn ab-reject">Reject</button>
      </div>
    </div>
  `).join('');
</script>


<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Shifts – Workforce Management</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #f0f2f7;
    --surface: #fff;
    --surface-2: #f6f8fc;
    --surface-3: #edf0f6;
    --border: #e2e7f0;
    --border-strong: #c8d0e0;
    --text-1: #111827;
    --text-2: #374151;
    --text-3: #6b7280;
    --text-4: #9ca3af;
    /* shift colors */
    --gen: #e07b00;   --gen-bg: #fff7ed;  --gen-dark: #b45309;
    --mor: #d97706;   --mor-bg: #fffbeb;
    --aft: #e53e3e;   --aft-bg: #fff5f5;
    --ngt: #4338ca;   --ngt-bg: #eef2ff;
    --off-c: #6b7280; --off-bg: #f3f4f6;
    --blue: #1d4ed8;  --blue-bg: #eff6ff;
    --blue-2: #3b82f6;
    --green: #059669; --green-bg: #ecfdf5;
    --red: #dc2626;   --red-bg: #fef2f2;
    --orange: #d97706;--orange-bg: #fffbeb;
    --teal: #0891b2;  --teal-bg: #ecfeff;
    --amber: #92400e; --amber-bg: #fef3c7;
    --shadow-xs: 0 1px 2px rgba(0,0,0,.04);
    --shadow-sm: 0 2px 8px rgba(0,0,0,.07);
    --r: 10px; --r-sm: 6px; --r-xs: 4px;
    --font: 'Inter', sans-serif;
    --mono: 'JetBrains Mono', monospace;
  }
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: var(--font); background: var(--bg); color: var(--text-1); font-size: 13px; min-height: 100vh; }

  /* ─ Breadcrumb ─ */
  .crumb {
    background: var(--surface); border-bottom: 1px solid var(--border);
    padding: 8px 22px; font-size: 11.5px; color: var(--text-4);
    display: flex; align-items: center; gap: 6px; flex-wrap: wrap;
  }
  .crumb a { color: var(--text-4); text-decoration: none; }
  .crumb a:hover { color: var(--blue); }
  .crumb .cur { color: var(--text-2); font-weight: 600; }

  /* ─ Page Header ─ */
  .ph {
    background: var(--surface); border-bottom: 1px solid var(--border);
    padding: 13px 22px 15px;
    display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; flex-wrap: wrap;
  }
  .ph-l { display: flex; align-items: center; gap: 11px; }
  .back {
    width: 30px; height: 30px; border: 1.5px solid var(--border-strong);
    border-radius: var(--r-sm); background: transparent; cursor: pointer;
    display: flex; align-items: center; justify-content: center; color: var(--text-2);
    transition: all .15s; flex-shrink: 0;
  }
  .back:hover { border-color: var(--blue); color: var(--blue); }
  .ph-title h1 { font-size: 17px; font-weight: 800; letter-spacing: -.5px; }
  .ph-title p  { font-size: 11.5px; color: var(--text-4); margin-top: 2px; }
  .ph-acts { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .btn {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 7px 13px; border-radius: var(--r-sm);
    font-size: 12px; font-weight: 600; cursor: pointer; font-family: var(--font);
    transition: all .15s; white-space: nowrap; border: 1.5px solid transparent;
  }
  .btn-out  { background: var(--surface); border-color: var(--border-strong); color: var(--text-2); }
  .btn-out:hover { border-color: var(--blue); color: var(--blue); }
  .btn-dark { background: var(--text-1); color: #fff; }
  .btn-dark:hover { background: #1e2d4a; }

  /* ─ Stats Bar ─ */
  .stats {
    background: var(--surface); border-bottom: 1px solid var(--border);
    padding: 0 22px; display: flex; overflow-x: auto; -webkit-overflow-scrolling: touch;
  }
  .stat {
    display: flex; align-items: center; gap: 12px;
    padding: 13px 22px 13px 0; border-right: 1px solid var(--border); min-width: 148px;
  }
  .stat:first-child { padding-left: 0; }
  .stat:last-child  { border-right: none; }
  .st-ico { width: 34px; height: 34px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 15px; flex-shrink: 0; }
  .st-lbl { font-size: 9.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .7px; color: var(--text-4); }
  .st-val { font-size: 22px; font-weight: 800; letter-spacing: -1px; line-height: 1.1; margin-top: 2px; }
  .st-sub { font-size: 10.5px; color: var(--text-4); margin-top: 2px; }

  /* ─ Page Layout ─ */
  .page { padding: 14px 22px 22px; display: flex; flex-direction: column; gap: 14px; }

  /* ─ Panel ─ */
  .panel {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--r); overflow: hidden; box-shadow: var(--shadow-xs);
  }
  .panel-hd {
    padding: 11px 16px 10px; border-bottom: 1px solid var(--border);
    display: flex; align-items: flex-start; gap: 10px;
  }
  .panel-hd-ico { font-size: 14px; margin-top: 1px; flex-shrink: 0; }
  .panel-title { font-size: 13px; font-weight: 700; }
  .panel-sub   { font-size: 11px; color: var(--text-4); margin-top: 1px; }

  /* ─ Shift Pattern Cards ─ */
  .shift-cards {
    display: flex; gap: 10px; padding: 12px 16px; overflow-x: auto; -webkit-overflow-scrolling: touch;
  }
  .shift-card {
    min-width: 120px; border: 1.5px solid var(--border); border-radius: var(--r-sm);
    padding: 10px 12px; background: var(--surface-2); flex-shrink: 0;
  }
  .sc-badge {
    display: inline-block; padding: 2px 8px; border-radius: 3px;
    font-size: 9.5px; font-weight: 800; letter-spacing: .5px; margin-bottom: 6px;
  }
  .sc-icon { font-size: 20px; margin-bottom: 5px; display: block; }
  .sc-name { font-size: 13px; font-weight: 700; }
  .sc-time { font-size: 11px; color: var(--text-3); margin-top: 2px; font-family: var(--mono); }
  .sc-info { font-size: 10px; color: var(--text-4); margin-top: 6px; }

  /* shift type colours */
  .gen-card  { border-color: #fed7aa; background: #fff7ed; }
  .mor-card  { border-color: #fde68a; background: #fffbeb; }
  .aft-card  { border-color: #fca5a5; background: #fff5f5; }
  .ngt-card  { border-color: #a5b4fc; background: #eef2ff; }
  .off-card  { border-color: #e5e7eb; background: #f9fafb; }
  .sc-badge.gen { background: #fed7aa; color: #92400e; }
  .sc-badge.mor { background: #fde68a; color: #92400e; }
  .sc-badge.aft { background: #fca5a5; color: #991b1b; }
  .sc-badge.ngt { background: #a5b4fc; color: #3730a3; }
  .sc-badge.off { background: #e5e7eb; color: #374151; }

  /* ─ Weekly Roster ─ */
  .roster-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .roster-hd {
    padding: 10px 16px 9px; border-bottom: 1px solid var(--border);
    display: flex; align-items: flex-start; gap: 10px; justify-content: space-between; flex-wrap: wrap;
  }
  .roster-table { width: 100%; border-collapse: collapse; min-width: 640px; }
  .roster-table thead th {
    padding: 7px 8px; font-size: 10px; font-weight: 700; text-transform: uppercase;
    letter-spacing: .5px; color: var(--text-4); background: var(--surface-2);
    border-bottom: 1px solid var(--border); text-align: center; white-space: nowrap;
  }
  .roster-table thead th:first-child { text-align: left; min-width: 120px; }
  .roster-table tbody tr { border-bottom: 1px solid var(--border); }
  .roster-table tbody tr:last-child { border-bottom: none; }
  .roster-table tbody td { padding: 6px 5px; vertical-align: middle; text-align: center; }
  .roster-table tbody td:first-child { padding-left: 14px; text-align: left; }
  .emp-name { font-size: 12.5px; font-weight: 600; }
  .emp-id   { font-size: 11px; color: var(--text-4); font-family: var(--mono); }
  .shift-pill {
    display: inline-flex; align-items: center; justify-content: center;
    padding: 5px 0; width: 100%; max-width: 80px; border-radius: var(--r-xs);
    font-size: 11px; font-weight: 800; letter-spacing: .3px; cursor: pointer;
    transition: opacity .15s;
  }
  .shift-pill:hover { opacity: .85; }
  .sp-mon { background: var(--gen); color: #fff; }
  .sp-aft { background: var(--aft); color: #fff; }
  .sp-ngt { background: var(--ngt); color: #fff; }
  .sp-gen { background: #ca8a04; color: #fff; }
  .sp-off { background: var(--surface-3); color: var(--text-3); border: 1px solid var(--border-strong); }
  .roster-legend {
    padding: 9px 16px; border-top: 1px solid var(--border);
    background: var(--surface-2); font-size: 11px; color: var(--text-3);
    display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
  }
  .leg-item { display: flex; align-items: center; gap: 5px; }
  .leg-dot { width: 10px; height: 10px; border-radius: 2px; flex-shrink: 0; }

  /* ─ Bottom 3-col grid ─ */
  .btm-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 14px; }

  /* ─ Coverage Analysis ─ */
  .cov-list { padding: 10px 14px; display: flex; flex-direction: column; gap: 10px; }
  .cov-item { }
  .cov-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 5px; }
  .cov-shift { font-size: 12px; font-weight: 600; }
  .cov-count { font-family: var(--mono); font-size: 11px; color: var(--text-3); }
  .cov-pct   { font-size: 11px; font-weight: 700; color: var(--green); }
  .cov-bar   { height: 5px; background: var(--surface-3); border-radius: 10px; overflow: hidden; }
  .cov-fill  { height: 100%; border-radius: 10px; }
  .cf-red    { background: var(--red); }
  .cf-blue   { background: var(--blue-2); }
  .cf-green  { background: var(--green); }

  /* ─ On-Call Schedule ─ */
  .oncall-list { padding: 8px 0; }
  .oncall-item {
    display: flex; align-items: flex-start; gap: 10px;
    padding: 9px 14px; border-bottom: 1px solid var(--border);
    transition: background .1s;
  }
  .oncall-item:last-child { border-bottom: none; }
  .oncall-item:hover { background: var(--surface-2); }
  .oc-avatar {
    width: 32px; height: 32px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 12px; font-weight: 700; flex-shrink: 0;
    background: var(--blue-bg); color: var(--blue);
  }
  .oc-body { flex: 1; min-width: 0; }
  .oc-name { font-size: 12.5px; font-weight: 600; }
  .oc-role { font-size: 11px; color: var(--text-4); }
  .oc-time { font-size: 10.5px; color: var(--text-4); margin-top: 2px; font-family: var(--mono); }
  .oc-phone { font-size: 10.5px; color: var(--text-4); }
  .oc-badge {
    font-size: 10px; font-weight: 700; padding: 2px 8px; border-radius: 20px;
    background: var(--green-bg); color: var(--green); flex-shrink: 0; align-self: flex-start; margin-top: 2px;
    white-space: nowrap;
  }

  /* ─ Shift Swap Request ─ */
  .swap-list { padding: 8px 0; }
  .swap-item {
    padding: 10px 14px; border-bottom: 1px solid var(--border); transition: background .1s;
  }
  .swap-item:last-child { border-bottom: none; }
  .swap-item:hover { background: var(--surface-2); }
  .swap-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 8px; margin-bottom: 4px; }
  .swap-names { font-size: 12.5px; font-weight: 600; }
  .swap-role  { font-size: 11px; color: var(--text-4); }
  .swap-detail { font-size: 11px; color: var(--text-3); margin: 3px 0 7px; font-family: var(--mono); }
  .swap-personal { font-size: 10.5px; color: var(--text-4); margin-bottom: 8px; }
  .swap-acts { display: flex; gap: 6px; }
  .swap-badge {
    font-size: 10px; font-weight: 700; padding: 2px 9px; border-radius: 20px;
    flex-shrink: 0; align-self: flex-start;
  }
  .sb-pending  { background: var(--amber-bg); color: var(--amber); }
  .sb-approved { background: var(--green-bg); color: var(--green); }
  .act-btn {
    padding: 5px 14px; border-radius: var(--r-xs); font-size: 11.5px; font-weight: 600;
    cursor: pointer; font-family: var(--font); transition: all .15s;
    border: 1.5px solid transparent;
  }
  .ab-approve { background: var(--blue-bg); color: var(--blue); border-color: #bfdbfe; }
  .ab-approve:hover { background: var(--blue); color: #fff; }
  .ab-reject  { background: var(--surface); color: var(--text-3); border-color: var(--border-strong); }
  .ab-reject:hover  { background: var(--red-bg); color: var(--red); border-color: #fca5a5; }

  /* ─ Responsive ─ */
  @@media (max-width: 1000px) {
    .btm-grid { grid-template-columns: 1fr 1fr; }
  }
  @@media (max-width: 720px) {
    .btm-grid { grid-template-columns: 1fr; }
    .page, .stats { padding-left: 14px; padding-right: 14px; }
    .ph, .crumb { padding-left: 14px; padding-right: 14px; }
    .page { padding-top: 12px; padding-bottom: 16px; }
  }
  @@media (max-width: 480px) {
    .stat { min-width: 120px; padding-right: 14px; }
    .st-val { font-size: 19px; }
    .ph-acts .btn-out { display: none; }
  }
</style>


<!-- Breadcrumb -->
<nav class="crumb">
  <a href="#">Home</a> <span>›</span>
  <a href="#">Workforce Management</a> <span>›</span>
  <span class="cur">Shifts</span>
</nav>

<!-- Page Header -->
<header class="ph">
  <div class="ph-l">
    <button class="back">
      <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path d="M15 18l-6-6 6-6"/></svg>
    </button>
    <div class="ph-title">
      <h1>Shifts</h1>
      <p>24x7 shift patterns · weekly roster · coverage analysis · on-call &amp; swap management</p>
    </div>
  </div>
  <div class="ph-acts">
    <button class="btn btn-out">
      <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
      Auto-Roster
    </button>
    <button class="btn btn-out">
      <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
      Export
    </button>
    <button class="btn btn-dark">
      <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
      Publish roster
    </button>
  </div>
</header>

<!-- Stats Bar -->
<div class="stats">
  <div class="stat">
    <div class="st-ico" style="background:var(--green-bg);color:var(--green);">
      <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
    </div>
    <div>
      <div class="st-lbl">Shift Patterns</div>
      <div class="st-val">5</div>
      <div class="st-sub">defined</div>
    </div>
  </div>
  <div class="stat">
    <div class="st-ico" style="background:var(--blue-bg);color:var(--blue);">
      <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
    </div>
    <div>
      <div class="st-lbl">On Duty Now</div>
      <div class="st-val">27</div>
      <div class="st-sub">across shifts</div>
    </div>
  </div>
  <div class="stat">
    <div class="st-ico" style="background:var(--green-bg);color:var(--green);">
      <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
    </div>
    <div>
      <div class="st-lbl">Coverage</div>
      <div class="st-val">93<span style="font-size:15px;font-weight:700">%</span></div>
      <div class="st-sub">this week</div>
    </div>
  </div>
  <div class="stat">
    <div class="st-ico" style="background:var(--orange-bg);color:var(--orange);">
      <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
    </div>
    <div>
      <div class="st-lbl">Gaps</div>
      <div class="st-val">3</div>
      <div class="st-sub">NGT short</div>
    </div>
  </div>
  <div class="stat">
    <div class="st-ico" style="background:var(--teal-bg);color:var(--teal);">
      <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
    </div>
    <div>
      <div class="st-lbl">Pending Swaps</div>
      <div class="st-val">1</div>
      <div class="st-sub">awaiting approval</div>
    </div>
  </div>
</div>

<!-- Page -->
<div class="page">

  <!-- Shift Patterns -->
  <div class="panel">
    <div class="panel-hd">
      <span class="panel-hd-ico">🕐</span>
      <div>
        <div class="panel-title">Shift Patterns</div>
        <div class="panel-sub">Standard time blocks used in roster scheduling</div>
      </div>
    </div>
    <div class="shift-cards">
      <div class="shift-card gen-card">
        <span class="sc-badge gen">GEN</span>
        <span class="sc-icon">☀️</span>
        <div class="sc-name">General</div>
        <div class="sc-time">09:00 – 17:30</div>
        <div class="sc-info">8h shift &nbsp;·&nbsp; 30min break</div>
      </div>
      <div class="shift-card mor-card">
        <span class="sc-badge mor">MOR</span>
        <span class="sc-icon">🌅</span>
        <div class="sc-name">Morning</div>
        <div class="sc-time">09:00 – 17:30</div>
        <div class="sc-info">8h shift &nbsp;·&nbsp; 30min break</div>
      </div>
      <div class="shift-card aft-card">
        <span class="sc-badge aft">AFT</span>
        <span class="sc-icon">🌤️</span>
        <div class="sc-name">Afternoon</div>
        <div class="sc-time">09:00 – 17:30</div>
        <div class="sc-info">8h shift &nbsp;·&nbsp; 30min break</div>
      </div>
      <div class="shift-card ngt-card">
        <span class="sc-badge ngt">NGT</span>
        <span class="sc-icon">🌙</span>
        <div class="sc-name">Night</div>
        <div class="sc-time">09:00 – 17:30</div>
        <div class="sc-info">8h shift &nbsp;·&nbsp; 30min break</div>
      </div>
      <div class="shift-card off-card">
        <span class="sc-badge off">OFF</span>
        <span class="sc-icon">🗓️</span>
        <div class="sc-name">Weekly Off</div>
        <div class="sc-time">–</div>
        <div class="sc-info">8h shift &nbsp;·&nbsp; 30min break</div>
      </div>
    </div>
  </div>

  <!-- Weekly Roster -->
  <div class="panel">
    <div class="roster-hd">
      <div style="display:flex;align-items:flex-start;gap:9px;">
        <span style="font-size:14px;margin-top:1px;">📅</span>
        <div>
          <div class="panel-title">Weekly Roster</div>
          <div class="panel-sub">Drag a cell to change assignment · week 21 · 18–24 May 2026</div>
        </div>
      </div>
    </div>
    <div class="roster-wrap">
      <table class="roster-table">
        <thead>
          <tr>
            <th>Employee</th>
            <th>MON</th><th>TUE</th><th>WED</th><th>THU</th><th>FRI</th><th>SAT</th><th>SUN</th>
          </tr>
        </thead>
        <tbody id="rosterBody"></tbody>
      </table>
    </div>
    <div class="roster-legend">
      <span>Legend:</span>
      <span class="leg-item"><span class="leg-dot" style="background:#ca8a04"></span>GEN · General</span>
      <span class="leg-item"><span class="leg-dot" style="background:var(--gen)"></span>MOR · Morning</span>
      <span class="leg-item"><span class="leg-dot" style="background:var(--aft)"></span>Aft · Afternoon</span>
      <span class="leg-item"><span class="leg-dot" style="background:var(--ngt)"></span>NGT · Night</span>
      <span class="leg-item"><span class="leg-dot" style="background:var(--surface-3);border:1px solid var(--border-strong)"></span>OFF · Weekly Off</span>

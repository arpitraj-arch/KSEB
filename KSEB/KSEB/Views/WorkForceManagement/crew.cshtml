<script>
/* ── Star rating helper ── */
function stars(rating) {
  /* rating 1-5, supports halves */
  var full  = Math.floor(rating);
  var half  = (rating - full) >= 0.5 ? 1 : 0;
  var empty = 5 - full - half;
  var html  = '<span class="stars">';
  for (var i=0;i<full;i++)  html += '<i class="ti ti-star-filled star-full"></i>';
  if (half)                  html += '<i class="ti ti-star-half-filled star-half"></i>';
  for (var j=0;j<empty;j++) html += '<i class="ti ti-star star-empty"></i>';
  html += '</span>';
  return html;
}

/* ── Skill data ── */
var skillData = [
  { crew:'CREW-A', lt:3,   ht:3.5, vcb:3.5, dtr:3.5, cable:3.5 },
  { crew:'CREW-D', lt:3,   ht:3,   vcb:3,   dtr:3.5, cable:3.5 },
  { crew:'CREW-C', lt:3,   ht:3,   vcb:3.5, dtr:3,   cable:3   },
  { crew:'CREW-B', lt:3,   ht:3,   vcb:3,   dtr:3.5, cable:3   },
  { crew:'CREW-E', lt:3,   ht:3,   vcb:3,   dtr:3.5, cable:3   },
  { crew:'CREW-C', lt:3,   ht:3,   vcb:3,   dtr:3,   cable:2.5 },
  { crew:'CREW-A', lt:2.5, ht:3,   vcb:3,   dtr:3,   cable:2.5 },
  { crew:'CREW-B', lt:2.5, ht:2.5, vcb:2.5, dtr:3,   cable:2.5 },
];

var tbody = document.getElementById('skillTblBody');
skillData.forEach(function(r) {
  var tr = document.createElement('tr');
  tr.innerHTML =
    '<td class="td-crew">' + r.crew + '</td>' +
    '<td>' + stars(r.lt)    + '</td>' +
    '<td>' + stars(r.ht)    + '</td>' +
    '<td>' + stars(r.vcb)   + '</td>' +
    '<td>' + stars(r.dtr)   + '</td>' +
    '<td>' + stars(r.cable) + '</td>';
  tbody.appendChild(tr);
});

/* ── Pagination clicks ── */
document.querySelectorAll('.pg-btn').forEach(function(btn) {
  btn.addEventListener('click', function() {
    if (this.querySelector('i')) return;
    var wrap = this.closest('.pg-btns');
    wrap.querySelectorAll('.pg-btn').forEach(function(b){ b.classList.remove('active'); });
    this.classList.add('active');
  });
});
</script>

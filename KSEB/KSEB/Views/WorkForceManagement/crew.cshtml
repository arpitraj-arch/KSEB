<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Crews – Workforce Management</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@latest/tabler-icons.min.css" />
<style>
/* ══════════════════════════════════════════
   RESET & BASE
══════════════════════════════════════════ */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { font-size: 13px; }
body {
  font-family: 'Inter', -apple-system, sans-serif;
  background: #f4f5f7;
  color: #111827;
  min-height: 100vh;
  line-height: 1.5;
}
button, input, select { font-family: inherit; font-size: inherit; cursor: pointer; }
button { border: none; background: none; outline: none; }
a { text-decoration: none; color: inherit; }

/* ══════════════════════════════════════════
   BREADCRUMB
══════════════════════════════════════════ */
.breadcrumb {
  background: #fff;
  border-bottom: 1px solid #e5e7eb;
  padding: 0 20px;
  height: 38px;
  display: flex; align-items: center; gap: 5px;
  font-size: 11.5px; color: #6b7280;
  position: sticky; top: 0; z-index: 300;
}
.breadcrumb a { color: #6b7280; }
.breadcrumb a:hover { color: #2563eb; }
.breadcrumb .sep { color: #d1d5db; }
.breadcrumb .cur { color: #111827; font-weight: 600; }

/* ══════════════════════════════════════════
   PAGE WRAPPER
══════════════════════════════════════════ */
.page-wrap { max-width: 1400px; margin: 0 auto; padding-bottom: 40px; }

/* ══════════════════════════════════════════
   TOP WHITE SECTION
══════════════════════════════════════════ */
.top-section {
  background: #fff;
  border-bottom: 1px solid #e5e7eb;
  padding: 14px 20px 0;
}

/* Page header */
.page-hdr {
  display: flex; align-items: flex-start;
  justify-content: space-between;
  gap: 12px; flex-wrap: wrap;
  margin-bottom: 14px;
}
.page-hdr-left { display: flex; align-items: flex-start; gap: 10px; }
.back-btn {
  width: 30px; height: 30px; border-radius: 50%;
  border: 1px solid #e5e7eb;
  display: flex; align-items: center; justify-content: center;
  color: #6b7280; flex-shrink: 0; margin-top: 3px;
  transition: border-color .15s, color .15s;
}
.back-btn:hover { border-color: #2563eb; color: #2563eb; }
.back-btn i { font-size: 14px; }

.page-hdr-title h1 { font-size: 18px; font-weight: 700; color: #111827; letter-spacing: -.02em; line-height: 1.2; }
.page-hdr-title p  { font-size: 11.5px; color: #9ca3af; margin-top: 2px; }

.hdr-btns { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.icon-btn {
  width: 32px; height: 32px; border-radius: 8px;
  border: 1px solid #e5e7eb;
  display: flex; align-items: center; justify-content: center;
  color: #6b7280; background: #fff;
  transition: border-color .15s, color .15s;
}
.icon-btn:hover { border-color: #2563eb; color: #2563eb; }
.icon-btn i { font-size: 15px; }

.export-btn {
  display: inline-flex; align-items: center; gap: 5px;
  border: 1px solid #e5e7eb; border-radius: 8px;
  padding: 7px 13px; font-size: 12px; font-weight: 500;
  color: #374151; background: #fff;
  transition: border-color .15s;
}
.export-btn:hover { border-color: #2563eb; color: #2563eb; }
.export-btn i { font-size: 14px; }

.close-meeting-btn {
  display: inline-flex; align-items: center; gap: 6px;
  background: #111827; color: #fff;
  border: none; border-radius: 8px;
  padding: 8px 16px; font-size: 12px; font-weight: 600;
  white-space: nowrap; transition: background .15s;
}
.close-meeting-btn:hover { background: #1f2937; }
.close-meeting-btn i { font-size: 14px; }

/* Stats row */
.stats-row {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  border-top: 1px solid #f3f4f6;
}
@@media (max-width: 900px) { .stats-row { grid-template-columns: repeat(3, 1fr); } }
@@media (max-width: 560px) { .stats-row { grid-template-columns: repeat(2, 1fr); } }

.stat-cell {
  padding: 10px 16px 14px;
  border-right: 1px solid #f3f4f6;
}
.stat-cell:last-child { border-right: none; }
.stat-top {
  display: flex; align-items: center; gap: 7px; margin-bottom: 4px;
}
.stat-icon {
  width: 26px; height: 26px; border-radius: 6px;
  display: flex; align-items: center; justify-content: center;
  font-size: 14px; flex-shrink: 0;
}
.si-blue   { background: #eff6ff; color: #2563eb; }
.si-orange { background: #fff7ed; color: #ea580c; }
.si-green2 { background: #ecfdf5; color: #10b981; }
.si-yellow { background: #fefce8; color: #ca8a04; }
.si-red    { background: #fef2f2; color: #dc2626; }
.si-green  { background: #f0fdf4; color: #16a34a; }

.stat-label {
  font-size: 9.5px; font-weight: 700;
  text-transform: uppercase; letter-spacing: .07em; color: #9ca3af;
}
.stat-value {
  font-size: 26px; font-weight: 800; color: #111827;
  line-height: 1; letter-spacing: -.02em;
}
.stat-value .unit { font-size: 18px; font-weight: 700; }
.stat-sub { font-size: 11.5px; color: #6b7280; margin-top: 2px; }

/* ══════════════════════════════════════════
   CONTENT AREA
══════════════════════════════════════════ */
.content-area { padding: 14px 16px 0; }

/* ══════════════════════════════════════════
   CREW ROSTER CARD
══════════════════════════════════════════ */
.roster-card {
  background: #fff;
  border: 1px solid #e5e7eb;
  border-radius: 12px;
  overflow: hidden;
  margin-bottom: 14px;
  box-shadow: 0 1px 3px rgba(0,0,0,.05);
}
.roster-hdr {
  padding: 11px 16px 9px;
  border-bottom: 1px solid #f3f4f6;
  background: #fafafa;
}
.roster-hdr h2 { font-size: 13px; font-weight: 700; color: #111827; display: flex; align-items: center; gap: 7px; }
.roster-hdr h2 i { font-size: 15px; color: #2563eb; }
.roster-hdr p { font-size: 11px; color: #9ca3af; margin-top: 1px; }

/* Crew row */
.crew-row {
  display: flex; align-items: flex-start;
  padding: 13px 16px;
  border-bottom: 1px solid #f3f4f6;
  gap: 14px; flex-wrap: wrap;
  cursor: pointer;
  transition: background .1s;
}
.crew-row:last-child { border-bottom: none; }
.crew-row:hover { background: #f9fafb; }

.crew-avatar {
  width: 34px; height: 34px; border-radius: 8px;
  display: flex; align-items: center; justify-content: center;
  font-size: 13px; font-weight: 700;
  flex-shrink: 0; color: #fff; margin-top: 2px;
}
.av-blue   { background: #3b82f6; }
.av-purple { background: #8b5cf6; }
.av-amber  { background: #f59e0b; }
.av-green  { background: #10b981; }
.av-red    { background: #ef4444; }

.crew-info { flex: 1; min-width: 0; }
.crew-info-top {
  display: flex; align-items: center; gap: 10px;
  flex-wrap: wrap; margin-bottom: 5px;
}
.crew-name { font-size: 14px; font-weight: 600; color: #111827; }

/* Status badges */
.crew-badge {
  display: inline-block;
  border-radius: 20px; font-size: 11px; font-weight: 600;
  padding: 2px 10px; white-space: nowrap;
  border: 1px solid transparent;
}
.cb-available    { background: #f0fdf4; color: #15803d; border-color: #bbf7d0; }
.cb-maintenance  { background: #fff7ed; color: #c2410c; border-color: #fed7aa; }
.cb-delayed      { background: #fef2f2; color: #b91c1c; border-color: #fecaca; }
.cb-intransit    { background: #eff6ff; color: #1d4ed8; border-color: #bfdbfe; }

.crew-meta {
  display: flex; align-items: center; gap: 14px;
  flex-wrap: wrap; font-size: 11.5px; color: #6b7280;
}
.crew-meta span { display: flex; align-items: center; gap: 4px; }
.crew-meta i { font-size: 13px; flex-shrink: 0; }

.crew-row-right { display: flex; align-items: flex-start; flex-shrink: 0; }
.view-details-link {
  font-size: 12px; font-weight: 600; color: #2563eb;
  white-space: nowrap; display: flex; align-items: center; gap: 3px;
  transition: color .12s;
}
.view-details-link:hover { color: #1d4ed8; }

/* Roster footer */
.roster-footer {
  display: flex; align-items: center; justify-content: space-between;
  flex-wrap: wrap; gap: 8px;
  padding: 10px 16px;
  border-top: 1px solid #f3f4f6;
  font-size: 11.5px; color: #6b7280;
  background: #fafafa;
}
.roster-footer-l { display: flex; align-items: center; gap: 7px; }
.per-page {
  border: 1px solid #e5e7eb; border-radius: 5px;
  padding: 3px 6px; font-size: 11.5px;
  color: #374151; background: #fff; outline: none;
}
.pg-btns { display: flex; align-items: center; gap: 3px; }
.pg-btn {
  min-width: 26px; height: 26px; border-radius: 5px;
  border: 1px solid #e5e7eb;
  font-size: 11.5px; font-weight: 500; color: #6b7280;
  background: #fff;
  display: inline-flex; align-items: center; justify-content: center;
  padding: 0 5px;
  transition: all .12s;
}
.pg-btn:hover { border-color: #2563eb; color: #2563eb; }
.pg-btn.active { background: #2563eb; border-color: #2563eb; color: #fff; }
.pg-btn i { font-size: 12px; }

/* ══════════════════════════════════════════
   BOTTOM GRID  (Craft + Skills)
══════════════════════════════════════════ */
.bottom-grid {
  display: grid;
  grid-template-columns: 280px 1fr;
  gap: 14px;
  margin-bottom: 14px;
}
@@media (max-width: 820px) { .bottom-grid { grid-template-columns: 1fr; } }

/* ── Craft Composition ── */
.craft-card {
  background: #fff;
  border: 1px solid #e5e7eb;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 1px 3px rgba(0,0,0,.05);
}
.card-hdr {
  display: flex; align-items: center; justify-content: space-between;
  padding: 11px 14px;
  border-bottom: 1px solid #f3f4f6;
  background: #fafafa;
}
.card-hdr-left h3 { font-size: 13px; font-weight: 700; color: #111827; display: flex; align-items: center; gap: 6px; }
.card-hdr-left h3 i { font-size: 14px; color: #2563eb; }
.card-hdr-left p  { font-size: 11px; color: #9ca3af; }
.more-link { font-size: 11px; font-weight: 600; color: #2563eb; }

.craft-body { padding: 12px 14px; }
.craft-item { margin-bottom: 12px; }
.craft-item:last-child { margin-bottom: 0; }
.craft-item-top {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 5px;
}
.craft-name { font-size: 12px; font-weight: 500; color: #374151; }
.craft-stats { display: flex; gap: 10px; font-size: 11.5px; color: #6b7280; }
.craft-stats .pct { font-weight: 600; color: #374151; }
.bar-track {
  height: 6px; background: #f3f4f6; border-radius: 99px; overflow: hidden;
}
.bar-fill {
  height: 100%; border-radius: 99px;
  transition: width .5s ease;
}
.bar-green  { background: #22c55e; }
.bar-red    { background: #ef4444; }
.bar-amber  { background: #f59e0b; }

/* ── Skill Coverage Matrix ── */
.skills-card {
  background: #fff;
  border: 1px solid #e5e7eb;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 1px 3px rgba(0,0,0,.05);
}
.skills-body { padding: 0; overflow-x: auto; }
.skills-body::-webkit-scrollbar { height: 4px; }
.skills-body::-webkit-scrollbar-thumb { background: #e5e7eb; border-radius: 8px; }

table.skill-tbl {
  width: 100%; border-collapse: collapse; font-size: 12px; min-width: 460px;
}
table.skill-tbl thead th {
  position: sticky; top: 0; z-index: 1;
  background: #f9fafb;
  color: #9ca3af; font-size: 9.5px; font-weight: 700;
  text-transform: uppercase; letter-spacing: .07em;
  padding: 9px 14px; text-align: left;
  border-bottom: 1px solid #e5e7eb; white-space: nowrap;
}
table.skill-tbl thead th:first-child { color: #374151; }
table.skill-tbl tbody tr { border-bottom: 1px solid #f3f4f6; transition: background .1s; }
table.skill-tbl tbody tr:last-child { border-bottom: none; }
table.skill-tbl tbody tr:hover { background: #f9fafb; }
table.skill-tbl tbody td { padding: 9px 14px; vertical-align: middle; }
.td-crew { font-size: 12px; font-weight: 600; color: #111827; }

/* Star rating */
.stars { display: inline-flex; align-items: center; gap: 1px; }
.star-full  { color: #f59e0b; font-size: 14px; }
.star-half  { color: #f59e0b; font-size: 14px; opacity: .5; }
.star-empty { color: #e5e7eb; font-size: 14px; }

/* ══════════════════════════════════════════
   RESPONSIVE
══════════════════════════════════════════ */
@@media (max-width: 600px) {
  .page-hdr { flex-direction: column; }
  .hdr-btns { width: 100%; }
  .close-meeting-btn { flex: 1; justify-content: center; }
  .content-area { padding: 10px 10px 0; }
  .stat-value { font-size: 20px; }
  .crew-meta { gap: 8px; }
}
@@media (max-width: 400px) {
  .stats-row { grid-template-columns: 1fr 1fr; }
}
</style>



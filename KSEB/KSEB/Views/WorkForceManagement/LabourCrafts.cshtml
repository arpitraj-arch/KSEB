<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Labor & Crafts – Workforce Management</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #f0f2f7;
    --surface: #fff;
    --surface-2: #f7f8fc;
    --surface-3: #edf0f7;
    --border: #e2e7f0;
    --border-strong: #c8d0e0;
    --text-1: #111827;
    --text-2: #374151;
    --text-3: #6b7280;
    --text-4: #9ca3af;
    --blue: #1d4ed8;
    --blue-2: #3b82f6;
    --blue-bg: #eff6ff;
    --green: #059669;
    --green-bg: #ecfdf5;
    --red: #dc2626;
    --red-bg: #fef2f2;
    --orange: #d97706;
    --orange-bg: #fffbeb;
    --teal: #0891b2;
    --teal-bg: #ecfeff;
    --purple: #7c3aed;
    --purple-bg: #f5f3ff;
    --amber: #b45309;
    --amber-bg: #fef3c7;
    --shadow-xs: 0 1px 2px rgba(0,0,0,.04);
    --shadow-sm: 0 2px 8px rgba(0,0,0,.07);
    --r: 10px; --r-sm: 6px; --r-xs: 4px;
    --font: 'Inter', sans-serif;
    --mono: 'JetBrains Mono', monospace;
  }
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: var(--font); background: var(--bg); color: var(--text-1); font-size: 13px; min-height: 100vh; }

  /* Breadcrumb */
  .crumb {
    background: var(--surface); border-bottom: 1px solid var(--border);
    padding: 8px 22px; font-size: 11.5px; color: var(--text-4);
    display: flex; align-items: center; gap: 6px; flex-wrap: wrap;
  }
  .crumb a { color: var(--text-4); text-decoration: none; }
  .crumb a:hover { color: var(--blue); }
  .crumb .cur { color: var(--text-2); font-weight: 600; }

  /* Page Header */
  .ph {
    background: var(--surface); border-bottom: 1px solid var(--border);
    padding: 13px 22px 15px;
    display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; flex-wrap: wrap;
  }
  .ph-l { display: flex; align-items: center; gap: 11px; }
  .back {
    width: 30px; height: 30px; border: 1.5px solid var(--border-strong);
    border-radius: var(--r-sm); background: transparent; cursor: pointer;
    display: flex; align-items: center; justify-content: center; color: var(--text-2);
    transition: all .15s; flex-shrink: 0;
  }
  .back:hover { border-color: var(--blue); color: var(--blue); }
  .ph-title h1 { font-size: 17px; font-weight: 800; letter-spacing: -.5px; }
  .ph-title p { font-size: 11.5px; color: var(--text-4); margin-top: 2px; }
  .ph-acts { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .btn {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 8px 14px; border-radius: var(--r-sm);
    font-size: 12.5px; font-weight: 600; cursor: pointer; font-family: var(--font);
    transition: all .15s; white-space: nowrap; border: 1.5px solid transparent;
  }
  .btn-out { background: var(--surface); border-color: var(--border-strong); color: var(--text-2); }
  .btn-out:hover { border-color: var(--blue); color: var(--blue); }
  .btn-dark { background: var(--text-1); color: #fff; }
  .btn-dark:hover { background: #1e2d4a; }

  /* Stats Bar */
  .stats {
    background: var(--surface); border-bottom: 1px solid var(--border);
    padding: 0 22px; display: flex; overflow-x: auto; -webkit-overflow-scrolling: touch;
  }
  .stat {
    display: flex; align-items: center; gap: 12px;
    padding: 14px 22px 14px 0; border-right: 1px solid var(--border); min-width: 155px;
  }
  .stat:first-child { padding-left: 0; }
  .stat:last-child { border-right: none; }
  .st-ico { width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 17px; flex-shrink: 0; }
  .st-lbl { font-size: 9.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .7px; color: var(--text-4); }
  .st-val { font-size: 24px; font-weight: 800; letter-spacing: -1px; line-height: 1.1; margin-top: 2px; }
  .st-sub { font-size: 10.5px; color: var(--text-4); margin-top: 2px; }

  /* Search Row */
  .search-row {
    padding: 12px 22px 10px;
    display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
  }
  .srch-wrap { flex: 1; min-width: 200px; position: relative; max-width: 480px; }
  .srch-wrap svg { position: absolute; left: 10px; top: 50%; transform: translateY(-50%); color: var(--text-4); pointer-events: none; }
  .srch {
    width: 100%; border: 1px solid var(--border); border-radius: var(--r-sm);
    padding: 8px 10px 8px 32px; font-size: 12.5px; font-family: var(--font);
    background: var(--surface); color: var(--text-1); outline: none; transition: border-color .15s;
    box-shadow: var(--shadow-xs);
  }
  .srch:focus { border-color: var(--blue-2); }
  .srch::placeholder { color: var(--text-4); }
  .sr-btns { display: flex; align-items: center; gap: 8px; margin-left: auto; }
  .flt-btn, .rst-btn {
    display: flex; align-items: center; gap: 5px;
    border: 1px solid var(--border-strong); border-radius: var(--r-sm);
    padding: 7px 13px; font-size: 12px; font-weight: 500; font-family: var(--font);
    background: var(--surface); cursor: pointer; transition: all .15s; color: var(--text-2);
  }
  .flt-btn:hover { border-color: var(--blue); color: var(--blue); }
  .rst-btn:hover { border-color: var(--orange); color: var(--orange); }

  /* Main content layout */
  .content { padding: 0 22px 22px; display: flex; flex-direction: column; gap: 14px; }

  /* Panel */
  .panel {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--r); overflow: hidden; box-shadow: var(--shadow-xs);
  }
  .panel-hd {
    padding: 11px 16px 10px; border-bottom: 1px solid var(--border);
    display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap;
  }
  .panel-hd-l { display: flex; align-items: center; gap: 9px; }
  .panel-title { font-size: 13.5px; font-weight: 700; }
  .panel-sub { font-size: 11px; color: var(--text-4); margin-top: 1px; }

  /* Labor Master Table */
  .tbl-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  table { width: 100%; border-collapse: collapse; font-size: 12px; }
  thead th {
    padding: 7px 12px; text-align: left;
    font-size: 10px; font-weight: 700; color: var(--text-4);
    text-transform: uppercase; letter-spacing: .5px;
    background: var(--surface-2); border-bottom: 1px solid var(--border); white-space: nowrap;
  }
  tbody tr { border-bottom: 1px solid var(--border); cursor: pointer; transition: background .1s; }
  tbody tr:last-child { border-bottom: none; }
  tbody tr:hover { background: #f5f7fd; }
  tbody td { padding: 9px 12px; vertical-align: middle; }
  .emp-id { color: var(--blue); font-weight: 700; font-size: 11.5px; font-family: var(--mono); white-space: nowrap; }
  .emp-name { font-weight: 600; font-size: 12px; }
  .emp-role { font-size: 11px; color: var(--text-4); }
  .skill-badge {
    display: inline-flex; align-items: center; justify-content: center;
    padding: 3px 11px; border-radius: var(--r-xs); font-size: 11.5px; font-weight: 700; white-space: nowrap;
  }
  .sk-expert { background: var(--purple-bg); color: var(--purple); border: 1px solid #ddd6fe; }
  .sk-senior { background: var(--blue-bg); color: var(--blue); border: 1px solid #bfdbfe; }
  .sk-junior { background: var(--surface-3); color: var(--text-2); border: 1px solid var(--border-strong); }
  .rate-cell { font-family: var(--mono); font-size: 12px; font-weight: 600; color: var(--text-1); }
  .crew-cell { font-size: 12px; color: var(--text-2); }
  .quals-cell { font-family: var(--mono); font-size: 12px; color: var(--text-2); text-align: center; }
  .status-badge {
    display: inline-flex; align-items: center; gap: 4px;
    padding: 3px 10px; border-radius: 20px; font-size: 11px; font-weight: 700;
  }
  .status-badge::before { content: ''; width: 5px; height: 5px; border-radius: 50%; background: currentColor; display: block; }
  .s-active   { background: var(--green-bg); color: var(--green); }
  .s-training { background: var(--blue-bg); color: var(--blue-2); }

  /* Pagination */
  .pager {
    display: flex; align-items: center; justify-content: space-between;
    padding: 9px 16px; border-top: 1px solid var(--border);
    background: var(--surface-2); flex-wrap: wrap; gap: 8px;
  }
  .pg-l { display: flex; align-items: center; gap: 8px; }
  .pg-sel {
    border: 1px solid var(--border); border-radius: var(--r-xs);
    padding: 4px 8px; font-size: 11.5px; font-family: var(--font);
    background: var(--surface); outline: none;
  }
  .pg-info { font-size: 11px; color: var(--text-4); }
  .pg-pages { display: flex; align-items: center; gap: 4px; }
  .pg-lbl { font-size: 11px; color: var(--text-4); margin-right: 4px; }
  .pgb {
    min-width: 26px; height: 26px; padding: 0 5px;
    display: flex; align-items: center; justify-content: center;
    border: 1px solid var(--border); border-radius: var(--r-xs);
    background: var(--surface); font-size: 11.5px; cursor: pointer;
    color: var(--text-2); transition: all .15s; font-family: var(--font);
  }
  .pgb:hover, .pgb.act { background: var(--blue); color: #fff; border-color: var(--blue); }
  .pgdots { font-size: 11px; color: var(--text-4); padding: 0 2px; }

  /* Bottom Grid */
  .bottom-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }

  /* Work Description Table */
  .wd-table { width: 100%; border-collapse: collapse; font-size: 12px; }
  .wd-table thead th {
    padding: 7px 14px;
    font-size: 10px; font-weight: 700; color: var(--text-4);
    text-transform: uppercase; letter-spacing: .5px;
    background: var(--surface-2); border-bottom: 1px solid var(--border);
  }
  .wd-table tbody tr { border-bottom: 1px solid var(--border); transition: background .1s; }
  .wd-table tbody tr:last-child { border-bottom: none; }
  .wd-table tbody tr:hover { background: var(--surface-2); }
  .wd-table tbody td { padding: 9px 14px; vertical-align: middle; }
  .wd-activity { font-weight: 500; font-size: 12.5px; }
  .wd-ref { color: var(--blue); font-weight: 600; font-size: 11.5px; font-family: var(--mono); }
  .wd-num { font-family: var(--mono); font-size: 12px; color: var(--text-2); text-align: center; }

  /* Qualification Register */
  .qual-list { padding: 10px 14px; display: flex; flex-direction: column; gap: 10px; }
  .qual-card {
    border: 1px solid var(--border); border-radius: var(--r-sm);
    padding: 12px 14px; background: var(--surface-2); transition: box-shadow .15s;
  }
  .qual-card:hover { box-shadow: var(--shadow-sm); }
  .qual-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 8px; margin-bottom: 6px; }
  .qual-name { display: flex; align-items: center; gap: 7px; font-size: 12.5px; font-weight: 600; }
  .qual-ico { font-size: 14px; flex-shrink: 0; }
  .expiring-badge {
    display: inline-flex; align-items: center; gap: 4px;
    padding: 2px 8px; border-radius: 20px; font-size: 10px; font-weight: 700;
    background: var(--orange-bg); color: var(--orange); border: 1px solid #fed7aa;
    white-space: nowrap; flex-shrink: 0;
  }
  .qual-meta { font-size: 11px; color: var(--text-4); margin-bottom: 8px; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .qual-meta .dot { width: 3px; height: 3px; border-radius: 50%; background: var(--border-strong); }
  .prog-track { height: 5px; background: var(--surface-3); border-radius: 10px; overflow: hidden; }
  .prog-fill { height: 100%; border-radius: 10px; }
  .pf-orange { background: linear-gradient(90deg, #f97316, #fb923c); }
  .pf-green  { background: linear-gradient(90deg, #10b981, #34d399); }
  .pf-blue   { background: linear-gradient(90deg, #3b82f6, #60a5fa); }

  /* Download btn */
  .dl-btn {
    display: flex; align-items: center; gap: 5px;
    border: 1px solid var(--border-strong); border-radius: var(--r-sm);
    padding: 6px 12px; font-size: 11.5px; font-weight: 600; font-family: var(--font);
    background: var(--surface); cursor: pointer; color: var(--text-2); transition: all .15s;
  }
  .dl-btn:hover { border-color: var(--blue); color: var(--blue); }

  /* Responsive */
  @@media (max-width: 860px) {
    .bottom-grid { grid-template-columns: 1fr; }
    .content { padding: 0 14px 18px; }
    .stats { padding: 0 14px; }
    .ph, .crumb, .search-row { padding-left: 14px; padding-right: 14px; }
  }
  @@media (max-width: 560px) {
    .stat { min-width: 120px; padding-right: 14px; }
    .st-val { font-size: 20px; }
    .ph-acts .btn-out:not(.btn-dark) { display: none; }
    .srch-wrap { max-width: 100%; }
    thead th, tbody td { padding: 6px 8px; }
  }
</style>


<!-- Breadcrumb -->
<nav class="crumb">
  <a href="#">Home</a> <span>›</span>
  <a href="#">Workforce Management</a> <span>›</span>
  <span class="cur">Labour &amp; Crafts</span>
</nav>


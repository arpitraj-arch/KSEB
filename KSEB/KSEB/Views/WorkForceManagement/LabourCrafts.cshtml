</div>

<!-- Main Content -->
<div class="content">

  <!-- Labor Master Table -->
  <div class="panel">
    <div class="panel-hd">
      <div class="panel-hd-l">
        <svg width="15" height="15" fill="none" stroke="var(--blue)" stroke-width="2.2" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        <div>
          <div class="panel-title">Labor Master</div>
          <div class="panel-sub">35 records · click to view qualification and assignment history</div>
        </div>
      </div>
      <button class="dl-btn">
        <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        Download
      </button>
    </div>
    <div class="tbl-wrap">
      <table>
        <thead>
          <tr>
            <th>EMP ID</th>
            <th>Employee</th>
            <th>Skill Level</th>
            <th>Task / Activity</th>
            <th>Rate</th>
            <th>Crew</th>
            <th>Quals</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody id="laborBody"></tbody>
      </table>
    </div>
    <div class="pager">
      <div class="pg-l">
        <select class="pg-sel"><option>5</option><option>10</option><option>25</option></select>
        <span class="pg-info">Showing 1 to 5 of 53 entries</span>
      </div>
      <div class="pg-pages">
        <span class="pg-lbl">Page</span>
        <button class="pgb">‹</button>
        <button class="pgb act">1</button>
        <span class="pgdots">…</span>
        <button class="pgb">6</button>
        <span class="pgdots">…</span>
        <button class="pgb">10</button>
        <button class="pgb">›</button>
      </div>
    </div>
  </div>

  <!-- Bottom Grid -->
  <div class="bottom-grid">

    <!-- Work Description -->
    <div class="panel">
      <div class="panel-hd">
        <div class="panel-hd-l">
          <svg width="14" height="14" fill="none" stroke="var(--text-2)" stroke-width="2.2" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
          <div class="panel-title">Work Description</div>
        </div>
      </div>
      <div style="overflow-x:auto;">
        <table class="wd-table">
          <thead>
            <tr>
              <th>Task / Activity</th>
              <th>Headcount</th>
              <th style="text-align:center">Regular</th>
              <th style="text-align:center">Overtime</th>
              <th style="text-align:center">STD Rate</th>
            </tr>
          </thead>
          <tbody id="wdBody"></tbody>
        </table>
      </div>
    </div>

    <!-- Qualification Register -->
    <div class="panel">
      <div class="panel-hd">
        <div class="panel-hd-l">
          <svg width="14" height="14" fill="none" stroke="var(--text-2)" stroke-width="2.2" viewBox="0 0 24 24"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
          <div>
            <div class="panel-title">Qualification Register</div>
            <div class="panel-sub">Certificate Coverage and renewals</div>
          </div>
        </div>
      </div>
      <div class="qual-list" id="qualList"></div>
    </div>

  </div><!-- /bottom-grid -->

</div><!-- /content -->

<script>
  /* ─── Data ─────────────────────── */
  const labor = [
    { id:'EMP-2341', name:'S.Pillai', role:'Sr. Lineman', skill:'Expert',  task:'VCB Maintenance',   rate:'Rs 520', crew:'Crew-A', quals:15, status:'Active' },
    { id:'EMP-0234', name:'S.Pillai', role:'Sr. Lineman', skill:'Senior',  task:'Oil Filteration Setup', rate:'Rs 450', crew:'Crew-B', quals:23, status:'Training' },
    { id:'EMP-2389', name:'S.Pillai', role:'Sr. Lineman', skill:'Junior',  task:'Cable Jointing',    rate:'Rs 530', crew:'Crew-D', quals:42, status:'Active' },
    { id:'EMP-0567', name:'S.Pillai', role:'Sr. Lineman', skill:'Senior',  task:'Emergency Response', rate:'Rs 495', crew:'Crew-A', quals:56, status:'Training' },
    { id:'EMP-2456', name:'S.Pillai', role:'Sr. Lineman', skill:'Junior',  task:'Site Survey',       rate:'Rs 510', crew:'Crew-B', quals:71, status:'Active' },
    { id:'EMP-2465', name:'S.Pillai', role:'Sr. Lineman', skill:'Expert',  task:'Sick Leave',        rate:'Rs 475', crew:'Crew-B', quals:89, status:'Training' },
  ];

  const wd = [
    { task:'VCB Maintenance',      ref:'TXN-2341', head:6.0,  reg:6.0,  ot:6.0  },
    { task:'Oil Filteration Setup', ref:'TXN-0234', head:8.0,  reg:8.0,  ot:8.0  },
    { task:'Cable Jointing',        ref:'TXN-2389', head:4.0,  reg:4.0,  ot:4.0  },
    { task:'Emergency Response',    ref:'TXN-0567', head:1.5,  reg:1.5,  ot:1.5  },
    { task:'Site Survey',           ref:'TXN-2456', head:5.0,  reg:5.0,  ot:5.0  },
    { task:'Sick Leave',            ref:'TXN-2465', head:7.0,  reg:7.0,  ot:7.0  },
  ];

  const quals = [
    { name:'11kV Live-line Authorized', certified:12, total:35, pct:34, renewal:'next renewal in 14d', pfClass:'pf-orange' },
    { name:'11kV Live-line Authorized', certified:12, total:35, pct:60, renewal:'next renewal in 14d', pfClass:'pf-green'  },
    { name:'11kV Live-line Authorized', certified:12, total:35, pct:45, renewal:'next renewal in 14d', pfClass:'pf-blue'   },
  ];

  const skillClasses = { Expert:'sk-expert', Senior:'sk-senior', Junior:'sk-junior' };

  /* ─── Render Labor Table ─────── */
  document.getElementById('laborBody').innerHTML = labor.map((r,i) => `
    <tr onclick="selRow(this)">
      <td class="emp-id">${r.id}</td>
      <td><div class="emp-name">${r.name}</div><div class="emp-role">${r.role}</div></td>
      <td><span class="skill-badge ${skillClasses[r.skill]}">${r.skill}</span></td>
      <td style="font-size:12px;color:var(--text-2)">${r.task}</td>
      <td class="rate-cell">${r.rate}</td>
      <td class="crew-cell">${r.crew}</td>
      <td class="quals-cell">${r.quals}</td>
      <td><span class="status-badge ${r.status==='Active'?'s-active':'s-training'}">${r.status}</span></td>
    </tr>
  `).join('');

  function selRow(r) {
    document.querySelectorAll('#laborBody tr').forEach(x => x.style.background = '');
    r.style.background = 'var(--blue-bg)';
  }

  /* ─── Render Work Description ─── */
  document.getElementById('wdBody').innerHTML = wd.map(r => `
    <tr>
      <td class="wd-activity">${r.task}</td>
      <td class="wd-ref">${r.ref}</td>
      <td class="wd-num">${r.head.toFixed(1)}</td>
      <td class="wd-num">${r.reg.toFixed(1)}</td>
      <td class="wd-num">${r.ot.toFixed(1)}</td>
    </tr>
  `).join('');

  /* ─── Render Quals ──────────── */
  document.getElementById('qualList').innerHTML = quals.map(q => `
    <div class="qual-card">
      <div class="qual-top">
        <div class="qual-name">
          <span class="qual-ico">📋</span>
          ${q.name}
        </div>
        <span class="expiring-badge">
          <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/></svg>
          3 expiring
        </span>
      </div>
      <div class="qual-meta">
        <span>${q.certified}/${q.total} certified · ${q.pct}%</span>
        <span class="dot"></span>
        <span>📅 ${q.renewal}</span>
      </div>
      <div class="prog-track">
        <div class="prog-fill ${q.pfClass}" style="width:${q.pct}%"></div>
      </div>
    </div>
  `).join('');

  /* ─── Pagination ──────────── */
  document.querySelectorAll('.pgb').forEach(b => {
    b.addEventListener('click', function() {
      document.querySelectorAll('.pgb').forEach(x => x.classList.remove('act'));
      this.classList.add('act');
    });
  });
</script>


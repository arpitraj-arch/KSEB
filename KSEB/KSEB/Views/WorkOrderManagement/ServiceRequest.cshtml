@{
    ViewData["Title"] = "Service Request";
}
@{
    ViewData["ActiveMenu"] = "Work Order Management";
}

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Service Request – Work Order Management</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #f0f2f7;
    --surface: #ffffff;
    --surface2: #f7f8fc;
    --border: #e4e8f0;
    --text: #1a1f36;
    --text2: #5a6080;
    --text3: #9ba3bf;
    --accent: #3b5bdb;
    --accent-light: #eef2ff;
    --red: #e03131;
    --red-light: #fff5f5;
    --orange: #f76707;
    --orange-light: #fff4e6;
    --green: #2f9e44;
    --green-light: #ebfbee;
    --yellow: #e67700;
    --yellow-light: #fff9db;
    --purple: #7048e8;
    --purple-light: #f3f0ff;
    --teal: #0c8599;
    --teal-light: #e3fafc;
    --shadow-sm: 0 1px 3px rgba(26,31,54,.06), 0 1px 2px rgba(26,31,54,.04);
    --shadow: 0 4px 16px rgba(26,31,54,.08), 0 1px 4px rgba(26,31,54,.04);
    --radius: 12px;
    --radius-sm: 8px;
    --radius-xs: 5px;
    --header-h: 56px;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'DM Sans', sans-serif;
    background: var(--bg);
    color: var(--text);
    font-size: 14px;
    line-height: 1.5;
    min-height: 100vh;
  }

  /* TOP BAR */
  .topbar {
    height: var(--header-h);
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    padding: 0 24px;
    gap: 12px;
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: var(--shadow-sm);
  }
  .topbar-left {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: 1;
  }
  .topbar-logo {
    font-weight: 800;
    font-size: 15px;
    color: var(--accent);
    letter-spacing: -.4px;
    display: flex;
    align-items: center;
    gap: 7px;
    padding-right: 16px;
    border-right: 1px solid var(--border);
    white-space: nowrap;
  }
  .topbar-breadcrumb {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 13px;
    color: var(--text3);
    flex-wrap: wrap;
  }
  .topbar-breadcrumb .current { color: var(--text); font-weight: 600; }
  .topbar-actions { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 14px;
    border-radius: var(--radius-xs);
    font-size: 13px;
    font-weight: 600;
    font-family: inherit;
    cursor: pointer;
    border: none;
    transition: background .15s, transform .1s;
    white-space: nowrap;
  }
  .btn:active { transform: scale(.97); }
  .btn-outline {
    background: var(--surface);
    color: var(--text2);
    border: 1px solid var(--border);
  }
  .btn-outline:hover { background: var(--surface2); }
  .btn-primary { background: var(--accent); color: #fff; }
  .btn-primary:hover { background: #2f4ec0; }

  /* PAGE */
  .page { padding: 8px; display: flex; flex-direction: column; gap: 8px; max-width: 100vw; margin: 0 auto; }

  /* KPI GRID */
  .kpi-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
  }
  .kpi-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 16px 18px;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    gap: 6px;
    transition: box-shadow .2s, transform .2s;
  }
  .kpi-card:hover { box-shadow: var(--shadow); transform: translateY(-1px); }
  .kpi-top { display: flex; align-items: center; gap: 8px; }
  .kpi-icon {
    width: 32px; height: 32px;
    border-radius: var(--radius-sm);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .kpi-icon.blue { background: var(--accent-light); color: var(--accent); }
  .kpi-icon.red { background: var(--red-light); color: var(--red); }
  .kpi-icon.green { background: var(--green-light); color: var(--green); }
  .kpi-icon.purple { background: var(--purple-light); color: var(--purple); }
  .kpi-label { font-size: 10.5px; font-weight: 700; letter-spacing: .6px; text-transform: uppercase; color: var(--text3); }
  .kpi-value { font-size: 28px; font-weight: 700; letter-spacing: -1.2px; color: var(--text); line-height: 1; }
  .kpi-sub { font-size: 12px; color: var(--text3); display: flex; align-items: center; gap: 4px; }
  .kpi-sub .up { color: var(--green); }
  .kpi-sub .down { color: var(--red); }

  /* SECTION CARD */
  .section-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }
  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 20px;
    border-bottom: 1px solid var(--border);
  }
  .section-title {
    font-size: 13.5px;
    font-weight: 700;
    color: var(--text);
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .section-sub { font-size: 12px; color: var(--text3); font-weight: 400; }

  /* INTAKE */
  .intake-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    padding: 16px 20px;
  }
  .intake-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 12px 8px;
    border-radius: var(--radius-sm);
    transition: background .15s;
    cursor: pointer;
  }
  .intake-item:hover { background: var(--surface2); }
  .intake-icon {
    width: 36px; height: 36px;
    border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
  }
  .intake-icon.phone  { background: #e0f2fe; color: #0369a1; }
  .intake-icon.mobile { background: #f0fdf4; color: #16a34a; }
  .intake-icon.sms    { background: #fdf4ff; color: #9333ea; }
  .intake-icon.email1 { background: #fff7ed; color: #ea580c; }
  .intake-icon.email2 { background: #fef2f2; color: #dc2626; }
  .intake-icon.email3 { background: #fef9c3; color: #ca8a04; }
  .intake-label { font-size: 10px; font-weight: 700; letter-spacing: .5px; text-transform: uppercase; color: var(--text3); text-align: center; }
  .intake-count { font-size: 22px; font-weight: 700; letter-spacing: -1px; color: var(--text); }

  /* BOTTOM GRID */
  .bottom-grid {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 8px;
    align-items: start;
  }

  /* TABLE */
  .table-toolbar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 20px;
    border-bottom: 1px solid var(--border);
    flex-wrap: wrap;
  }
  .search-wrap { flex: 1; min-width: 200px; position: relative; }
  .search-wrap svg {
    position: absolute; left: 10px; top: 50%;
    transform: translateY(-50%); color: var(--text3);
  }
  .search-input {
    width: 100%;
    padding: 7px 12px 7px 34px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font-family: inherit; font-size: 13px; color: var(--text);
    background: var(--surface2); outline: none;
    transition: border .15s, box-shadow .15s;
  }
  .search-input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(59,91,219,.1);
    background: var(--surface);
  }
  .data-table { width: 100%; border-collapse: collapse; }
  .data-table th {
    padding: 10px 12px;
    text-align: left;
    font-size: 11px; font-weight: 700; letter-spacing: .5px; text-transform: uppercase;
    color: var(--text3); background: var(--surface2);
    border-bottom: 1px solid var(--border); white-space: nowrap;
  }
  .data-table th:first-child { width: 36px; padding-left: 20px; }
  .data-table td {
    padding: 11px 12px;
    border-bottom: 1px solid var(--border);
    color: var(--text); font-size: 13px; vertical-align: middle;
  }
  .data-table td:first-child { padding-left: 20px; }
  .data-table tr:last-child td { border-bottom: none; }
  .data-table tr:hover td { background: var(--surface2); }
  .data-table input[type=checkbox] { accent-color: var(--accent); cursor: pointer; }

  .sr-id { font-family: 'DM Mono', monospace; font-size: 12px; font-weight: 500; color: var(--accent); white-space: nowrap; }
  .cell-name { font-weight: 500; font-size: 13px; color: var(--text); }
  .cell-sub { font-size: 11.5px; color: var(--text3); margin-top: 1px; }

  .chip {
    display: inline-flex; align-items: center; gap: 4px;
    padding: 3px 8px; border-radius: 20px; font-size: 11.5px; font-weight: 600; white-space: nowrap;
  }
  .chip.circuit     { background: #eef2ff; color: var(--accent); }
  .chip.transformer { background: #fdf4ff; color: #9333ea; }

  .badge {
    display: inline-flex; align-items: center;
    padding: 3px 9px; border-radius: 20px; font-size: 11px; font-weight: 700; white-space: nowrap;
  }
  .badge.critical { background: var(--red-light);    color: var(--red); }
  .badge.high     { background: var(--orange-light); color: var(--orange); }
  .badge.medium   { background: var(--yellow-light); color: var(--yellow); }
  .badge.low      { background: var(--green-light);  color: var(--green); }

  .sla-time { font-family: 'DM Mono', monospace; font-size: 12px; font-weight: 500; }
  .sla-time.breach { color: var(--red); }
  .sla-time.warn   { color: var(--orange); }
  .sla-time.ok     { color: var(--green); }

  .status-badge {
    display: inline-flex; align-items: center; gap: 4px;
    padding: 3px 9px; border-radius: var(--radius-xs); font-size: 11.5px; font-weight: 600; white-space: nowrap;
  }
  .status-badge::before { content: ''; width: 5px; height: 5px; border-radius: 50%; background: currentColor; opacity: .7; }
  .status-badge.resolved  { background: var(--green-light);  color: var(--green); }
  .status-badge.new       { background: var(--accent-light); color: var(--accent); }
  .status-badge.triggered { background: var(--orange-light); color: var(--orange); }
  .status-badge.wdcreated { background: var(--yellow-light); color: var(--yellow); }
  .status-badge.dispatched{ background: var(--teal-light);   color: var(--teal); }

  .action-btn {
    background: none; border: none; cursor: pointer;
    padding: 4px; border-radius: var(--radius-xs); color: var(--text3);
    transition: background .15s, color .15s; font-size: 16px;
  }
  .action-btn:hover { background: var(--surface2); color: var(--text2); }

  .table-footer {
    display: flex; align-items: center; justify-content: space-between;
    padding: 12px 20px; border-top: 1px solid var(--border);
    background: var(--surface2); flex-wrap: wrap; gap: 8px;
  }
  .tf-left { display: flex; align-items: center; gap: 8px; }
  .tf-select {
    padding: 5px 10px; border: 1px solid var(--border); border-radius: var(--radius-xs);
    font-family: inherit; font-size: 13px; background: var(--surface); color: var(--text);
    outline: none; cursor: pointer;
  }
  .tf-info { font-size: 12.5px; color: var(--text3); }
  .pagination { display: flex; align-items: center; gap: 4px; }
  .page-btn {
    min-width: 30px; height: 30px;
    display: flex; align-items: center; justify-content: center;
    border: 1px solid var(--border); border-radius: var(--radius-xs);
    font-size: 12.5px; font-weight: 600; font-family: inherit;
    cursor: pointer; background: var(--surface); color: var(--text2);
    transition: background .15s, color .15s;
  }
  .page-btn:hover, .page-btn.active { background: var(--accent); color: #fff; border-color: var(--accent); }
  .page-btn.disabled { opacity: .4; cursor: default; pointer-events: none; }

  /* RIGHT PANEL */
  .right-panel { display: flex; flex-direction: column; gap: 8px; }

  /* SLA TRACKER */
  .sla-list { padding: 14px 20px; display: flex; flex-direction: column; gap: 16px; }
  .sla-item-top { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
  .sla-tier {
    width: 26px; height: 26px; border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
    font-size: 12px; font-weight: 800; flex-shrink: 0;
  }
  .sla-tier.a { background: #fee2e2; color: var(--red); }
  .sla-tier.b { background: #fff7ed; color: var(--orange); }
  .sla-tier.c { background: var(--yellow-light); color: var(--yellow); }
  .sla-item-info { flex: 1; }
  .sla-item-label { font-size: 13px; font-weight: 600; color: var(--text); }
  .sla-item-pct-wrap { display: flex; align-items: center; gap: 6px; }
  .sla-pct { font-size: 20px; font-weight: 700; color: var(--text); letter-spacing: -.5px; }
  .sla-trend { font-size: 11px; font-weight: 700; display: flex; align-items: center; gap: 2px; }
  .sla-trend.up { color: var(--green); }
  .sla-trend.down { color: var(--red); }
  .progress-bar { width: 100%; height: 7px; background: var(--border); border-radius: 10px; overflow: hidden; }
  .progress-fill { height: 100%; border-radius: 10px; transition: width .6s cubic-bezier(.4,0,.2,1); }
  .progress-fill.green  { background: linear-gradient(90deg,#34d058,#2f9e44); }
  .progress-fill.orange { background: linear-gradient(90deg,#fb923c,#ea580c); }
  .progress-fill.red    { background: linear-gradient(90deg,#f87171,#dc2626); }

  /* QUICK LOG */
  .quick-log-form { padding: 16px 20px; display: flex; flex-direction: column; gap: 12px; }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .form-row.three { grid-template-columns: 1fr 1fr 1fr; }
  .form-group { display: flex; flex-direction: column; gap: 5px; }
  .form-label { font-size: 11.5px; font-weight: 700; color: var(--text2); letter-spacing: .2px; }
  .form-label span { color: var(--red); }
  .form-control {
    padding: 8px 11px; border: 1px solid var(--border); border-radius: var(--radius-sm);
    font-family: inherit; font-size: 13px; color: var(--text); background: var(--surface2);
    outline: none; transition: border .15s, box-shadow .15s; width: 100%;
  }
  .form-control:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(59,91,219,.1);
    background: var(--surface);
  }
  .form-control::placeholder { color: var(--text3); }
  textarea.form-control { resize: vertical; min-height: 68px; }
  .form-footer { padding: 12px 20px 16px; display: flex; justify-content: flex-end; border-top: 1px solid var(--border); }

  /* ── RESPONSIVE ─────────────────── */
  @@media (max-width: 1200px) {
    .kpi-grid { grid-template-columns: repeat(2, 1fr); }
    .intake-grid { grid-template-columns: repeat(3, 1fr); }
    .bottom-grid { grid-template-columns: 1fr; }
    .right-panel { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  }
  @@media (max-width: 900px) {
    .page { padding: 16px; gap: 16px; }
    .bottom-grid { grid-template-columns: 1fr; }
    .right-panel { display: flex; flex-direction: column; }
    .data-table th:nth-child(8),
    .data-table td:nth-child(8),
    .data-table th:nth-child(9),
    .data-table td:nth-child(9) { display: none; }
    .topbar-logo span.logo-text { display: none; }
  }
  @@media (max-width: 680px) {
    .kpi-grid { grid-template-columns: 1fr 1fr; }
    .intake-grid { grid-template-columns: repeat(3, 1fr); }
    .kpi-value { font-size: 22px; }
    .topbar-actions .btn-outline { display: none; }
    .form-row, .form-row.three { grid-template-columns: 1fr; }
    .data-table th:nth-child(5),
    .data-table td:nth-child(5),
    .data-table th:nth-child(6),
    .data-table td:nth-child(6) { display: none; }
    .topbar-breadcrumb { display: none; }
  }
  @@media (max-width: 480px) {
    .kpi-grid { grid-template-columns: 1fr 1fr; }
    .intake-grid { grid-template-columns: repeat(2, 1fr); }
    .page { padding: 10px; gap: 12px; }
    .topbar { padding: 0 14px; }
    .kpi-card { padding: 13px 14px; }
    .data-table th:nth-child(4),
    .data-table td:nth-child(4) { display: none; }
  }
</style>


  <!-- TOP BAR -->
  <header class="topbar">
    <div class="topbar-left">
    
      <div class="topbar-breadcrumb">
        <span>Work Order Management</span>
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="current">Service Request</span>
      </div>
    </div>
    <div class="topbar-actions">
      <button class="btn btn-outline">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
        Saved Queries
      </button>
      <button class="btn btn-primary">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        New Escalation
      </button>
    </div>
  </header>

  <!-- PAGE -->
  <main class="page">

    <!-- KPI CARDS -->
    <div class="kpi-grid">
      <div class="kpi-card">
        <div class="kpi-top">
          <div class="kpi-icon blue">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/></svg>
          </div>
          <div class="kpi-label">Open Requests</div>
        </div>
        <div class="kpi-value">166</div>
        <div class="kpi-sub"><span class="up">↑ 14 today</span></div>
      </div>
      <div class="kpi-card">
        <div class="kpi-top">
          <div class="kpi-icon red">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          </div>
          <div class="kpi-label">Critical / SLA Risk</div>
        </div>
        <div class="kpi-value">9</div>
        <div class="kpi-sub"><span class="down">2 breaching</span></div>
      </div>
      <div class="kpi-card">
        <div class="kpi-top">
          <div class="kpi-icon green">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <div class="kpi-label">Resolved Today</div>
        </div>
        <div class="kpi-value">58</div>
        <div class="kpi-sub"><span class="up">91% SLA met</span></div>
      </div>
      <div class="kpi-card">
        <div class="kpi-top">
          <div class="kpi-icon purple">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
          <div class="kpi-label">Avg. Response</div>
        </div>
        <div class="kpi-value">14m</div>
        <div class="kpi-sub"><span class="down">↓ 3m vs LM</span></div>
      </div>
    </div>

    <!-- INTAKE CHANNELS -->
    <div class="section-card">
      <div class="section-header">
        <div class="section-title">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.27 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.18 1.3h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.09 9.26a16 16 0 0 0 6 6l1.32-1.32a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7a2 2 0 0 1 1.72 2.03z"/></svg>
          Intake Channels
          <span class="section-sub">— Today</span>
        </div>
      </div>
      <div class="intake-grid">
        <div class="intake-item">
          <div class="intake-icon phone"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.27 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.18 1.3h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.09 9.26a16 16 0 0 0 6 6l1.32-1.32a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7a2 2 0 0 1 1.72 2.03z"/></svg></div>
          <div class="intake-label">Call Center</div>

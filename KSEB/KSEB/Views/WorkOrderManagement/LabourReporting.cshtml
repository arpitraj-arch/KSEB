<script>
  // TABLE DATA
  const rows = [
    { txn: 'TXN-2341', date: '29-Apr-2026', emp: 'S.Pillai', role: 'Sr. Lineman', wo: 'WO-2026-0891', task: 'VCB Maintenance',      reg: 6.0, ot: 6.0, status: 'Approved' },
    { txn: 'TXN-0234', date: '29-Apr-2026', emp: 'S.Pillai', role: 'Sr. Lineman', wo: 'WO-2026-0891', task: 'Oil Filtration Setup',  reg: 8.0, ot: 8.0, status: 'Submitted' },
    { txn: 'TXN-2389', date: '29-Apr-2026', emp: 'S.Pillai', role: 'Sr. Lineman', wo: 'WO-2026-0891', task: 'Cable Jointing',        reg: 4.0, ot: 4.0, status: 'Approved' },
    { txn: 'TXN-0567', date: '29-Apr-2026', emp: 'S.Pillai', role: 'Sr. Lineman', wo: 'WO-2026-0891', task: 'Emergency Response',    reg: 1.5, ot: 1.5, status: 'Submitted' },
    { txn: 'TXN-2456', date: '29-Apr-2026', emp: 'S.Pillai', role: 'Sr. Lineman', wo: 'WO-2026-0891', task: 'Site Survey',           reg: 5.0, ot: 5.0, status: 'Approved' },
    { txn: 'TXN-2465', date: '29-Apr-2026', emp: 'S.Pillai', role: 'Sr. Lineman', wo: 'WO-2026-0891', task: 'Sick Leave',            reg: 7.0, ot: 7.0, status: 'Approved' },
  ];

  const tbody = document.getElementById('tableBody');
  rows.forEach(r => {
    const cls = r.status === 'Approved' ? 'approved' : 'submitted';
    tbody.innerHTML += `<tr>
      <td><input type="checkbox"></td>
      <td><span class="txn-id">${r.txn}</span></td>
      <td style="color:var(--text2);font-size:12.5px;">${r.date}</td>
      <td><div class="cell-main">${r.emp}</div><div class="cell-sub">${r.role}</div></td>
      <td><span class="wo-id">${r.wo}</span></td>
      <td>${r.task}</td>
      <td><span class="hours-cell">${r.reg.toFixed(1)}</span></td>
      <td><span class="hours-cell">${r.ot.toFixed(1)}</span></td>
      <td><span class="status-pill ${cls}">${r.status}</span></td>
      <td><button class="action-btn">⋮</button></td>
    </tr>`;
  });

  // SELECT ALL
  document.getElementById('selAll').addEventListener('change', function() {
    document.querySelectorAll('#tableBody input[type=checkbox]').forEach(c => c.checked = this.checked);
  });

  // PAGINATION
  document.querySelectorAll('.page-btn:not(.disabled)').forEach(btn => {
    btn.addEventListener('click', function() {
      if (this.querySelector('svg')) return;
      document.querySelectorAll('.page-btn').forEach(b => b.classList.remove('active'));
      this.classList.add('active');
    });
  });

  // LIVE TIMER
  let seconds = 3 * 60 + 21;
  const timerEl = document.querySelector('.timer-time');
  setInterval(() => {
    seconds++;
    const m = String(Math.floor(seconds / 60)).padStart(2, '0');
    const s = String(seconds % 60).padStart(2, '0');
    timerEl.textContent = `${m}:${s}`;
  }, 1000);
</script>

@{
}
@{
    ViewData["Title"] = "Quick Reporting";
}
@{
    ViewData["ActiveMenu"] = "Work Order Management";
}

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Quick Reporting</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@latest/tabler-icons.min.css" />
<style>
/* ── Reset ── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html, body {
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  font-size: 13px;
  color: #1a1a2e;
  background: #f4f5f7;
  min-height: 100vh;
  line-height: 1.5;
}
input, select, textarea, button { font-family: inherit; font-size: inherit; }
button { cursor: pointer; border: none; background: none; outline: none; }
a { text-decoration: none; }

/* ── Breadcrumb nav ── */
.nav-bar {
  background: #fff;
  border-bottom: 1px solid #e5e7eb;
  padding: 0 24px;
  height: 40px;
  display: flex;
  align-items: center;
  gap: 5px;
  font-size: 12px;
  color: #6b7280;
  position: sticky;
  top: 0;
  z-index: 200;
}
.nav-bar a { color: #6b7280; }
.nav-bar a:hover { color: #2563eb; }
.nav-bar .nav-sep { color: #d1d5db; font-size: 11px; }
.nav-bar .nav-cur { color: #111827; font-weight: 500; }

/* ── Page shell ── */
.page-shell {
  display: flex;
  flex: 1;
  align-items: flex-start;
  max-width: 1400px;
  margin: 0 auto;
  width: 100%;
  padding: 0 0 40px;
}

/* ── Main content ── */
.page-main {
  flex: 1;
  min-width: 0;
  padding: 0 0 0 0;
  max-width:100vw;
}

/* ── Sidebar ── */
.page-sidebar {
  width: 292px;
  flex-shrink: 0;
  padding: 1px 4px 0 4px;
  
  top: 40px;
  max-height: calc(100vh - 40px);
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.page-sidebar::-webkit-scrollbar { width: 4px; }
.page-sidebar::-webkit-scrollbar-thumb { background: #e5e7eb; border-radius: 10px; }

@@media (max-width: 900px) {
  .page-shell    { flex-direction: column; }
  .page-sidebar  { width: 100%; position: static; max-height: none; padding: 0 16px 16px; }
}

/* ═══════════════════════════════════════════════
   TOP WHITE CARD  (header + stats + search)
═══════════════════════════════════════════════ */
.top-card {
  background: #fff;
  border-bottom: 1px solid #e5e7eb;
}

/* ── Page header row ── */
.page-hdr {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 16px 24px 14px;
  gap: 12px;
  flex-wrap: wrap;
}
.page-hdr-left {
  display: flex;
  align-items: flex-start;
  gap: 10px;
}
.back-btn {
  width: 30px; height: 30px;
  border-radius: 50%;
  border: 1px solid #e5e7eb;
  display: flex; align-items: center; justify-content: center;
  color: #6b7280;
  margin-top: 3px;
  flex-shrink: 0;
  transition: border-color .15s, color .15s;
}
.back-btn:hover { border-color: #2563eb; color: #2563eb; }
.back-btn i { font-size: 15px; }

.page-hdr-title h1 {
  font-size: 18px;
  font-weight: 700;
  color: #111827;
  letter-spacing: -.02em;
  line-height: 1.2;
}
.page-hdr-title p {
  font-size: 12px;
  color: #9ca3af;
  margin-top: 1px;
}

.recent-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  border: 1px solid #e5e7eb;
  border-radius: 8px;
  padding: 7px 14px;
  font-size: 12px;
  font-weight: 500;
  color: #374151;
  background: #fff;
  white-space: nowrap;
  transition: border-color .15s;
  align-self: flex-start;
}
.recent-btn:hover { border-color: #2563eb; color: #2563eb; }
.recent-btn i { font-size: 14px; }

/* ── Stats row ── */
.stats-row {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  border-top: 1px solid #f3f4f6;
        border-bottom: 1px #f3f4f6; 
}
@@media (max-width: 700px) { .stats-row { grid-template-columns: repeat(2, 1fr); } }
@@media (max-width: 380px) { .stats-row { grid-template-columns: 1fr 1fr; } }

.stat-cell {
  padding: 14px 20px 14px;
  border-right: 1px solid #f3f4f6;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.stat-cell:last-child { border-right: none; }

.stat-top {
  display: flex;
  align-items: center;
  gap: 7px;
  margin-bottom: 4px;
}
.stat-icon {
  width: 28px; height: 28px;
  border-radius: 7px;
  display: flex; align-items: center; justify-content: center;
  font-size: 15px;
  flex-shrink: 0;
}
.si-blue   { background: #eff6ff; color: #2563eb; }
.si-amber  { background: #fffbeb; color: #d97706; }
.si-green  { background: #f0fdf4; color: #16a34a; }
.si-purple { background: #faf5ff; color: #7c3aed; }

.stat-label {
  font-size: 10px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: .07em;
  color: #9ca3af;
}

.stat-value-row {
  display: flex;
  align-items: baseline;
  gap: 7px;
}
.stat-value {
  font-size: 26px;
  font-weight: 700;
  color: #111827;
  line-height: 1;
}
.stat-sub {
  font-size: 12px;
  color: #6b7280;
}
.stat-sub .up   { color: #16a34a; font-weight: 500; }
.stat-sub .warn { color: #d97706; font-weight: 500; }

/* ── Search / filter row ── */
.search-row {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 16px 10px;
  flex-wrap: wrap;
}
.search-wrap {
  flex: 1;
  min-width: 160px;
  position: relative;
}
.search-wrap i {
  position: absolute;
  left: 10px; top: 50%;
  transform: translateY(-50%);
  font-size: 15px;
  color: #9ca3af;
  pointer-events: none;
}
.search-input {
  width: 100%;
  padding: 8px 12px 8px 33px;
  border: 1px solid #e5e7eb;
  border-radius: 8px;
  font-size: 12.5px;
  color: #374151;
  background: #fff;
  outline: none;
  transition: border-color .15s;
}
.search-input::placeholder { color: #9ca3af; }
.search-input:focus { border-color: #93c5fd; }

.filter-btn {
  display: inline-flex; align-items: center; gap: 5px;
  border: 1px solid #e5e7eb;
  border-radius: 8px;
  padding: 7px 13px;
  font-size: 12.5px; font-weight: 500;
  color: #374151;
  background: #fff;
  white-space: nowrap;
  transition: border-color .15s;
}
.filter-btn:hover { border-color: #93c5fd; }
.filter-btn i { font-size: 14px; color: #6b7280; }

.load-btn {
  display: inline-flex; align-items: center; gap: 5px;
  border: none;
  border-radius: 8px;
  padding: 8px 18px;
  font-size: 12.5px; font-weight: 600;
  color: #fff;
  background: #2563eb;
  white-space: nowrap;
  transition: background .15s;
}
.load-btn:hover { background: #1d4ed8; }
.load-btn i { font-size: 14px; }

/* ═══════════════════════════════════════════════
   CONTENT AREA  (WO card + steps)
═══════════════════════════════════════════════ */
.content-area {
  padding: 8px 8px 0;
}

/* ── Work Order Card ── */
.wo-card {
  background: #fff;
  border: 1px solid #e5e7eb;
  border-radius: 12px;
  padding: 8px 8px;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 8px;
  flex-wrap: wrap;
  margin-bottom: 14px;
  box-shadow: 0 1px 3px rgba(0,0,0,.06);
}
.wo-left { display: flex; align-items: flex-start; gap: 11px; flex: 1; min-width: 0; }
.wo-avatar {
  width: 34px; height: 34px;
  border-radius: 8px;
  background: #eff6ff;
  color: #2563eb;
  display: flex; align-items: center; justify-content: center;
  font-size: 17px; flex-shrink: 0;
}
.wo-id {
  font-size: 11.5px; font-weight: 600; color: #2563eb; margin-bottom: 2px;
  font-variant-numeric: tabular-nums;
}
.wo-name { font-size: 13.5px; font-weight: 600; color: #111827; margin-bottom: 5px; }
.wo-meta { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; font-size: 11.5px; color: #6b7280; }
.wo-meta span { display: flex; align-items: center; gap: 4px; }
.wo-meta i { font-size: 13px; }

.apr-badge {
  display: inline-block;
  background: #fefce8; color: #854d0e;
  border: 1px solid #fde68a;
  border-radius: 5px;
  font-size: 10.5px; font-weight: 700;
  padding: 3px 9px;
  letter-spacing: .05em;
  flex-shrink: 0;
  align-self: flex-start;
}

/* ── Section card ── */
.section-card {
  background: #fff;
  border: 1px solid #e5e7eb;
  border-radius: 12px;
  margin-bottom: 14px;
  overflow: hidden;
  box-shadow: 0 1px 3px rgba(0,0,0,.05);
}
.section-hdr {
  display: flex; align-items: center; gap: 8px;
  padding: 11px 16px;
  border-bottom: 1px solid #f3f4f6;
  font-size: 12.5px; font-weight: 700;
  color: #111827;
  background: #fafafa;
}
.section-hdr i { font-size: 15px; color: #2563eb; }
.section-body { padding: 15px 16px; }

/* ── Step 2: Completion buttons ── */
.completion-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10px;
}
@@media (max-width: 560px) { .completion-grid { grid-template-columns: repeat(2, 1fr); } }

.comp-btn {
  border: 1.5px solid #e5e7eb;
  border-radius: 10px;
  padding: 11px 8px;
  display: flex; flex-direction: column; align-items: center;
  gap: 6px;
  font-size: 12px; font-weight: 500;
  color: #6b7280;
  background: #fff;
  transition: all .15s;
  cursor: pointer;
  text-align: center;
}
.comp-btn i { font-size: 22px; }
.comp-btn:hover { border-color: #93c5fd; color: #2563eb; }
.comp-btn.active {
  border-color: #16a34a;
  background: #f0fdf4;
  color: #15803d;
}
.comp-btn.active i { color: #16a34a; }

/* ── Step 3: Time row ── */
.time-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 14px;
  align-items: end;
}
@@media (max-width: 520px) { .time-grid { grid-template-columns: 1fr 1fr; } }
@@media (max-width: 340px) { .time-grid { grid-template-columns: 1fr; } }

/* ── Form fields ── */
.f-field { display: flex; flex-direction: column; gap: 5px; }
.f-label {
  font-size: 11px; font-weight: 600;
  color: #6b7280;
  text-transform: uppercase;
  letter-spacing: .065em;
}
.f-input {
  padding: 8px 10px;
  border: 1px solid #e5e7eb;
  border-radius: 7px;
  background: #fff;
  color: #111827;
  font-size: 12.5px;
  outline: none;
  width: 100%;
  transition: border-color .15s;
}
.f-input:focus { border-color: #93c5fd; }
.f-input-wrap { position: relative; }
.f-input-wrap .f-ico {
  position: absolute; right: 9px; top: 50%;
  transform: translateY(-50%);
  color: #9ca3af; font-size: 14px; pointer-events: none;
}

/* ── Step 4: Materials table ── */
.tbl-action-row {
  display: flex; justify-content: flex-end; margin-bottom: 10px;
}
.dl-btn {
  display: inline-flex; align-items: center; gap: 5px;
  border: 1px solid #e5e7eb; border-radius: 7px;
  padding: 6px 13px;
  font-size: 12px; font-weight: 500;
  color: #374151; background: #fff;
  transition: border-color .15s;
}
.dl-btn:hover { border-color: #2563eb; color: #2563eb; }
.dl-btn i { font-size: 14px; }

.tbl-scroll-wrap {
  width: 100%;
  overflow-x: auto;
  overflow-y: auto;
  max-height: 260px;
  border: 1px solid #e5e7eb;
  border-radius: 9px;
}
.tbl-scroll-wrap::-webkit-scrollbar        { width: 4px; height: 4px; }
.tbl-scroll-wrap::-webkit-scrollbar-track  { background: #f9fafb; }
.tbl-scroll-wrap::-webkit-scrollbar-thumb  { background: #d1d5db; border-radius: 8px; }

table.mat-tbl {
  width: 100%; border-collapse: collapse;
  font-size: 12.5px;
  min-width: 440px;
}
table.mat-tbl thead th {
  position: sticky; top: 0; z-index: 1;
  background: #f9fafb;
  font-size: 10px; font-weight: 700;
  text-transform: uppercase; letter-spacing: .07em;
  color: #9ca3af;
  padding: 9px 13px;
  text-align: left;
  border-bottom: 1px solid #e5e7eb;
  white-space: nowrap;
}
table.mat-tbl tbody tr { border-bottom: 1px solid #f3f4f6; transition: background .1s; }
table.mat-tbl tbody tr:last-child { border-bottom: none; }
table.mat-tbl tbody tr:hover { background: #f9fafb; }
table.mat-tbl tbody td {
  padding: 9px 13px; color: #374151;
  vertical-align: middle; white-space: nowrap;
}
.td-item-name { font-weight: 500; color: #111827; }
.td-muted     { color: #9ca3af; }

.more-btn {
  width: 26px; height: 26px; border-radius: 6px;
  display: inline-flex; align-items: center; justify-content: center;
  border: 1px solid #e5e7eb; color: #9ca3af;
  transition: border-color .12s, color .12s;
}
.more-btn:hover { border-color: #2563eb; color: #2563eb; }

/* Table pagination row */
.tbl-foot {
  display: flex; align-items: center; justify-content: space-between;
  flex-wrap: wrap; gap: 8px; margin-top: 10px;
  font-size: 11.5px; color: #6b7280;
}
.tbl-foot-l { display: flex; align-items: center; gap: 7px; }
.per-page-sel {
  border: 1px solid #e5e7eb; border-radius: 5px;
  padding: 3px 6px; font-size: 11.5px;
  color: #374151; background: #fff; outline: none;
}
.pg-btns { display: flex; align-items: center; gap: 3px; }
.pg-btn {
  min-width: 26px; height: 26px; border-radius: 5px;
  border: 1px solid #e5e7eb;
  font-size: 11.5px; font-weight: 500; color: #6b7280;
  background: #fff;
  display: inline-flex; align-items: center; justify-content: center;
  padding: 0 5px;
  transition: all .12s;
}
.pg-btn:hover { border-color: #2563eb; color: #2563eb; }
.pg-btn.active { background: #2563eb; border-color: #2563eb; color: #fff; }
.pg-btn i { font-size: 13px; }

/* ── Step 5: Meter readings ── */
.meter-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14px;
  margin-bottom: 14px;
}
@@media (max-width: 560px) { .meter-grid { grid-template-columns: 1fr 1fr; } }
@@media (max-width: 360px) { .meter-grid { grid-template-columns: 1fr; } }

.f-select {
  padding: 8px 10px;
  border: 1px solid #e5e7eb;
  border-radius: 7px;
  background: #fff; color: #374151;
  font-size: 12.5px; width: 100%; outline: none;
  transition: border-color .15s;
}
.f-select:focus { border-color: #93c5fd; }

.f-textarea {
  width: 100%;
  padding: 9px 11px;
  border: 1px solid #e5e7eb;
  border-radius: 7px;
  background: #fff; color: #374151;
  font-size: 12.5px; resize: vertical; min-height: 72px;
  outline: none; transition: border-color .15s;
}
.f-textarea:focus { border-color: #93c5fd; }
.f-textarea::placeholder { color: #9ca3af; }
.f-input::placeholder { color: #9ca3af; }

.divider { border: none; border-top: 1px solid #f3f4f6; margin: 14px 0; }

/* ── Bottom actions ── */
.bottom-actions {
  display: flex; align-items: center;
  justify-content: space-between;
  flex-wrap: wrap; gap: 10px;
}
.bottom-actions-l { display: flex; gap: 8px; flex-wrap: wrap; }
.bottom-actions-r { display: flex; gap: 8px; flex-wrap: wrap; }

.attach-btn {
  display: inline-flex; align-items: center; gap: 5px;
  border: 1px solid #e5e7eb; border-radius: 8px;
  padding: 7px 13px; font-size: 12px; font-weight: 500;
  color: #374151; background: #fff;
  transition: border-color .15s;
}
.attach-btn:hover { border-color: #2563eb; color: #2563eb; }
.attach-btn i { font-size: 14px; }

.draft-btn {
  display: inline-flex; align-items: center; gap: 5px;
  border: 1px solid #e5e7eb; border-radius: 8px;
  padding: 8px 16px; font-size: 12.5px; font-weight: 600;
  color: #374151; background: #fff;
  transition: border-color .15s;
}
.draft-btn:hover { border-color: #2563eb; color: #2563eb; }
.draft-btn i { font-size: 14px; }

.submit-btn {
  display: inline-flex; align-items: center; gap: 6px;
  border: none; border-radius: 8px;
  padding: 9px 20px; font-size: 12.5px; font-weight: 700;
  color: #fff; background: #2563eb;
  transition: background .15s, transform .1s;
}
.submit-btn:hover  { background: #1d4ed8; }
.submit-btn:active { transform: scale(.98); }
.submit-btn i { font-size: 14px; }

/* ═══════════════════════════════════════════════
   SIDEBAR CARDS
═══════════════════════════════════════════════ */
.sb-card {
  background: #fff;
  border: 1px solid #e5e7eb;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 1px 3px rgba(0,0,0,.05);
}
.sb-card-hdr {
  display: flex; align-items: center; justify-content: space-between;
  padding: 11px 14px;
  border-bottom: 1px solid #f3f4f6;
  font-size: 12.5px; font-weight: 700;
  color: #111827;
  background: #fafafa;
}
.sb-card-hdr span { display: flex; align-items: center; gap: 6px; }
.sb-card-hdr i { font-size: 14px; color: #2563eb; }
.sb-card-hdr a { font-size: 11px; font-weight: 500; color: #2563eb; }
.sb-card-body { padding: 14px; }

/* Target */
.target-nums {
  display: flex; align-items: baseline; gap: 6px; margin-bottom: 7px;
}
.t-big   { font-size: 34px; font-weight: 800; color: #111827; line-height: 1; }
.t-slash { font-size: 20px; color: #d1d5db; }
.t-total { font-size: 24px; font-weight: 600; color: #9ca3af; line-height: 1; }
.t-pct {
  font-size: 11.5px; font-weight: 600;
  background: #f0fdf4; color: #16a34a;
  border-radius: 20px; padding: 2px 9px;
  margin-left: 2px;
}
.prog-bar {
  height: 7px; background: #e5e7eb; border-radius: 99px;
  overflow: hidden; margin-bottom: 9px;
}
.prog-fill {
  height: 100%;
  background: linear-gradient(90deg, #16a34a, #22c55e);
  border-radius: 99px;
  transition: width .5s ease;
}
.target-note {
  font-size: 11.5px; color: #6b7280;
  padding: 7px 10px;
  background: #f9fafb;
  border: 1px solid #e5e7eb;
  border-radius: 7px;
  display: flex; align-items: center; gap: 6px;
}
.target-note i { color: #d97706; font-size: 14px; flex-shrink: 0; }

/* Recent reports */
.rr-item {
  display: flex; gap: 10px;
  padding: 10px 0;
  border-bottom: 1px solid #f3f4f6;
  cursor: pointer;
}
.rr-item:last-child { border-bottom: none; padding-bottom: 0; }
.rr-item:first-child { padding-top: 0; }
.rr-dot {
  width: 6px; height: 6px; border-radius: 50%;
  background: #bfdbfe; flex-shrink: 0; margin-top: 5px;
}
.rr-id {
  font-size: 11px; font-weight: 600;
  color: #2563eb; margin-bottom: 1px;
  transition: color .12s;
}
.rr-item:hover .rr-id { color: #1d4ed8; }
.rr-name { font-size: 12px; font-weight: 600; color: #111827; line-height: 1.3; }
.rr-sub  { font-size: 11px; color: #9ca3af; margin-top: 1px; }
.rr-time { font-size: 10.5px; color: #9ca3af; white-space: nowrap; margin-left: auto; flex-shrink: 0; }

/* ── Responsive general ── */
@@media (max-width: 600px) {
  .page-hdr { padding: 12px 14px 10px; }
  .stats-row .stat-cell { padding: 12px 14px; }
  .search-row { padding: 8px 12px; }
  .content-area { padding: 12px 12px 0; }
}
</style>


<!-- ── Breadcrumb ───────────────────────────── -->
<nav class="nav-bar">

  <a href="#">Work Order Management</a>
  <span class="nav-sep">›</span>
  <span class="nav-cur">Quick Reporting</span>
</nav>

<!-- ── Page shell ───────────────────────────── -->
<div style="display:flex;flex-direction:column;min-height:calc(100vh - 40px)">
<div class="page-shell">

  <!-- ════════════ MAIN ════════════ -->
  <main class="page-main">


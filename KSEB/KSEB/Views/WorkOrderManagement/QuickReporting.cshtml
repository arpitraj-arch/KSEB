<script>
  /* Status buttons toggle */
  document.querySelectorAll('.comp-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      document.querySelectorAll('.comp-btn').forEach(function(b){ b.classList.remove('active'); });
      this.classList.add('active');
    });
  });
  /* Pagination */
  document.querySelectorAll('.pg-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      if (this.querySelector('i')) return;
      var wrap = this.closest('.pg-btns');
      wrap.querySelectorAll('.pg-btn').forEach(function(b){ b.classList.remove('active'); });
      this.classList.add('active');
    });
  });
</script>

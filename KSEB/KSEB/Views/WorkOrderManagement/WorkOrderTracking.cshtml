@{
}
@{
    ViewData["Title"] = "Work Order Tracking";
}
@{
    ViewData["ActiveMenu"] = "Work Order Management";
}

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Work Order Details</title>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@300;400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
    *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0
    }

    :root {
        --bg: #f0f2f5;
        --surface: #fff;
        --surface2: #f8fafc;
        --border: #e4e7ec;
        --text: #111827;
        --muted: #6b7280;
        --dim: #9ca3af;
        --blue: #2563eb;
        --green: #16a34a;
        --red: #dc2626;
        --orange: #d97706;
        --teal: #0d9488;
        --mono: 'IBM Plex Mono',monospace;
        --sans: 'IBM Plex Sans',sans-serif;
    }

    body {
        font-family: var(--sans);
        font-size: 13px;
        background: var(--bg);
        color: var(--text);
        min-height: 100vh;
        display: flex;
        flex-direction: column
    }

    /* ── TOP BAR ── */
    .topbar {
        background: var(--surface);
        border-bottom: 1px solid var(--border);
        padding: 0 20px;
        min-height: 56px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        box-shadow: 0 1px 4px rgba(0,0,0,.06);
        position: sticky;
        top: 0;
        z-index: 100;
        flex-wrap: wrap;
    }

    .topbar-left {
        display: flex;
        align-items: center;
        gap: 12px
    }

    .back-btn {
        width: 34px;
        height: 34px;
        border-radius: 8px;
        border: 1px solid var(--border);
        background: var(--surface2);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        color: var(--muted);
        transition: .15s;
        flex-shrink: 0;
    }

        .back-btn:hover {
            border-color: var(--blue);
            color: var(--blue)
        }

        .back-btn svg {
            width: 16px;
            height: 16px
        }

    .topbar-title h1 {
        font-size: 16px;
        font-weight: 700;
        color: var(--text);
        line-height: 1.2
    }

    .topbar-title p {
        font-size: 11px;
        color: var(--muted)
    }

    .esc-btn {
        display: flex;
        align-items: center;
        gap: 6px;
        background: #111827;
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 8px 16px;
        font-family: var(--sans);
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        transition: .15s;
        white-space: nowrap;
        flex-shrink: 0;
    }

        .esc-btn:hover {
            background: #1d4ed8
        }

        .esc-btn svg {
            width: 13px;
            height: 13px
        }

    /* ── STATUS STRIP ── */
    .status-strip {
        background: var(--surface);
        border-bottom: 1px solid var(--border);
        padding: 0 20px;
        display: flex;
        align-items: stretch;
        gap: 0;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

        .status-strip::-webkit-scrollbar {
            height: 0
        }

    .strip-item {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: center;
        padding: 10px 20px 10px 0;
        border-right: 1px solid var(--border);
        min-width: max-content;
        gap: 2px;
    }

        .strip-item:last-child {
            border-right: none
        }

        .strip-item:first-child {
            padding-left: 0
        }

    .strip-label {
        display: flex;
        align-items: center;
        gap: 5px;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: .07em;
        text-transform: uppercase;
        color: var(--dim);
    }

        .strip-label svg {
            width: 12px;
            height: 12px
        }

    .strip-val {
        font-size: 15px;
        font-weight: 700;
        font-family: var(--mono)
    }

        .strip-val.blue {
            color: var(--blue)
        }

        .strip-val.red {
            color: var(--red)
        }

        .strip-val.orange {
            color: var(--orange)
        }

        .strip-val.green {
            color: var(--green)
        }

        .strip-val.purple {
            color: #7c3aed
        }

    .progress-bar-wrap {
        width: 100%;
        height: 4px;
        background: #e4e7ec;
        border-radius: 2px;
        margin-top: 3px
    }

    .progress-bar-inner {
        height: 4px;
        border-radius: 2px;
        background: var(--green)
    }

    /* ── MAIN LAYOUT ── */
    .main {
        display: grid;
        grid-template-columns: 1fr 280px;
        gap: 6px;
        padding: 4px 8px;
        flex: 1;
        align-items: start
    }

    /* ── LEFT PANEL ── */
    .left-panel {
        display: flex;
        flex-direction: column;
        gap: 0;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 16px;
        overflow: hidden
    }

    .wo-header {
        padding: 16px 20px;
        border-bottom: 1px solid var(--border)
    }

    .wo-id-row {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 6px;
        flex-wrap: wrap
    }

    .wo-id {
        font-size: 15px;
        font-weight: 700;
        font-family: var(--mono);
        color: var(--text)
    }

    .badge {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 20px;
        font-size: 10px;
        font-weight: 700
    }

    .badge-inprogress {
        background: rgba(37,99,235,.1);
        color: var(--blue)
    }

    .badge-approved {
        background: rgba(22,163,74,.12);
        color: var(--green)
    }

    .badge-waiting {
        background: rgba(217,119,6,.12);
        color: var(--orange)
    }

    .wo-desc {
        font-size: 14px;
        font-weight: 600;
        color: var(--text);
        margin-bottom: 4px
    }

    .wo-location {
        font-size: 11px;
        color: var(--muted);
        display: flex;
        align-items: center;
        gap: 4px
    }

        .wo-location svg {
            width: 12px;
            height: 12px;
            flex-shrink: 0
        }

    .wo-meta-grid {
        display: grid;
        grid-template-columns: repeat(3,1fr);
        gap: 0;
        padding: 0 20px;
        border-bottom: 1px solid var(--border)
    }

    .meta-cell {
        padding: 12px 0;
        border-right: 1px solid var(--border)
    }

        .meta-cell:nth-child(3n) {
            border-right: none
        }

        .meta-cell:nth-child(n+4) {
            border-top: 1px solid var(--border)
        }

    .meta-cell {
        padding-right: 16px
    }

    .meta-key {
        font-size: 10px;
        color: var(--dim);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .05em;
        margin-bottom: 3px
    }

    .meta-val {
        font-size: 12px;
        color: var(--text);
        font-weight: 500
    }

        .meta-val.red {
            color: var(--red);
            font-weight: 700
        }

    /* ── TABS ── */
    .tabs-bar {
        display: flex;
        align-items: center;
        gap: 0;
        border-bottom: 1px solid var(--border);
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        padding: 0 12px;
    }

        .tabs-bar::-webkit-scrollbar {
            height: 0
        }

    .tab-btn {
        display: flex;
        align-items: center;
        gap: 5px;
        padding: 12px 12px;
        border: none;
        background: none;
        font-family: var(--sans);
        font-size: 12px;
        font-weight: 500;
        color: var(--muted);
        cursor: pointer;
        transition: .15s;
        white-space: nowrap;
        border-bottom: 2px solid transparent;
        margin-bottom: -1px;
    }

        .tab-btn:hover {
            color: var(--blue)
        }

        .tab-btn.active {
            color: var(--blue);
            border-bottom-color: var(--blue);
            font-weight: 600
        }

        .tab-btn svg {
            width: 13px;
            height: 13px
        }

    .tab-count {
        background: var(--surface2);
        border: 1px solid var(--border);
        border-radius: 10px;
        font-size: 10px;
        font-weight: 700;
        padding: 0 5px;
        color: var(--muted);
    }

    .tab-btn.active .tab-count {
        background: rgba(37,99,235,.1);
        border-color: transparent;
        color: var(--blue)
    }

    /* ── TAB CONTENT ── */
    .tab-content {
        display: none;
        padding: 20px
    }

        .tab-content.active {
            display: block
        }

    /* Overview sections */
    .section-title {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        font-weight: 700;
        color: var(--text);
        margin-bottom: 14px;
        padding-bottom: 8px;
        border-bottom: 1px solid var(--border);
    }

        .section-title svg {
            width: 14px;
            height: 14px;
            color: var(--blue)
        }

    .detail-grid {
        display: grid;
        grid-template-columns: repeat(3,1fr);
        gap: 14px;
        margin-bottom: 20px
    }

    .detail-cell {
    }

    .detail-key {
        font-size: 10px;
        color: var(--dim);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .05em;
        margin-bottom: 3px
    }

    .detail-val {
        font-size: 12px;
        color: var(--text);
        font-weight: 500
    }

    .work-desc-text {
        font-size: 12px;
        color: var(--muted);
        line-height: 1.6;
        margin-bottom: 20px
    }

    /* Safety fields */
    .safety-fields {
        display: grid;
        grid-template-columns: repeat(3,1fr);
        gap: 12px;
        margin-bottom: 20px
    }

    .safety-cell {
    }

    .safety-key {
        font-size: 10px;
        color: var(--dim);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .05em;
        margin-bottom: 4px
    }

    .safety-val {
        font-size: 12px;
        color: var(--text);
        font-weight: 500
    }

    /* ── LABOUR TAB ── */
    .data-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 520px
    }

        .data-table thead tr {
            border-bottom: 1px solid var(--border)
        }

        .data-table thead th {
            padding: 8px 10px;
            text-align: left;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: .06em;
            text-transform: uppercase;
            color: var(--dim);
            white-space: nowrap
        }

        .data-table tbody tr {
            border-bottom: 1px solid var(--border);
            transition: .1s
        }

            .data-table tbody tr:hover {
                background: #f5f7ff
            }

        .data-table tbody td {
            padding: 10px 10px;
            font-size: 12px;
            color: var(--text)
        }

    .td-link {
        color: var(--blue);
        font-family: var(--mono);
        font-size: 11px;
        cursor: pointer;
        font-weight: 600
    }

        .td-link:hover {
            text-decoration: underline
        }

    .table-wrap {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch
    }

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(4,1fr);
        gap: 12px;
        margin-top: 16px;
        padding-top: 16px;
        border-top: 1px solid var(--border)
    }

    .summary-card {
        background: var(--surface2);
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 12px
    }

    .summary-label {
        font-size: 10px;
        color: var(--dim);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .05em;
        margin-bottom: 4px
    }

    .summary-val {
        font-size: 16px;
        font-weight: 700;
        font-family: var(--mono);
        color: var(--blue)
    }

    /* ── MATERIALS TAB ── */
    .material-badge {
        display: inline-block;
        padding: 2px 8px;
        border-radius: 12px;
        font-size: 10px;
        font-weight: 600
    }

    .mat-available {
        background: rgba(22,163,74,.1);
        color: var(--green)
    }

    .mat-pending {
        background: rgba(217,119,6,.1);
        color: var(--orange)
    }

    .mat-issued {
        background: rgba(37,99,235,.1);
        color: var(--blue)
    }

    /* ── TASKS TAB ── */
    .task-item {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 12px 0;
        border-bottom: 1px solid var(--border)
    }

        .task-item:last-child {
            border-bottom: none
        }

    .task-check {
        width: 18px;
        height: 18px;
        border-radius: 5px;
        border: 2px solid var(--border);
        flex-shrink: 0;
        margin-top: 1px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: .15s;
    }

        .task-check.done {
            background: var(--green);
            border-color: var(--green)
        }

        .task-check svg {
            width: 11px;
            height: 11px;
            stroke: #fff;
            display: none
        }

        .task-check.done svg {
            display: block
        }

    .task-body {
        flex: 1
    }

    .task-name {
        font-size: 12px;
        font-weight: 600;
        color: var(--text);
        margin-bottom: 3px
    }

        .task-name.done {
            text-decoration: line-through;
            color: var(--dim)
        }

    .task-meta {
        font-size: 10px;
        color: var(--dim)
    }

    .task-status-badge {
        padding: 2px 8px;
        border-radius: 10px;
        font-size: 10px;
        font-weight: 600;
        white-space: nowrap;
        flex-shrink: 0;
    }

    /* ── SAFETY TAB ── */
    .permit-card {
        background: var(--surface2);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 14px;
        margin-bottom: 12px;
    }

    .permit-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 10px;
        flex-wrap: wrap;
        gap: 8px
    }

    .permit-id {
        font-family: var(--mono);
        font-size: 12px;
        font-weight: 600;
        color: var(--blue)
    }

    .checklist-item {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 7px 0;
        border-bottom: 1px solid var(--border);
        font-size: 12px
    }

        .checklist-item:last-child {
            border-bottom: none
        }

    .check-icon {
        width: 16px;
        height: 16px;
        border-radius: 4px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center
    }

    .check-yes {
        background: rgba(22,163,74,.12)
    }

        .check-yes svg, .check-no svg {
            width: 10px;
            height: 10px
        }

        .check-yes svg {
            stroke: var(--green)
        }

    .check-no {
        background: rgba(220,38,38,.1)
    }

        .check-no svg {
            stroke: var(--red)
        }

    /* ── HISTORY TAB ── */
    .history-list {
        display: flex;
        flex-direction: column;
        gap: 0
    }

    .history-item {
        display: flex;
        gap: 12px;
        padding: 12px 0;
        border-bottom: 1px solid var(--border)
    }

        .history-item:last-child {
            border-bottom: none
        }

    .h-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        margin-top: 3px;
        flex-shrink: 0
    }

    .h-content {
        flex: 1
    }

    .h-event {
        font-size: 12px;
        font-weight: 600;
        color: var(--text)
    }

    .h-user {
        font-size: 11px;
        color: var(--muted);
        margin-top: 1px
    }

    .h-time {
        font-size: 10px;
        color: var(--dim);
        margin-top: 2px;
        font-family: var(--mono)
    }

    /* ── ATTACHMENTS TAB ── */
    .attachments-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill,minmax(160px,1fr));
        gap: 12px
    }

    .attach-card {
        border: 1px solid var(--border);
        border-radius: 10px;
        overflow: hidden;
        transition: .15s;
        cursor: pointer;
    }

        .attach-card:hover {
            border-color: var(--blue);
            box-shadow: 0 2px 8px rgba(37,99,235,.1)
        }

    .attach-preview {
        height: 90px;
        background: var(--surface2);
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .attach-preview svg {
            width: 32px;
            height: 32px;
            color: var(--dim)
        }

    .attach-info {
        padding: 8px 10px
    }

    .attach-name {
        font-size: 11px;
        font-weight: 600;
        color: var(--text);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis
    }

    .attach-size {
        font-size: 10px;
        color: var(--dim);
        margin-top: 1px
    }

    /* ── RIGHT PANEL ── */
    .right-panel {
        display: flex;
        flex-direction: column;
        gap: 6px
    }

    .r-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 16px;
        overflow: hidden
    }

    .r-card-header {
        display: flex;
        align-items: center;
        gap: 7px;
        padding: 14px 16px 10px;
        font-size: 13px;
        font-weight: 700;
        color: var(--text);
        border-bottom: 1px solid var(--border);
    }

        .r-card-header svg {
            width: 14px;
            height: 14px;
            color: var(--blue)
        }

    .r-card-body {
        padding: 14px 16px
    }

    /* Timeline */
    .timeline-list {
        display: flex;
        flex-direction: column;
        gap: 0
    }

    .tl-item {
        display: flex;
        gap: 10px;
        padding: 10px 0;
        position: relative
    }

        .tl-item:not(:last-child)::before {
            content: '';
            position: absolute;
            left: 6px;
            top: 22px;
            bottom: -10px;
            width: 1px;
            background: var(--border);
        }

    .tl-dot {
        width: 14px;
        height: 14px;
        border-radius: 50%;
        border: 2px solid var(--border);
        flex-shrink: 0;
        margin-top: 2px;
        position: relative;
        z-index: 1;
    }

        .tl-dot.green {
            background: var(--green);
            border-color: var(--green)
        }

        .tl-dot.orange {
            background: var(--orange);
            border-color: var(--orange)
        }

        .tl-dot.grey {
            background: var(--dim);
            border-color: var(--dim)
        }

    .tl-content {
    }

    .tl-time {
        font-size: 9px;
        font-family: var(--mono);
        color: var(--dim);
        margin-bottom: 2px
    }

    .tl-event {
        font-size: 12px;
        font-weight: 600;
        color: var(--text)
    }

    .tl-user {
        font-size: 11px;
        color: var(--muted)
    }

    /* SLA donut */
    .sla-donut-wrap {
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 6px 0 14px
    }

        .sla-donut-wrap svg {
            width: 120px;
            height: 120px
        }

    .sla-rows {
        display: flex;
        flex-direction: column;
        gap: 8px
    }

    .sla-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 12px
    }

    .sla-key {
        color: var(--muted)
    }

    .sla-val {
        font-weight: 600;
        font-family: var(--mono);
        color: var(--text)
    }

        .sla-val.green {
            color: var(--green)
        }

    .sla-divider {
        height: 1px;
        background: var(--border);
        margin: 6px 0
    }

    .sla-status-badge {
        display: inline-block;
        padding: 2px 8px;
        border-radius: 6px;
        font-size: 10px;
        font-weight: 700
    }

    .sla-inprog {
        background: rgba(217,119,6,.1);
        color: var(--orange)
    }

    /* ── FOOTER ACTIONS ── */
    .footer-actions {
        position: sticky;
        bottom: 0;
        background: var(--surface);
        border-top: 1px solid var(--border);
        padding: 12px 20px;
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        z-index: 50;
        box-shadow: 0 -2px 8px rgba(0,0,0,.06);
    }

    .footer-btn {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 9px 16px;
        border-radius: 8px;
        font-family: var(--sans);
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        transition: .15s;
        border: 1px solid transparent;
        white-space: nowrap;
    }

    .footer-btn-primary {
        background: #2563eb;
        color: #fff;
        border-color: #2563eb
    }

        .footer-btn-primary:hover {
            background: #1d4ed8
        }

    .footer-btn-outline {
        background: var(--surface);
        color: var(--text);
        border-color: var(--border)
    }

        .footer-btn-outline:hover {
            border-color: var(--blue);
            color: var(--blue)
        }

    .footer-btn-danger {
        background: var(--red);
        color: #fff;
        border-color: var(--red)
    }


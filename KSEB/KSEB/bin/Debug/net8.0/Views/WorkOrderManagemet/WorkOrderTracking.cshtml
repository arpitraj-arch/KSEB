@{
}
@{
    ViewData["Title"] = "Work Order Tracking";
}
@{
    ViewData["ActiveMenu"] = "Work Order Management";
}
    <style>
            /* Base Reset */
            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
                font-family: 'Inter', -apple-system, sans-serif;
            }

            :root {
                --primary-gradient: linear-gradient(90deg, #3c70d3 0%, #039886 100%);
                --text-main: #212b27;
                --text-muted: #6e737d;
                --bg-light: #f5f6fa;
                --border-color: rgba(1, 10, 32, 0.1);
            }

            body {
                height: 100vh;
                background: url('images/kseb-login-page.png') no-repeat center center;
                background-size: cover;
                display: flex;
                flex-direction: column;
                overflow: hidden;
            }

            /* Top Left Header Logo */
            .main-header-logo {
                position: absolute;
                top: 30px;
                left: 40px;
                width: 160px;
                z-index: 10;
            }

            /* Layout Container */
            .page-content {
                flex: 1;
                display: flex;
                justify-content: flex-end; /* Pushes card to the right side */
                align-items: center;
                padding-right: 8%; /* Adjusts distance from right edge */
            }

            /* Login Card */
            .login-card {
                background: #ffffff;
                width: 400px;
                padding: 35px;
                border-radius: 12px;
                box-shadow: 0px 20px 40px rgba(0, 0, 0, 0.15);
            }

            .card-logos {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 25px;
            }

            .card-logo-kseb {
                height: 35px;
            }

            .card-logo-scs {
                height: 40px;
            }

            .welcome-text h2 {
                font-size: 20px;
                font-weight: 600;
                color: var(--text-main);
                margin-bottom: 5px;
            }

            .welcome-text p {
                font-size: 13px;
                color: var(--text-muted);
                margin-bottom: 20px;
            }

            /* Form Styling */
            .form-group {
                margin-bottom: 15px;
            }

                .form-group label {
                    display: block;
                    font-size: 13px;
                    margin-bottom: 6px;
                    color: #32403b;
                }

            .input-container {
                display: flex;
                align-items: center;
                border: 1.2px solid var(--border-color);
                border-radius: 8px;
                padding: 10px 12px;
                transition: border-color 0.3s;
            }

                .input-container:focus-within {
                    border-color: var(--primary-gradient);
                }

                .input-container input {
                    border: none;
                    outline: none;
                    width: 100%;
                    margin-left: 10px;
                    font-size: 14px;
                    color: #212b27;
                }

                    .input-container input::placeholder {
                        color: rgba(1, 10, 32, 0.3);
                    }

            .icon-small {
                width: 20px;
                opacity: 0.6;
            }

            .forgot-pass {
                text-align: right;
                margin-top: 8px;
                margin-bottom: 15px;
            }

                .forgot-pass a {
                    font-size: 11px;
                    color: #474af3;
                    text-decoration: none;
                }

            /* Buttons */
            .btn-primary {
                width: 100%;
                padding: 12px;
                background: var(--primary-gradient);
                border: none;
                border-radius: 8px;
                color: white;
                font-size: 15px;
                font-weight: 600;
                cursor: pointer;
                margin-bottom: 15px;
            }

            .divider {
                display: flex;
                align-items: center;
                text-align: center;
                margin-bottom: 15px;
                color: var(--text-muted);
                font-size: 11px;
            }

                .divider::before, .divider::after {
                    content: '';
                    flex: 1;
                    border-bottom: 1px solid #eee;
                }

                .divider span {
                    padding: 0 10px;
                }

            .btn-outline {
                width: 100%;
                padding: 11px;
                background: white;
                border: 1px solid #1a325c;
                border-radius: 8px;
                color: #1a325c;
                font-size: 15px;
                font-weight: 600;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
                cursor: pointer;
                margin-bottom: 15px;
            }

            /* Info Sections */
            .info-strip {
                background: var(--bg-light);
                border-radius: 6px;
                padding: 8px 12px;
                display: flex;
                align-items: center;
                gap: 10px;
                font-size: 10px;
                color: var(--text-muted);
                margin-bottom: 8px;
            }

            .history-box {
                background: var(--bg-light);
                border-radius: 6px;
                padding: 10px 12px;
                display: flex;
                align-items: flex-start;
                gap: 10px;
                color: var(--text-muted);
            }

            .history-content .label {
                font-size: 10px;
                font-weight: 600;
                margin-bottom: 2px;
            }

            .history-content .timestamp {
                font-size: 9px;
                line-height: 1.4;
            }

            /* Footer */
            .page-footer {
                background: #010a20;
                padding: 15px 40px;
                display: flex;
                justify-content: space-between;
                align-items: center;
                color: white;
                font-size: 10px;
            }

            .footer-links span {
                margin-right: 15px;
                cursor: pointer;
            }

            /* Responsive */
            @@media (max-width: 768px) {
                .page-content {
                    justify-content: center;
                    padding-right: 0;
                }

                .main-header-logo {
                    left: 50%;
                    transform: translateX(-50%);
                }
            }
            /* Decorative Background Vector Layer */
            .bg-vector-layer {
                position: absolute;
                top: 0;
                left: 0;
                width: 100vw;
                height: 100vh;
                object-fit: cover;
                z-index: 1; /* Sits right above the base background image */
                pointer-events: none; /* Allows clicks to pass through to elements underneath */
            }

            /* Update z-indices for content to sit cleanly on top of the vector */
            .main-header-logo {
                z-index: 10;
            }

            .page-content {
                position: relative;
                z-index: 5;
            }

            .page-footer {
                position: relative;
                z-index: 5;
            }
            /* Tooltip Wrapper Container */
            .tooltip-wrapper {
                position: relative;
                display: block;
            }

            /* Base Hidden State of the Tooltip */
            .custom-tooltip {
                display: flex; /* Keeps icon and text side-by-side */
                align-items: center;
                gap: 8px;
                position: absolute;
                top: calc(100% + 8px);
                left: 20px;
                background-color: #ffffff;
                color: #212b27;
                font-size: 12px;
                padding: 8px 12px;
                border-radius: 6px;
                border: 1px solid #212b27;
                box-shadow: 0px 4px 12px rgba(0, 0, 0, 0.15);
                z-index: 20;
                white-space: nowrap;
                /* Strict Hidden Defaults */
                opacity: 0;
                display: none; /* Completely removes it from view by default */
                transform: translateY(-5px);
                transition: opacity 0.2s ease, transform 0.2s ease;
            }

            /* Trigger: Switch display to flex and fade in on Hover or Focus */
            .tooltip-wrapper:hover .custom-tooltip,
            .input-container:focus-within + .custom-tooltip {
                display: flex;
                opacity: 1;
                transform: translateY(0);
            }
            /* Small CSS Top Arrow for the Tooltip Box */
            .custom-tooltip::before {
                content: "";
                position: absolute;
                bottom: 100%;
                left: 15px;
                border-width: 6px;
                border-style: solid;
                border-color: transparent transparent #ffffff transparent;
            }

            /* Secondary border shadow fix for the arrow */
            .custom-tooltip::after {
                content: "";
                position: absolute;
                bottom: 100%;
                left: 15px;
                border-width: 7px;
                border-style: solid;
                border-color: transparent transparent #c9d1d9 transparent;
                z-index: -1;
                transform: translateX(-1px);
            }


            .tooltip-icon-bg {
                background-color: #ff9800; /* Custom orange warning color */
                border-radius: 4px;
                width: 18px;
                height: 18px;
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
            }
    </style>

    <img src="images/frame-420.svg" class="bg-vector-layer" alt="">
    <!-- Main Branding Logo -->
    <img src="images/group-10000029231.svg" class="main-header-logo" alt="KSEB">

    <div class="page-content">
        <div class="login-card">
            <!-- Header Logos -->
            <div class="card-logos">
                <img src="images/group-10000029230.svg" class="card-logo-kseb">
                <img src="images/_3-10.png" class="card-logo-scs">
            </div>

            <div class="welcome-text">
                <h2>Welcome Back</h2>
                <p>Sign in to access KSEB System</p>
            </div>

            <!-- Login Form -->
            <form id="login-form">
                <div class="form-group">
                    <label>Username</label>
                    <div class="tooltip-wrapper">
                        <div class="input-container">
                            <img src="images/frame-90.svg" class="icon-small">
                            <input type="text" placeholder="Enter your username" required>
                        </div>
                        <span class="custom-tooltip">
                            <span class="tooltip-icon-bg">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="12" y1="8" x2="12" y2="12"></line>
                                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                                </svg>
                            </span>
                            Please fill out this field.
                        </span>
                    </div>
                </div>
                <div class="form-group">
                    <label>Password</label>
                    <div class="tooltip-wrapper">
                        <div class="input-container">
                            <img src="images/solar-lock-password-outline0.svg" class="icon-small">
                            <input type="password" id="password-field" placeholder="Enter your Password" required>
                            <img src="images/uiw-eye-o0.svg" id="toggle-password" class="icon-small" style="cursor: pointer; margin-left: 5px;">
                        </div>

                        <span class="custom-tooltip">
                            <span class="tooltip-icon-bg">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="12" y1="8" x2="12" y2="12"></line>
                                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                                </svg>
                            </span>
                            Please fill out this field.
                        </span>
                    </div>
                </div>

                <div class="forgot-pass">
                    <a href="#">Forgot password?</a>
                </div>

                <button type="submit" class="btn-primary">Sign In</button>
            </form>

            <div class="divider">
                <span>OR</span>
            </div>

            <button class="btn-outline">
                <img src="images/group0.svg" style="width: 14px;">
                Sign In with SSO
            </button>

            <!-- Bottom Contextual Info -->
            <div class="info-strip">
                <img src="images/group1.svg" style="width: 14px;">
                <span>Authentication method configurable to IT security policies</span>
            </div>

            <div class="history-box">
                <img src="images/ic-round-history0.svg" style="width: 14px; margin-top: 2px;">
                <div class="history-content">
                    <div class="label">Last Login</div>
                    <div class="timestamp">29 May 2026, 10:34 AM | IP: 103.21.45.67 | Chrome</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="page-footer">
        <div class="footer-links">
            <span>Privacy Policy</span> | <span>Terms of Use</span> | <span>Support</span>
        </div>
        <div class="footer-copy">
            2026 Kerala State Electricity Board. All rights reserved.
        </div>
    </footer>

<script>
    // --- 1. Password Toggle Logic ---
    const passwordField = document.getElementById('password-field');
    const togglePasswordIcon = document.getElementById('toggle-password');
    const openEyeSrc = togglePasswordIcon.src;
    const closedEyeSrc = `data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="%23212b27" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="opacity:0.6"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line></svg>`;

    togglePasswordIcon.addEventListener('click', function () {
        if (passwordField.type === 'password') {
            passwordField.type = 'text';
            togglePasswordIcon.src = closedEyeSrc;
        } else {
            passwordField.type = 'password';
            togglePasswordIcon.src = openEyeSrc;
        }
    });

    // --- 2. Login Validation Logic ---
    // Ensure your <form> tag has id="loginForm" and the username input has id="username"
    const loginForm = document.querySelector('form'); // Or use document.getElementById('loginForm')

    loginForm.addEventListener('submit', function (e) {
        e.preventDefault(); // Prevent page from refreshing

        // Target the username input (make sure you add id="username" to your HTML input)
        const usernameInput = document.querySelector('input[type="text"]');
        const username = usernameInput.value;
        const password = passwordField.value;

        // Credentials defined by user
        const correctUser = "scstechindia@gmail.com";
        const correctPass = "Admin@123";

        if (username === correctUser && password === correctPass) {
            // SUCCESS: Redirect to index
            window.location.href = "index.html";
        } else {
            // FAILURE: Alert user
            alert("Incorrect username or password. Please try again.");
        }
    });
</script>